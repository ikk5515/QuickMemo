rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bootstrapPath() {
      return /databases/$(database)/documents/system/bootstrap;
    }

    function bootstrapGatePath() {
      return /databases/$(database)/documents/system/bootstrapGate;
    }

    function bootstrapAttemptPath(uid) {
      return /databases/$(database)/documents/system/bootstrapAttempts/attempts/$(uid);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function rosterPath(uid) {
      return /databases/$(database)/documents/publicLoginRoster/$(uid);
    }

    function userKeyPath(uid) {
      return /databases/$(database)/documents/userKeys/$(uid);
    }

    function quickLoginKeyPath(quickKey) {
      return /databases/$(database)/documents/quickLoginKeys/$(quickKey);
    }

    function notePath(noteId) {
      return /databases/$(database)/documents/notes/$(noteId);
    }

    function scheduleTaskPath(taskId) {
      return /databases/$(database)/documents/scheduleTasks/$(taskId);
    }

    function googleCalendarTaskTombstonePath(taskId) {
      return /databases/$(database)/documents/googleCalendarTaskTombstones/$(taskId);
    }

    function googleCalendarConnectionPath(uid) {
      return /databases/$(database)/documents/googleCalendarConnections/$(uid);
    }

    function vaultIntegrityPath(uid) {
      return /databases/$(database)/documents/vaultIntegrity/$(uid);
    }

    function vaultNameClaimPath(uid, claimId) {
      return /databases/$(database)/documents/vaultIntegrity/$(uid)/nameClaims/$(claimId);
    }

    function vaultImportJobPath(uid, jobId) {
      return /databases/$(database)/documents/vaultMaintenanceJobs/$(uid)/imports/$(jobId);
    }

    function publicSharePath(shareId) {
      return /databases/$(database)/documents/publicNoteShares/$(shareId);
    }

    function activeSignedInUser() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.isActive == true;
    }

    function validFeatureAccess(data) {
      return data.keys().hasOnly(["notes", "library", "schedule"])
        && data.notes is bool
        && data.library is bool
        && data.schedule is bool;
    }

    function userHasFeature(uid, feature) {
      let profile = get(userPath(uid)).data;
      return exists(userPath(uid))
        && profile.isActive == true
        && (
          profile.isAdmin == true
          || !profile.keys().hasAny(["featureAccess"])
          || (
            validFeatureAccess(profile.featureAccess)
            && profile.featureAccess.get(feature, false) == true
          )
        );
    }

    function activeSignedInUserHasFeature(feature) {
      return signedIn() && userHasFeature(request.auth.uid, feature);
    }

    function userHasNotes(uid) {
      let profile = get(userPath(uid)).data;
      // Reading a missing profile yields no usable profile data, so the
      // isActive comparison below already fails closed. Avoid evaluating the
      // same user document twice on every note/history/name-claim write.
      return profile.isActive == true
        && (
          profile.isAdmin == true
          || !profile.keys().hasAny(["featureAccess"])
          || (
            validFeatureAccess(profile.featureAccess)
            && profile.featureAccess.notes == true
          )
        );
    }

    function activeSignedInUserHasNotes() {
      return signedIn() && userHasNotes(request.auth.uid);
    }

    function adminUser() {
      return activeSignedInUser()
        && get(userPath(request.auth.uid)).data.isAdmin == true;
    }

    function encryptedPayload(payload) {
      return payload is map
        && payload.keys().hasOnly(["version", "algorithm", "cipherText", "iv"])
        && payload.version == 1
        && payload.algorithm == "AES-GCM"
        && payload.cipherText is string
        && payload.iv is string;
    }

    function boundedEncryptedPayload(payload, maximumCipherTextSize) {
      return encryptedPayload(payload)
        && payload.cipherText.size() > 0
        && payload.cipherText.size() <= maximumCipherTextSize
        && payload.iv.size() > 0
        && payload.iv.size() <= 256;
    }

    function wrappedAesKeyPayload(payload) {
      return payload is map
        && payload.keys().hasOnly(["version", "algorithm", "wrappedKey"])
        && payload.version == 1
        && payload.algorithm == "RSA-OAEP"
        && payload.wrappedKey is string
        && payload.wrappedKey.size() >= 8
        && payload.wrappedKey.size() <= 4096;
    }

    function secureShareCopyMetadataAbsent(data) {
      return !data.keys().hasAny([
        "secureShareCopyState",
        "secureShareCopyJobId",
        "secureShareCopyExpectedAttachmentCount",
        "secureShareCopyReservedAttachmentCount",
        "secureShareCopyReadyAttachmentCount",
        "secureShareCopyStartedAt",
        "secureShareCopyUpdatedAt",
        "secureShareCopyFinishedAt",
        "secureShareCopyCleanupClaimId",
        "secureShareCopyCleanupClaimedAt"
      ]);
    }

    function secureShareCopyUsable(data) {
      return secureShareCopyMetadataAbsent(data)
        || data.secureShareCopyState == "active";
    }

    function legacyActiveDeleteMetadata(data) {
      return !data.keys().hasAny(["isDeleted", "deletedAt", "deletedBy"]);
    }

    function noteDeleted(data) {
      return data.keys().hasAny(["isDeleted"]) && data.isDeleted == true;
    }

    function noteActive(data) {
      return legacyActiveDeleteMetadata(data)
        || (data.keys().hasAny(["isDeleted"]) && data.isDeleted == false);
    }

    function notePurged(data) {
      return data.keys().hasAny(["isPurged"]) && data.isPurged == true;
    }

    function validScheduleDate(value) {
      return value == null
        || (
          value is string
          && value.size() == 10
          && value.matches("^(((19|20|21)[0-9]{2}-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8])))|(((19|21)(0[48]|[2468][048]|[13579][26])|20(0[048]|[2468][048]|[13579][26]))-02-29))$")
        );
    }

    function encryptedSchedulePayload(payload, maxCipherTextSize) {
      return encryptedPayload(payload)
        && payload.cipherText.size() > 0
        && payload.cipherText.size() <= maxCipherTextSize
        && payload.iv.size() > 0
        && payload.iv.size() <= 256;
    }

    function validLibraryWrappedKey(payload) {
      return wrappedAesKeyPayload(payload)
        && (
          payload.wrappedKey.size() == 344
          || payload.wrappedKey.size() == 512
        );
    }

    function validScheduleWrappedKeys(data, uid) {
      return data.wrappedKeys is map
        && data.wrappedKeys.keys().hasOnly([uid])
        && wrappedAesKeyPayload(data.wrappedKeys[uid]);
    }

    function currentGoogleCalendarConnectionGeneration(uid, generation) {
      return exists(googleCalendarConnectionPath(uid))
        && get(googleCalendarConnectionPath(uid)).data.connectionStatus == "connected"
        && get(googleCalendarConnectionPath(uid)).data.connectionGeneration == generation;
    }

    function validGoogleCalendarTaskTombstone(data, taskId, uid) {
      return data.keys().hasOnly([
          "ownerUid",
          "taskId",
          "deletionAttemptId",
          "connectionGeneration",
          "createdAt",
          "leaseExpiresAt"
        ])
        && data.keys().hasAll(["ownerUid", "taskId", "deletionAttemptId", "createdAt", "leaseExpiresAt"])
        && data.ownerUid == uid
        && data.taskId is string
        && data.taskId == taskId
        && data.taskId.matches("^[A-Za-z0-9_-]{1,128}$")
        && data.deletionAttemptId is string
        && data.deletionAttemptId.matches("^[0-9a-f]{32}$")
        && (
          !data.keys().hasAny(["connectionGeneration"])
          || data.connectionGeneration == null
          || (
            data.connectionGeneration is string
            && data.connectionGeneration.matches("^[A-Za-z0-9_-]{43}$")
          )
        )
        && data.createdAt is timestamp
        && data.leaseExpiresAt is timestamp;
    }

    function googleCalendarTaskTombstoneMatchesConnection(data, uid) {
      return (
          (
            !data.keys().hasAny(["connectionGeneration"])
            || data.connectionGeneration == null
          )
          && !exists(googleCalendarConnectionPath(uid))
        )
        || (
          data.keys().hasAny(["connectionGeneration"])
          && data.connectionGeneration is string
          && currentGoogleCalendarConnectionGeneration(uid, data.connectionGeneration)
        );
    }

    function adminDeletesManagedUser(uid) {
      return adminUser()
        && uid != request.auth.uid
        && exists(userPath(uid))
        && exists(rosterPath(uid))
        && exists(userKeyPath(uid))
        && exists(quickLoginKeyPath(get(userPath(uid)).data.quickKey))
        && !existsAfter(userPath(uid))
        && !existsAfter(rosterPath(uid))
        && !existsAfter(userKeyPath(uid))
        && !existsAfter(quickLoginKeyPath(get(userPath(uid)).data.quickKey));
    }

    function validBootstrapTokenHash(value) {
      return value is string && value.size() == 64;
    }

    function validBootstrapAttempt(data, uid) {
      return data.keys().hasOnly(["uid", "setupTokenHash", "createdAt"])
        && data.uid == uid
        && validBootstrapTokenHash(data.setupTokenHash)
        && data.createdAt == request.time;
    }

    function validBootstrapGate(data) {
      return data.keys().hasOnly(["setupTokenHash", "createdAt"])
        && validBootstrapTokenHash(data.setupTokenHash)
        && data.createdAt is timestamp;
    }

    function bootstrapCreatesAdmin(uid) {
      return signedIn()
        && request.auth.uid == uid
        && !exists(bootstrapPath())
        && exists(bootstrapGatePath())
        && validBootstrapGate(get(bootstrapGatePath()).data)
        && existsAfter(bootstrapAttemptPath(uid))
        && validBootstrapAttempt(getAfter(bootstrapAttemptPath(uid)).data, uid)
        && getAfter(bootstrapAttemptPath(uid)).data.setupTokenHash == get(bootstrapGatePath()).data.setupTokenHash
        && getAfter(bootstrapPath()).data.adminUid == uid;
    }

    function firstAdminCreate(uid) {
      return bootstrapCreatesAdmin(uid)
        && getAfter(userPath(uid)).data.isAdmin == true
        && getAfter(userPath(uid)).data.isActive == true
        && getAfter(rosterPath(uid)).data.isAdmin == true
        && getAfter(userKeyPath(uid)).data.uid == uid
        && getAfter(quickLoginKeyPath(getAfter(userPath(uid)).data.quickKey)).data.uid == uid;
    }

    function adminCreatesUser(uid) {
      return adminUser()
        && getAfter(rosterPath(uid)).data.uid == uid
        && getAfter(userKeyPath(uid)).data.uid == uid
        && getAfter(quickLoginKeyPath(getAfter(userPath(uid)).data.quickKey)).data.uid == uid;
    }

    function validNotePurgeCleanupQueue(data, noteId) {
      return data.keys().hasOnly(["noteId", "ownerUid", "createdAt"])
        && data.keys().hasAll(["noteId", "ownerUid", "createdAt"])
        && data.noteId == noteId
        && data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.createdAt == request.time;
    }

    function ownerAllowsParticipant(data, uid) {
      return uid == data.ownerUid
        || (
          userHasNotes(data.ownerUid)
          && (
            get(userPath(data.ownerUid)).data.isAdmin == true
            || (
              get(userPath(data.ownerUid)).data.keys().hasAny(["allowedShareTargetUids"])
              && uid in get(userPath(data.ownerUid)).data.allowedShareTargetUids
            )
          )
        );
    }

    function canReadNote(data) {
      return noteActive(data)
        && !notePurged(data)
        && secureShareCopyUsable(data)
        && (
          adminUser()
          || (
            activeSignedInUserHasNotes()
            && (
              data.ownerUid == request.auth.uid
              || (
                request.auth.uid in data.participantUids
                && ownerAllowsParticipant(data, request.auth.uid)
              )
            )
          )
        );
    }

    function canReadSecureShareCopyNote(data) {
      return !secureShareCopyMetadataAbsent(data)
        && data.secureShareCopyState in ["copying", "aborted"]
        && !notePurged(data)
        && (
          adminUser()
          || (
            activeSignedInUserHasNotes()
            && data.ownerUid == request.auth.uid
          )
        );
    }

    function canReadDeletedNote(data) {
      return noteDeleted(data)
        && !notePurged(data)
        && canDeleteNote(data);
    }

    function canReadNoteDocument(data) {
      return canReadNote(data)
        || canReadDeletedNote(data)
        || canReadSecureShareCopyNote(data);
    }

    function canDeleteNote(data) {
      return adminUser()
        || (activeSignedInUserHasNotes() && data.ownerUid == request.auth.uid);
    }

    function publicShareOwner(data) {
      return activeSignedInUserHasNotes()
        && data.ownerUid == request.auth.uid;
    }

    function validPublicShareCleanupQueue(data, shareId) {
      return data.keys().hasOnly(["shareId", "expiresAt", "createdAt"])
        && data.shareId == shareId
        && data.expiresAt is timestamp
        && data.createdAt == request.time;
    }

    match /publicLoginRoster/{uid} {
      function validRoster(data, uid) {
        return data.keys().hasOnly([
          "uid",
          "displayName",
          "avatarText",
          "color",
          "order",
          "quickKey",
          "loginEmail",
          "isActive",
          "isAdmin"
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 40
        && data.avatarText is string
        && data.avatarText.size() > 0
        && data.avatarText.size() <= 4
        && data.color is string
        && data.order is int
        && data.order >= 1
        && data.quickKey is int
        && data.quickKey >= 1
        && data.quickKey <= 99
        && data.loginEmail is string
        && data.isActive is bool
        && data.isAdmin is bool;
      }

      function rosterMatchesUser(data, uid) {
        return getAfter(userPath(uid)).data.displayName == data.displayName
          && getAfter(userPath(uid)).data.avatarText == data.avatarText
          && getAfter(userPath(uid)).data.color == data.color
          && getAfter(userPath(uid)).data.order == data.order
          && getAfter(userPath(uid)).data.quickKey == data.quickKey
          && getAfter(userPath(uid)).data.loginEmail == data.loginEmail
          && getAfter(userPath(uid)).data.isActive == data.isActive
          && getAfter(userPath(uid)).data.isAdmin == data.isAdmin;
      }

      allow get: if adminUser();
      allow list: if resource.data.isActive == true
        && request.query.limit != null
        && request.query.limit <= 100;
      allow create: if validRoster(request.resource.data, uid)
        && (firstAdminCreate(uid) || adminCreatesUser(uid));
      allow update: if adminUser()
        && validRoster(request.resource.data, uid)
        && rosterMatchesUser(request.resource.data, uid)
        && getAfter(userPath(uid)).data.quickKey == request.resource.data.quickKey
        && getAfter(quickLoginKeyPath(request.resource.data.quickKey)).data.uid == uid;
      allow delete: if adminDeletesManagedUser(uid);
    }

    match /users/{uid} {
      function validUserProfile(data, uid) {
        return data.keys().hasOnly([
          "uid",
          "displayName",
          "avatarText",
          "color",
          "order",
          "quickKey",
          "loginEmail",
          "isActive",
          "isAdmin",
          "role",
          "publicKeyJwk",
          "allowedShareTargetUids",
          "featureAccess",
          "createdAt",
          "updatedAt",
          "needsKeyRecovery"
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 40
        && data.avatarText is string
        && data.avatarText.size() > 0
        && data.avatarText.size() <= 4
        && data.color is string
        && data.order is int
        && data.order >= 1
        && data.quickKey is int
        && data.quickKey >= 1
        && data.quickKey <= 99
        && data.loginEmail is string
        && data.isActive is bool
        && data.isAdmin is bool
        && data.role in ["admin", "user"]
        && ((data.isAdmin == true && data.role == "admin") || (data.isAdmin == false && data.role == "user"))
        && data.publicKeyJwk is map
        && (
          !data.keys().hasAny(["featureAccess"])
          || validFeatureAccess(data.featureAccess)
        )
        && (
          !data.keys().hasAny(["allowedShareTargetUids"])
          || (
            data.allowedShareTargetUids is list
            && data.allowedShareTargetUids.size() <= 200
            && uid in data.allowedShareTargetUids
          )
        )
        && data.needsKeyRecovery is bool;
      }

      function userMatchesRoster(data, uid) {
        return getAfter(rosterPath(uid)).data.displayName == data.displayName
          && getAfter(rosterPath(uid)).data.avatarText == data.avatarText
          && getAfter(rosterPath(uid)).data.color == data.color
          && getAfter(rosterPath(uid)).data.order == data.order
          && getAfter(rosterPath(uid)).data.quickKey == data.quickKey
          && getAfter(rosterPath(uid)).data.loginEmail == data.loginEmail
          && getAfter(rosterPath(uid)).data.isActive == data.isActive
          && getAfter(rosterPath(uid)).data.isAdmin == data.isAdmin;
      }

      function requestingAdminRemainsActive(data, uid) {
        return uid != request.auth.uid
          || (data.isAdmin == true && data.isActive == true);
      }

      allow get: if activeSignedInUser() || (signedIn() && request.auth.uid == uid);
      allow list: if activeSignedInUser()
        && request.query.limit != null
        && request.query.limit <= 100;
      allow create: if validUserProfile(request.resource.data, uid)
        && (firstAdminCreate(uid) || adminCreatesUser(uid));
      allow update: if adminUser()
        && validUserProfile(request.resource.data, uid)
        && requestingAdminRemainsActive(request.resource.data, uid)
        && userMatchesRoster(request.resource.data, uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "displayName",
          "avatarText",
          "color",
          "quickKey",
          "order",
          "isActive",
          "isAdmin",
          "role",
          "allowedShareTargetUids",
          "featureAccess",
          "updatedAt"
        ])
        && getAfter(rosterPath(uid)).data.quickKey == request.resource.data.quickKey
        && getAfter(quickLoginKeyPath(request.resource.data.quickKey)).data.uid == uid;
      allow delete: if adminDeletesManagedUser(uid);
    }

    match /userKeys/{uid} {
      function validUserKey(data, uid) {
        return data.keys().hasOnly([
          "uid",
          "publicKeyJwk",
          "encryptedPrivateKeyJwk",
          "kdfSalt",
          "kdfIterations",
          "pendingEncryptedPrivateKeyJwk",
          "pendingKdfSalt",
          "pendingKdfIterations",
          "pendingCreatedAt",
          "updatedAt"
        ])
        && data.uid == uid
        && data.publicKeyJwk is map
        && encryptedPayload(data.encryptedPrivateKeyJwk)
        && data.kdfSalt is string
        && data.kdfIterations is int
        && data.kdfIterations >= 100000
        && (
          !data.keys().hasAny(["pendingEncryptedPrivateKeyJwk", "pendingKdfSalt", "pendingKdfIterations", "pendingCreatedAt"])
          || (
            data.keys().hasAll(["pendingEncryptedPrivateKeyJwk", "pendingKdfSalt", "pendingKdfIterations", "pendingCreatedAt"])
            && encryptedPayload(data.pendingEncryptedPrivateKeyJwk)
            && data.pendingKdfSalt is string
            && data.pendingKdfIterations is int
            && data.pendingKdfIterations >= 100000
            && data.pendingCreatedAt is timestamp
          )
        )
        && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp);
      }

      allow read: if activeSignedInUser() && request.auth.uid == uid;
      allow create: if validUserKey(request.resource.data, uid)
        && (firstAdminCreate(uid) || adminCreatesUser(uid));
      allow update: if activeSignedInUser()
        && request.auth.uid == uid
        && validUserKey(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.publicKeyJwk == resource.data.publicKeyJwk
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "encryptedPrivateKeyJwk",
          "kdfSalt",
          "kdfIterations",
          "pendingEncryptedPrivateKeyJwk",
          "pendingKdfSalt",
          "pendingKdfIterations",
          "pendingCreatedAt",
          "updatedAt"
        ]);
      allow delete: if adminDeletesManagedUser(uid);
    }

    match /userPreferences/{uid} {
      function validUserPreferences(data, uid) {
        return data.keys().hasOnly([
            "uid",
            "defaultHome",
            "encryptedMatrixLabels",
            "matrixLabelsFormat",
            "matrixLabelsWrappedKey",
            "scheduleDefaultView",
            "scheduleDefaultCategory",
            "theme",
            "createdAt",
            "updatedAt"
          ])
          && data.uid == uid
          && data.defaultHome in ["notes", "library", "schedule"]
          && validEncryptedMatrixLabels(data)
          && data.scheduleDefaultView in ["todo", "calendar", "matrix", "recurring", "completed"]
          && (!data.keys().hasAny(["scheduleDefaultCategory"]) || data.scheduleDefaultCategory in ["all", "work", "personal"])
          && (!data.keys().hasAny(["theme"]) || data.theme in ["light", "dark", "system"])
          && (!data.keys().hasAny(["createdAt"]) || data.createdAt is timestamp)
          && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp);
      }

      function validEncryptedMatrixLabels(data) {
        return !data.keys().hasAny([
            "encryptedMatrixLabels",
            "matrixLabelsFormat",
            "matrixLabelsWrappedKey"
          ])
          || (
            data.keys().hasAll([
              "encryptedMatrixLabels",
              "matrixLabelsFormat",
              "matrixLabelsWrappedKey"
            ])
            && data.matrixLabelsFormat == "matrix-labels-v1"
            && encryptedPayload(data.encryptedMatrixLabels)
            && data.encryptedMatrixLabels.cipherText.size() >= 24
            && data.encryptedMatrixLabels.cipherText.size() <= 4096
            && data.encryptedMatrixLabels.iv.size() == 16
            && wrappedAesKeyPayload(data.matrixLabelsWrappedKey)
            && (
              data.matrixLabelsWrappedKey.wrappedKey.size() == 344
              || data.matrixLabelsWrappedKey.wrappedKey.size() == 512
            )
          );
      }

      allow read: if activeSignedInUser() && request.auth.uid == uid;
      allow create: if activeSignedInUser()
        && request.auth.uid == uid
        && validUserPreferences(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if activeSignedInUser()
        && request.auth.uid == uid
        && validUserPreferences(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && (
          (
            !request.resource.data.keys().hasAny(["createdAt"])
            && !resource.data.keys().hasAny(["createdAt"])
          )
          || request.resource.data.createdAt == resource.data.createdAt
        )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "defaultHome",
          "matrixLabels",
          "encryptedMatrixLabels",
          "matrixLabelsFormat",
          "matrixLabelsWrappedKey",
          "scheduleDefaultView",
          "scheduleDefaultCategory",
          "theme",
          "updatedAt"
        ]);
    }

    match /libraryVaults/{uid} {
      function libraryVaultPath(uid) {
        return /databases/$(database)/documents/libraryVaults/$(uid);
      }

      function validLibraryVault(data, uid) {
        return data.keys().hasAll(["ownerUid", "wrappedKey", "createdAt", "updatedAt"])
          && data.keys().hasOnly(["ownerUid", "wrappedKey", "createdAt", "updatedAt"])
          && data.ownerUid == uid
          && validLibraryWrappedKey(data.wrappedKey)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      allow get: if activeSignedInUserHasFeature("library")
        && request.auth.uid == uid
        && (
          !exists(libraryVaultPath(uid))
          || resource.data.ownerUid == uid
        );
      allow create: if activeSignedInUserHasFeature("library")
        && request.auth.uid == uid
        && validLibraryVault(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /vaultIntegrity/{uid} {
      function validVaultIntegrity(data, uid) {
        return data.keys().hasAll(["ownerUid", "indexVersion", "wrappedKey", "createdAt", "updatedAt"])
          && data.keys().hasOnly([
            "ownerUid", "indexVersion", "wrappedKey", "createdAt", "updatedAt",
            "cutoverState", "cutoverVersion", "verifiedAt"
          ])
          && data.ownerUid == uid
          && data.indexVersion == 1
          && wrappedAesKeyPayload(data.wrappedKey)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && (
            // Keep the five-field legacy marker valid during the Rules-first
            // rolling deployment. New clients always create an explicit pending
            // marker; only the authenticated server API can add a ready seal.
            !data.keys().hasAny(["cutoverState", "cutoverVersion", "verifiedAt"])
            || (
              data.keys().hasAll(["cutoverState", "cutoverVersion"])
              && data.cutoverState == "pending"
              && data.cutoverVersion == 1
              && !data.keys().hasAny(["verifiedAt"])
            )
            || (
