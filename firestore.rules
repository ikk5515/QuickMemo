            "kind",
            "version",
            "planFingerprint",
            "status",
            "stepCount",
            "cursor",
            "confirmedCount",
            "attemptCount",
            "retryCount",
            "lastErrorCode",
            "revision",
            "encryptedManifest",
            "wrappedKey",
            "createdAt",
            "updatedAt",
            "activatedAt",
            "completedAt",
            "recoveredAt",
            "lastAttemptAt",
            "notAppliedAt",
            "recoveryCheckCount",
            "lastRecoveryCheckAt",
            "remainingStepCount",
            "cleanupStartedAt",
            "lastCleanupStepId",
            "activationMode",
            "preparedStepCount",
            "mutationExpectedRevision",
            "mutationTargetId",
            "mutationTargetKind",
