          && data.status == "blocked"
          && data.cursor == resource.data.cursor
          && data.confirmedCount == resource.data.confirmedCount
          && data.attemptCount == resource.data.attemptCount
          && data.retryCount == resource.data.retryCount + 1
          && data.lastErrorCode != null
          && data.lastErrorCode != "path-state-conflict"
          && data.diff(resource.data).affectedKeys().hasOnly([
            "status", "retryCount", "lastErrorCode", "revision", "updatedAt"
          ]);
      }

      function vaultPathRewriteStepConfirmed(data) {
        return resource.data.status == "running"
          && data.cursor == resource.data.cursor + 1
          && data.confirmedCount == data.cursor
          && data.attemptCount == resource.data.attemptCount
          && data.retryCount == resource.data.retryCount
          && data.lastErrorCode == null
          && (
            (data.cursor == data.stepCount && data.status == "completed" && data.completedAt == request.time)
            || (data.cursor < data.stepCount && data.status == "running" && !data.keys().hasAny(["completedAt"]))
          )
          && data.diff(resource.data).affectedKeys().hasOnly([
            "cursor", "confirmedCount", "status", "lastErrorCode", "revision", "completedAt", "updatedAt"
          ]);
      }

      function vaultPathRewriteTerminalCleanupStart(data) {
        return resource.data.status in ["completed", "abandoned"]
          && (
            resource.data.status == "abandoned"
            || resource.data.stepCount > 0
            || resource.data.completedAt <= request.time - duration.value(2, "m")
          )
          && !resource.data.keys().hasAny(["cleanupStartedAt"])
          && data.status == resource.data.status
          && data.cursor == resource.data.cursor
          && data.confirmedCount == resource.data.confirmedCount
          && data.attemptCount == resource.data.attemptCount
          && data.retryCount == resource.data.retryCount
          && data.lastErrorCode == resource.data.lastErrorCode
          && data.cleanupStartedAt == request.time
          && (
            (resource.data.keys().hasAny(["remainingStepCount"])
              && data.remainingStepCount == resource.data.remainingStepCount)
            || (!resource.data.keys().hasAny(["remainingStepCount"])
              && data.remainingStepCount == resource.data.stepCount)
          )
          && data.diff(resource.data).affectedKeys().hasOnly([
            "remainingStepCount", "cleanupStartedAt", "revision", "updatedAt"
          ]);
      }

      function vaultPathRewriteTerminalCleanupProgress(data) {
        return resource.data.status in ["completed", "abandoned"]
          && resource.data.cleanupStartedAt is timestamp
          && resource.data.remainingStepCount > 0
          && data.status == resource.data.status
          && data.cursor == resource.data.cursor
          && data.confirmedCount == resource.data.confirmedCount
          && data.attemptCount == resource.data.attemptCount
          && data.retryCount == resource.data.retryCount
          && data.lastErrorCode == resource.data.lastErrorCode
          && data.cleanupStartedAt == resource.data.cleanupStartedAt
          && data.remainingStepCount == resource.data.remainingStepCount - 1
          && data.keys().hasAny(["lastCleanupStepId"])
          && exists(vaultPathRewriteStepPath(data.ownerUid, data.planFingerprint, data.lastCleanupStepId))
          && get(vaultPathRewriteStepPath(data.ownerUid, data.planFingerprint, data.lastCleanupStepId)).data.ordinal
            == resource.data.remainingStepCount - 1
          && !existsAfter(vaultPathRewriteStepPath(data.ownerUid, data.planFingerprint, data.lastCleanupStepId))
          && data.diff(resource.data).affectedKeys().hasOnly([
            "remainingStepCount", "lastCleanupStepId", "revision", "updatedAt"
          ]);
      }

      function vaultPathRewriteAbandonedCleanupFinish(data) {
        return resource.data.status == "abandoned"
          && resource.data.cleanupStartedAt is timestamp
          && data.status == resource.data.status
          && data.cursor == 0
          && data.confirmedCount == 0
          && data.attemptCount == resource.data.attemptCount
          && data.retryCount == resource.data.retryCount
          && data.lastErrorCode == null
          && data.cleanupStartedAt == resource.data.cleanupStartedAt
          && data.remainingStepCount == 0
          && data.diff(resource.data).affectedKeys().hasOnly([
            "remainingStepCount", "revision", "updatedAt"
          ]);
      }

      function vaultPathRewriteStateTransition(data) {
        return resource.data.status == "preparing"
          ? data.status == "abandoned"
            ? (
              vaultPathRewriteAtomicAbandoned(data)
              || vaultPathRewriteLegacyPreparingAbandoned(data)
            )
            : vaultPathRewritePreparingToPrepared(data)
          : resource.data.status == "prepared"
            ? data.status == "abandoned"
              ? vaultPathRewriteAtomicAbandoned(data)
              : data.status == "not-applied"
              ? vaultPathRewriteNotApplied(data)
              : data.status == "blocked"
                ? vaultPathRewritePathConflict(data)
                : data.keys().hasAny(["recoveredAt"])
                  ? vaultPathRewritePathRecovery(data)
                  : vaultPathRewritePreparedActivation(data)
            : resource.data.status == "not-applied"
              ? data.status == "not-applied"
                ? vaultPathRewriteNotApplied(data)
                : data.status == "blocked"
                  ? vaultPathRewritePathConflict(data)
                  : data.status == "prepared"
                    ? vaultPathRewriteNotAppliedRevival(data)
                    : data.keys().hasAny(["recoveredAt"])
                      ? vaultPathRewritePathRecovery(data)
                      : vaultPathRewritePreparedActivation(data)
              : resource.data.status == "blocked"
                ? (
                  resource.data.lastErrorCode == "path-state-conflict"
                  ? data.status == "abandoned"
                    ? (
                      vaultPathRewriteAtomicAbandoned(data)
                      || vaultPathRewriteLegacyZeroStepAbandoned(data)
                    )
                    : data.status == "completed"
                      ? vaultPathRewriteActivatedZeroStepCompleted(data)
                    : data.status == "not-applied"
                      ? vaultPathRewriteNotApplied(data)
                      : data.status == "blocked"
                        ? vaultPathRewritePathConflict(data)
                        : vaultPathRewritePathRecovery(data)
                  : data.status == "blocked"
                    ? vaultPathRewriteBlocked(data)
                    : vaultPathRewriteAttemptStart(data)
                )
                : resource.data.status in ["ready", "running"]
                  ? data.status == "blocked"
                    ? vaultPathRewriteBlocked(data)
                    : data.cursor == resource.data.cursor + 1
                      ? vaultPathRewriteStepConfirmed(data)
                      : vaultPathRewriteAttemptStart(data)
                  : resource.data.status in ["completed", "abandoned"]
                    ? (
                      data.status == "preparing"
                        ? vaultPathRewriteAtomicAbandonedRevival(data)
                        : (
                          vaultPathRewriteTerminalCleanupStart(data)
                          || vaultPathRewriteTerminalCleanupProgress(data)
                          || vaultPathRewriteAbandonedCleanupFinish(data)
                        )
                    )
                    : false;
      }

      function validVaultPathRewriteJobCreate(data, uid, jobId) {
        return validVaultPathRewriteJob(data, uid, jobId)
          && (
            data.status == "preparing"
            || (
              data.status == "prepared"
              && validVaultPathRewriteAtomicMode(data.activationMode)
              && data.stepCount == 0
              && data.preparedStepCount == 0
            )
          )
          && data.cursor == 0
          && data.confirmedCount == 0
          && data.attemptCount == 0
          && data.retryCount == 0
          && data.lastErrorCode == null
          && (
            !data.keys().hasAny(["recoveryCheckCount"])
            || data.recoveryCheckCount == 0
          )
          && (
            !data.keys().hasAny(["remainingStepCount"])
            || data.remainingStepCount == data.stepCount
          )
          && data.revision == 1
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && !data.keys().hasAny([
            "activatedAt",
            "completedAt",
            "recoveredAt",
            "lastAttemptAt",
            "notAppliedAt",
            "lastRecoveryCheckAt",
            "cleanupStartedAt",
            "abandonedAt"
          ]);
      }

      function validVaultPathRewriteJobUpdate(data, uid, jobId) {
        return validVaultPathRewriteJob(data, uid, jobId)
          && resource.data.ownerUid == uid
          && resource.data.kind == data.kind
          && resource.data.version == data.version
          && resource.data.planFingerprint == data.planFingerprint
          && (
            jobId.matches("^pr2_[A-Za-z0-9_-]{43}$")
              ? resource.data.inventoryFingerprint == data.inventoryFingerprint
                && !resource.data.keys().hasAny([
                  "inventoryManifestVersion", "inventoryManifestEpoch",
                  "inventoryManifestShardCount", "inventoryManifestRoot"
                ])
                && !data.keys().hasAny([
                  "inventoryManifestVersion", "inventoryManifestEpoch",
                  "inventoryManifestShardCount", "inventoryManifestRoot"
                ])
              : jobId.matches("^pr3_[A-Za-z0-9_-]{43}$")
                ? !resource.data.keys().hasAny(["inventoryFingerprint"])
                  && !data.keys().hasAny(["inventoryFingerprint"])
                  && resource.data.inventoryManifestVersion == data.inventoryManifestVersion
                  && resource.data.inventoryManifestEpoch == data.inventoryManifestEpoch
                  && resource.data.inventoryManifestShardCount == data.inventoryManifestShardCount
                  && resource.data.inventoryManifestRoot == data.inventoryManifestRoot
                : !resource.data.keys().hasAny([
                  "inventoryFingerprint", "inventoryManifestVersion", "inventoryManifestEpoch",
                  "inventoryManifestShardCount", "inventoryManifestRoot"
                ])
                  && !data.keys().hasAny([
                    "inventoryFingerprint", "inventoryManifestVersion", "inventoryManifestEpoch",
                    "inventoryManifestShardCount", "inventoryManifestRoot"
                  ])
          )
          && resource.data.stepCount == data.stepCount
          && resource.data.encryptedManifest == data.encryptedManifest
          && resource.data.wrappedKey == data.wrappedKey
          && resource.data.createdAt == data.createdAt
          && data.revision == resource.data.revision + 1
          && data.updatedAt == request.time
          && vaultPathRewriteStateTransition(data);
      }

      // Keep hot maintenance transitions below Firestore's 1,000-expression
      // ceiling. Each transition function constrains the complete affected-key
      // set, while these shared fences preserve owner, revision, and timestamps.
      function validVaultPathRewriteMaintenanceUpdate(data, uid) {
        return resource.data.ownerUid == uid
          && data.ownerUid == uid
          && data.revision == resource.data.revision + 1
          && data.updatedAt == request.time
          && (
            resource.data.status in ["completed", "abandoned"]
              ? data.status == "preparing"
                ? vaultPathRewriteAtomicAbandonedRevival(data)
                : (
                  vaultPathRewriteTerminalCleanupStart(data)
                  || vaultPathRewriteTerminalCleanupProgress(data)
                  || vaultPathRewriteAbandonedCleanupFinish(data)
                )
              : resource.data.keys().hasAny(["activationMode"])
                && resource.data.status == "preparing"
                ? data.status == "abandoned"
                  ? vaultPathRewriteAtomicAbandoned(data)
                  : data.status == "prepared"
                    ? vaultPathRewritePreparingToPrepared(data)
                    : vaultPathRewritePreparationHeartbeat(data)
              : resource.data.keys().hasAny(["activationMode"])
                && resource.data.status == "ready"
                && resource.data.stepCount == 0
                  ? vaultPathRewriteZeroStepAcknowledged(data)
                : resource.data.keys().hasAny(["activationMode"])
                && resource.data.status == "blocked"
                && resource.data.lastErrorCode == "path-state-conflict"
                  ? data.status == "abandoned"
                    ? vaultPathRewriteAtomicAbandoned(data)
                    : data.status == "completed"
                      ? vaultPathRewriteActivatedZeroStepCompleted(data)
                      : false
                : resource.data.status in ["ready", "running"]
                  ? data.status == "blocked"
                    ? vaultPathRewriteBlocked(data)
                    : data.cursor == resource.data.cursor + 1
                      ? vaultPathRewriteStepConfirmed(data)
                      : vaultPathRewriteAttemptStart(data)
                : resource.data.status == "preparing"
                  ? data.status == "abandoned"
                    ? vaultPathRewriteLegacyPreparingAbandoned(data)
                    : vaultPathRewritePreparingToPrepared(data)
                : resource.data.status == "prepared"
                  ? data.status == "not-applied"
                    ? vaultPathRewriteNotApplied(data)
                    : data.status == "blocked"
                      ? vaultPathRewritePathConflict(data)
                      : data.keys().hasAny(["recoveredAt"])
                        ? vaultPathRewritePathRecovery(data)
                        : vaultPathRewritePreparedActivation(data)
                : resource.data.status == "not-applied"
                  ? data.status == "not-applied"
                    ? vaultPathRewriteNotApplied(data)
                    : data.status == "blocked"
                      ? vaultPathRewritePathConflict(data)
                      : data.status == "prepared"
                        ? vaultPathRewriteNotAppliedRevival(data)
                        : data.keys().hasAny(["recoveredAt"])
                          ? vaultPathRewritePathRecovery(data)
                          : vaultPathRewritePreparedActivation(data)
                : resource.data.status == "blocked"
                  ? resource.data.lastErrorCode == "path-state-conflict"
                    ? data.status == "abandoned"
                      ? vaultPathRewriteLegacyZeroStepAbandoned(data)
                      : data.status == "completed"
                        ? vaultPathRewriteActivatedZeroStepCompleted(data)
                        : data.status == "not-applied"
                          ? vaultPathRewriteNotApplied(data)
                          : data.status == "blocked"
                            ? vaultPathRewritePathConflict(data)
                            : vaultPathRewritePathRecovery(data)
                    : data.status == "blocked"
                      ? vaultPathRewriteBlocked(data)
                      : vaultPathRewriteAttemptStart(data)
                : false
          );
      }

      function validVaultPathRewriteStep(data, uid, jobId, stepId) {
        let parent = get(vaultPathRewriteJobPath(uid, jobId)).data;
        return data.keys().hasAll(["ownerUid", "jobId", "stepId", "ordinal", "encryptedStep", "createdAt"])
          && data.keys().hasOnly(["ownerUid", "jobId", "stepId", "ordinal", "encryptedStep", "createdAt"])
          && validVaultPathRewriteJobId(jobId)
          && stepId.matches("^step-[0-9]{6}$")
          && data.ownerUid == uid
          && data.jobId == jobId
          && data.stepId == stepId
          && exists(vaultPathRewriteJobPath(uid, jobId))
          && parent.ownerUid == uid
          && parent.status == "preparing"
          && data.ordinal is int
          && data.ordinal >= 0
          && data.ordinal < parent.stepCount
          && boundedEncryptedPayload(data.encryptedStep, 900000)
          && data.createdAt == request.time;
      }

      allow get: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && (
          !exists(vaultPathRewriteJobPath(uid, jobId))
          || resource.data.ownerUid == uid
        );
      allow list: if activeSignedInUserHasNotes()
        && request.auth.uid == uid;
      allow create: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && validVaultPathRewriteJobCreate(request.resource.data, uid, jobId);
      allow update: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && (
          validVaultPathRewriteMaintenanceUpdate(request.resource.data, uid)
          || validVaultPathRewriteJobUpdate(request.resource.data, uid, jobId)
        );
      allow delete: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && resource.data.ownerUid == uid
        && resource.data.status in ["completed", "abandoned"]
        && (
          resource.data.status == "abandoned"
          || resource.data.stepCount > 0
          || resource.data.completedAt <= request.time - duration.value(2, "m")
        )
        && resource.data.cleanupStartedAt is timestamp
        && resource.data.remainingStepCount == 0;

      match /steps/{stepId} {
        allow get, list: if activeSignedInUserHasNotes()
          && request.auth.uid == uid;
        allow create: if activeSignedInUserHasNotes()
          && request.auth.uid == uid
          && validVaultPathRewriteStep(request.resource.data, uid, jobId, stepId);
        allow delete: if activeSignedInUserHasNotes()
          && request.auth.uid == uid
          && resource.data.ownerUid == uid
          && exists(vaultPathRewriteJobPath(uid, jobId))
          && get(vaultPathRewriteJobPath(uid, jobId)).data.ownerUid == uid
          && get(vaultPathRewriteJobPath(uid, jobId)).data.cleanupStartedAt is timestamp
          && (
            get(vaultPathRewriteJobPath(uid, jobId)).data.status == "abandoned"
            || (
              get(vaultPathRewriteJobPath(uid, jobId)).data.status == "completed"
              && resource.data.ordinal
                == get(vaultPathRewriteJobPath(uid, jobId)).data.remainingStepCount - 1
              && existsAfter(vaultPathRewriteJobPath(uid, jobId))
              && getAfter(vaultPathRewriteJobPath(uid, jobId)).data.ownerUid == uid
              && getAfter(vaultPathRewriteJobPath(uid, jobId)).data.status == "completed"
              && getAfter(vaultPathRewriteJobPath(uid, jobId)).data.remainingStepCount
                == get(vaultPathRewriteJobPath(uid, jobId)).data.remainingStepCount - 1
            )
          );
      }
    }

    match /vaultMaintenanceJobs/{uid}/imports/{jobId} {
      function validVaultImportJobId(jobId) {
        return jobId is string && jobId.matches("^vi1_[A-Za-z0-9_-]{43}$");
      }

      // Access mutations cannot change encrypted content, ownership, deletion,
      // purge, attachment, or timestamp identity fields. Validate only the
      // mutable access projection here to stay below Firestore's 1000-expression
      // budget while preserving the same constraints for every changed value.
      function validVaultImportError(value) {
        return value == null || value in [
          "job-corrupt",
          "rollback-conflict",
          "snapshot-incomplete",
          "write-failed"
        ];
      }

      function validVaultImportJob(data, uid, jobId) {
        return data.keys().hasAll([
            "ownerUid", "kind", "version", "status", "itemCount", "entryCount",
            "folderCount", "rootFolderCount", "chunkCount", "revision",
            "remainingChunkCount", "lastErrorCode", "wrappedKey", "createdAt", "updatedAt"
          ])
          && data.keys().hasOnly([
            "ownerUid", "kind", "version", "status", "itemCount", "entryCount",
            "folderCount", "rootFolderCount", "chunkCount", "revision",
            "remainingChunkCount", "lastErrorCode", "wrappedKey", "createdAt", "updatedAt", "preparedAt",
            "committedAt", "rollbackStartedAt", "rolledBackAt"
          ])
          && validVaultImportJobId(jobId)
          && data.ownerUid == uid
          && data.kind == "vault-import-v1"
          && data.version == 1
          && data.status in ["preparing", "staging", "committed", "rolling-back", "rolled-back", "blocked"]
          && data.itemCount is int
          && data.itemCount >= 1
          && data.itemCount <= 10000
          && data.entryCount is int
          && data.entryCount >= 1
          && data.folderCount is int
          && data.folderCount >= 0
          && data.folderCount <= 5000
          && data.entryCount + data.folderCount == data.itemCount
          && data.rootFolderCount is int
          && data.rootFolderCount >= 0
          && data.rootFolderCount <= data.folderCount
          && data.chunkCount is int
          && data.chunkCount >= 1
          && data.chunkCount <= 100
          && data.remainingChunkCount is int
          && data.remainingChunkCount >= 0
          && data.remainingChunkCount <= data.chunkCount
          && data.revision is int
          && data.revision >= 1
          && data.revision <= 999999999999
          && validVaultImportError(data.lastErrorCode)
          && ((data.status == "blocked") == (data.lastErrorCode != null))
          && wrappedAesKeyPayload(data.wrappedKey)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && (!data.keys().hasAny(["preparedAt"]) || data.preparedAt is timestamp)
          && (!data.keys().hasAny(["committedAt"]) || data.committedAt is timestamp)
          && (!data.keys().hasAny(["rollbackStartedAt"]) || data.rollbackStartedAt is timestamp)
          && (!data.keys().hasAny(["rolledBackAt"]) || data.rolledBackAt is timestamp);
      }

      function validVaultImportJobCreate(data, uid, jobId) {
        return validVaultImportJob(data, uid, jobId)
          && data.status == "preparing"
          && data.remainingChunkCount == data.chunkCount
          && data.lastErrorCode == null
          && data.revision == 1
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && !data.keys().hasAny(["preparedAt", "committedAt", "rollbackStartedAt", "rolledBackAt"]);
      }

      function vaultImportPreparingToStaging(data) {
        return resource.data.status == "preparing"
          && data.status == "staging"
          && data.lastErrorCode == null
          && data.preparedAt == request.time
          && data.diff(resource.data).affectedKeys().hasOnly(["status", "revision", "preparedAt", "updatedAt"]);
      }

      function vaultImportStagingToCommitted(data) {
        return resource.data.status == "staging"
          && data.status == "committed"
          && data.lastErrorCode == null
          && data.committedAt == request.time
          && data.diff(resource.data).affectedKeys().hasOnly(["status", "revision", "committedAt", "updatedAt"]);
      }

      function vaultImportRollbackStart(data) {
        return resource.data.status in ["staging", "blocked"]
          && data.status == "rolling-back"
          && data.lastErrorCode == null
          && data.rollbackStartedAt == request.time
          && data.diff(resource.data).affectedKeys().hasOnly([
            "status", "lastErrorCode", "revision", "rollbackStartedAt", "updatedAt"
          ]);
      }

      function vaultImportRollbackBlocked(data) {
        return resource.data.status in ["staging", "rolling-back", "blocked"]
          && data.status == "blocked"
          && data.lastErrorCode != null
          && data.diff(resource.data).affectedKeys().hasOnly([
            "status", "lastErrorCode", "revision", "updatedAt"
          ]);
      }

      function vaultImportRolledBack(data) {
        return resource.data.status in ["preparing", "rolling-back"]
          && data.status == "rolled-back"
          && data.lastErrorCode == null
          && data.rolledBackAt == request.time
          && data.diff(resource.data).affectedKeys().hasOnly([
            "status", "lastErrorCode", "revision", "rolledBackAt", "updatedAt"
          ]);
      }

      function vaultImportTerminalChunkCleanup(data) {
        return resource.data.status in ["committed", "rolled-back"]
          && data.status == resource.data.status
          && data.lastErrorCode == resource.data.lastErrorCode
          && resource.data.remainingChunkCount > 0
          && data.remainingChunkCount == resource.data.remainingChunkCount - 1
          && data.diff(resource.data).affectedKeys().hasOnly([
            "remainingChunkCount", "revision", "updatedAt"
          ]);
      }

      function validVaultImportJobUpdate(data, uid, jobId) {
        return validVaultImportJob(data, uid, jobId)
          && resource.data.ownerUid == uid
          && data.ownerUid == resource.data.ownerUid
          && data.kind == resource.data.kind
          && data.version == resource.data.version
          && data.itemCount == resource.data.itemCount
          && data.entryCount == resource.data.entryCount
          && data.folderCount == resource.data.folderCount
          && data.rootFolderCount == resource.data.rootFolderCount
          && data.chunkCount == resource.data.chunkCount
          && data.wrappedKey == resource.data.wrappedKey
          && data.createdAt == resource.data.createdAt
          && data.revision == resource.data.revision + 1
          && data.updatedAt == request.time
          && (
            (
              resource.data.status != "committed"
              && resource.data.status != "rolled-back"
              && data.remainingChunkCount == resource.data.remainingChunkCount
              && (
                vaultImportPreparingToStaging(data)
                || vaultImportStagingToCommitted(data)
                || vaultImportRollbackStart(data)
                || vaultImportRollbackBlocked(data)
                || vaultImportRolledBack(data)
              )
            )
            || vaultImportTerminalChunkCleanup(data)
          );
      }

      function validVaultImportChunk(data, uid, jobId, chunkId) {
        let parent = get(vaultImportJobPath(uid, jobId)).data;
        return data.keys().hasAll([
            "ownerUid", "jobId", "ordinal", "itemCount", "encryptedManifest", "createdAt"
          ])
          && data.keys().hasOnly([
            "ownerUid", "jobId", "ordinal", "itemCount", "encryptedManifest", "createdAt"
          ])
          && validVaultImportJobId(jobId)
          && chunkId.matches("^chunk-[0-9]{3}$")
          && data.ownerUid == uid
          && data.jobId == jobId
          && exists(vaultImportJobPath(uid, jobId))
          && parent.ownerUid == uid
          && parent.status == "preparing"
          && data.ordinal is int
          && data.ordinal >= 0
          && data.ordinal < parent.chunkCount
          && data.itemCount is int
          && data.itemCount >= 1
          && data.itemCount <= 100
          && boundedEncryptedPayload(data.encryptedManifest, 200000)
          && data.createdAt == request.time;
      }

      allow get: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && (
          !exists(vaultImportJobPath(uid, jobId))
          || resource.data.ownerUid == uid
        );
      allow list: if activeSignedInUserHasNotes()
        && request.auth.uid == uid;
      allow create: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && validVaultImportJobCreate(request.resource.data, uid, jobId);
      allow update: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && validVaultImportJobUpdate(request.resource.data, uid, jobId);
      allow delete: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && resource.data.ownerUid == uid
        && resource.data.status in ["committed", "rolled-back"]
        && resource.data.remainingChunkCount == 0;

      match /chunks/{chunkId} {
        allow get, list: if activeSignedInUserHasNotes()
          && request.auth.uid == uid;
        allow create: if activeSignedInUserHasNotes()
          && request.auth.uid == uid
          && validVaultImportChunk(request.resource.data, uid, jobId, chunkId);
        allow delete: if activeSignedInUserHasNotes()
          && request.auth.uid == uid
          && exists(vaultImportJobPath(uid, jobId))
          && get(vaultImportJobPath(uid, jobId)).data.ownerUid == uid
          && get(vaultImportJobPath(uid, jobId)).data.status in ["committed", "rolled-back"]
          && resource.data.ordinal
            == get(vaultImportJobPath(uid, jobId)).data.remainingChunkCount - 1
          && existsAfter(vaultImportJobPath(uid, jobId))
          && getAfter(vaultImportJobPath(uid, jobId)).data.ownerUid == uid
          && getAfter(vaultImportJobPath(uid, jobId)).data.status
            == get(vaultImportJobPath(uid, jobId)).data.status
          && getAfter(vaultImportJobPath(uid, jobId)).data.remainingChunkCount
            == get(vaultImportJobPath(uid, jobId)).data.remainingChunkCount - 1;
      }
    }

    match /libraryItems/{itemId} {
      function noteAttachmentPath(noteId, attachmentId) {
        return /databases/$(database)/documents/notes/$(noteId)/attachments/$(attachmentId);
      }

      function encryptedLibraryPayload(payload) {
        return encryptedPayload(payload)
          && payload.cipherText.size() >= 24
          && payload.cipherText.size() <= 700000
          && payload.iv.size() == 16;
      }

      function validLibraryOptionalId(value) {
        return value == null
          || (
            value is string
            && value.matches("^[A-Za-z0-9_-]{1,180}$")
          );
      }

      function validLibraryUrlFingerprint(value) {
        return value == null
          || (
            value is string
            && value.matches("^[A-Za-z0-9_-]{43}$")
          );
      }

      function validLibraryWrappedKeys(data) {
        return data.wrappedKeys is map
          && data.wrappedKeys.keys().hasAll([data.ownerUid])
          && data.wrappedKeys.keys().hasOnly([data.ownerUid])
          && validLibraryWrappedKey(data.wrappedKeys[data.ownerUid]);
      }

      function validLibrarySourceBinding(data) {
        return (
            data.kind == "link"
            && data.urlFingerprint != null
            && data.sourceNoteId == null
            && data.sourceAttachmentId == null
            && data.captureSource != "attachment-ocr"
          )
          || (
            data.kind == "clip"
            && data.sourceNoteId == null
            && data.sourceAttachmentId == null
            && data.captureSource != "attachment-ocr"
          )
          || (
            data.kind == "attachment"
            && data.sourceNoteId != null
            && data.sourceAttachmentId != null
            && data.captureSource == "attachment-ocr"
          );
      }

      function validLibraryAttachmentSource(data) {
        return data.kind != "attachment"
          || (
            activeSignedInUserHasNotes()
            && exists(notePath(data.sourceNoteId))
            && exists(noteAttachmentPath(data.sourceNoteId, data.sourceAttachmentId))
            && get(notePath(data.sourceNoteId)).data.ownerUid == request.auth.uid
            && noteActive(get(notePath(data.sourceNoteId)).data)
            && !notePurged(get(notePath(data.sourceNoteId)).data)
            && get(noteAttachmentPath(data.sourceNoteId, data.sourceAttachmentId)).data.noteId == data.sourceNoteId
            && (
              !get(noteAttachmentPath(data.sourceNoteId, data.sourceAttachmentId)).data.keys().hasAny(["isReady"])
              || get(noteAttachmentPath(data.sourceNoteId, data.sourceAttachmentId)).data.isReady == true
            )
          );
      }

      function validLibraryItem(data) {
        return data.keys().hasAll([
            "ownerUid",
            "generationId",
            "kind",
            "status",
            "captureSource",
            "isFavorite",
            "encryptedContent",
            "urlFingerprint",
            "sourceNoteId",
            "sourceAttachmentId",
            "wrappedKeys",
            "revision",
            "lastMutationId",
            "reviewCount",
            "createdAt",
            "updatedAt",
            "lastOpenedAt",
            "lastReviewedAt"
          ])
          && data.keys().hasOnly([
            "ownerUid",
            "generationId",
            "kind",
            "status",
            "captureSource",
            "isFavorite",
            "encryptedContent",
            "urlFingerprint",
            "sourceNoteId",
            "sourceAttachmentId",
            "wrappedKeys",
            "revision",
            "lastMutationId",
            "reviewCount",
            "createdAt",
            "updatedAt",
            "lastOpenedAt",
            "lastReviewedAt"
          ])
          && data.ownerUid is string
          && data.ownerUid.size() > 0
          && data.ownerUid.size() <= 160
          && data.generationId is string
          && data.generationId.matches("^[A-Za-z0-9_-]{8,160}$")
          && data.kind in ["link", "clip", "attachment"]
          && data.status in ["inbox", "reading", "archived"]
          && data.captureSource in ["manual", "browser-extension", "bookmarklet", "attachment-ocr"]
          && data.isFavorite is bool
          && encryptedLibraryPayload(data.encryptedContent)
          && validLibraryUrlFingerprint(data.urlFingerprint)
          && validLibraryOptionalId(data.sourceNoteId)
          && validLibraryOptionalId(data.sourceAttachmentId)
          && validLibrarySourceBinding(data)
          && validLibraryWrappedKeys(data)
          && data.revision is int
          && data.revision >= 1
          && data.revision <= 999999999999
          && data.lastMutationId is string
          && data.lastMutationId.matches("^[A-Za-z0-9_-]{8,160}$")
          && data.reviewCount is int
          && data.reviewCount >= 0
          && data.reviewCount <= 999999999999
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && (data.lastOpenedAt == null || data.lastOpenedAt is timestamp)
          && (data.lastReviewedAt == null || data.lastReviewedAt is timestamp);
      }

      function validLibraryLastOpenedAtUpdate(data) {
        let affectedKeys = data.diff(resource.data).affectedKeys();
        return data.lastOpenedAt == request.time
          && affectedKeys.hasAll(["lastOpenedAt"])
          && affectedKeys.hasOnly(["lastOpenedAt"]);
      }

      function validLibraryRevisionUpdate(data) {
        return data.ownerUid == resource.data.ownerUid
          && data.generationId == resource.data.generationId
          && data.kind == resource.data.kind
          && data.captureSource == resource.data.captureSource
          && data.createdAt == resource.data.createdAt
          && data.wrappedKeys == resource.data.wrappedKeys
          && data.urlFingerprint == resource.data.urlFingerprint
          && data.sourceNoteId == resource.data.sourceNoteId
          && data.sourceAttachmentId == resource.data.sourceAttachmentId
          && data.revision == resource.data.revision + 1
          && data.lastMutationId != resource.data.lastMutationId
          && data.reviewCount >= resource.data.reviewCount
          && data.reviewCount <= resource.data.reviewCount + 1
          && (
            (
              data.reviewCount == resource.data.reviewCount
              && data.lastReviewedAt == resource.data.lastReviewedAt
            )
            || (
              data.reviewCount == resource.data.reviewCount + 1
              && data.lastReviewedAt == request.time
            )
          )
          && data.lastOpenedAt == resource.data.lastOpenedAt
          && data.updatedAt == request.time
          && data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "isFavorite",
            "encryptedContent",
            "revision",
            "lastMutationId",
            "reviewCount",
            "updatedAt",
            "lastReviewedAt"
          ]);
      }

      allow get: if activeSignedInUserHasFeature("library")
        && resource.data.ownerUid == request.auth.uid;
      allow list: if activeSignedInUserHasFeature("library")
        && resource.data.ownerUid == request.auth.uid
        && request.query.limit != null
        && request.query.limit <= 121;
      allow create: if activeSignedInUserHasFeature("library")
        && validLibraryItem(request.resource.data)
        && validLibraryAttachmentSource(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.revision == 1
        && request.resource.data.reviewCount == 0
        && request.resource.data.lastOpenedAt == null
        && request.resource.data.lastReviewedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if activeSignedInUserHasFeature("library")
        && resource.data.ownerUid == request.auth.uid
        && validLibraryItem(request.resource.data)
        && (
          validLibraryLastOpenedAtUpdate(request.resource.data)
          || validLibraryRevisionUpdate(request.resource.data)
        );
      allow delete: if activeSignedInUserHasFeature("library")
        && resource.data.ownerUid == request.auth.uid;
    }

    match /googleCalendarTaskSyncReceipts/{taskId} {
      function googleCalendarTaskSyncReceiptPath(taskId) {
        return /databases/$(database)/documents/googleCalendarTaskSyncReceipts/$(taskId);
      }

      function validGoogleCalendarTaskSyncReceipt(data, taskId, uid) {
        return data.keys().hasOnly([
            "ownerUid",
            "taskId",
            "connectionGeneration",
            "taskUpdatedAt",
            "syncedAt"
          ])
          && data.keys().hasAll([
            "ownerUid",
            "taskId",
            "connectionGeneration",
            "taskUpdatedAt",
            "syncedAt"
          ])
          && data.ownerUid == uid
          && data.taskId == taskId
          && data.taskId is string
          && data.taskId.matches("^[A-Za-z0-9_-]{1,128}$")
          && data.connectionGeneration is string
          && data.connectionGeneration.matches("^[A-Za-z0-9_-]{43}$")
          && data.taskUpdatedAt is timestamp
          && data.syncedAt is timestamp;
      }

      function googleCalendarTaskSyncReceiptMatchesRevision(taskData, taskUpdatedAt) {
        return (
            taskData.keys().hasAny(["calendarUpdatedAt"])
            && taskData.calendarUpdatedAt is timestamp
            && taskUpdatedAt == taskData.calendarUpdatedAt
          )
          || (
            !taskData.keys().hasAny(["calendarUpdatedAt"])
            && taskData.keys().hasAny(["createdAt"])
            && taskData.createdAt is timestamp
            && taskUpdatedAt == taskData.createdAt
          )
          || (
            !taskData.keys().hasAny(["calendarUpdatedAt"])
            && (
              !taskData.keys().hasAny(["createdAt"])
              || !(taskData.createdAt is timestamp)
            )
            && taskData.keys().hasAny(["updatedAt"])
            && taskData.updatedAt is timestamp
            && taskUpdatedAt == taskData.updatedAt
          );
      }

      allow get: if activeSignedInUserHasFeature("schedule")
        && (
          (
            exists(googleCalendarTaskSyncReceiptPath(taskId))
            && validGoogleCalendarTaskSyncReceipt(resource.data, taskId, request.auth.uid)
          )
          || (
            !exists(googleCalendarTaskSyncReceiptPath(taskId))
            && exists(scheduleTaskPath(taskId))
            && get(scheduleTaskPath(taskId)).data.ownerUid == request.auth.uid
          )
        );
      allow list: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid;
      allow create, update: if activeSignedInUserHasFeature("schedule")
        && validGoogleCalendarTaskSyncReceipt(request.resource.data, taskId, request.auth.uid)
        && request.resource.data.syncedAt == request.time
        && exists(scheduleTaskPath(taskId))
        && get(scheduleTaskPath(taskId)).data.ownerUid == request.auth.uid
        && googleCalendarTaskSyncReceiptMatchesRevision(
          get(scheduleTaskPath(taskId)).data,
          request.resource.data.taskUpdatedAt
        )
        && (
          !exists(googleCalendarTaskTombstonePath(taskId))
          || get(googleCalendarTaskTombstonePath(taskId)).data.leaseExpiresAt <= request.time
        )
        && currentGoogleCalendarConnectionGeneration(
          request.auth.uid,
          request.resource.data.connectionGeneration
        );
      allow delete: if activeSignedInUserHasFeature("schedule")
        && validGoogleCalendarTaskSyncReceipt(resource.data, taskId, request.auth.uid);
    }

    match /googleCalendarTaskTombstones/{taskId} {
      allow get: if activeSignedInUserHasFeature("schedule")
        && (
          (
            exists(googleCalendarTaskTombstonePath(taskId))
            && validGoogleCalendarTaskTombstone(resource.data, taskId, request.auth.uid)
          )
          || (
            !exists(googleCalendarTaskTombstonePath(taskId))
            && exists(scheduleTaskPath(taskId))
            && get(scheduleTaskPath(taskId)).data.ownerUid == request.auth.uid
          )
        );
      allow list: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid;
      allow create: if activeSignedInUserHasFeature("schedule")
        && validGoogleCalendarTaskTombstone(request.resource.data, taskId, request.auth.uid)
        && googleCalendarTaskTombstoneMatchesConnection(request.resource.data, request.auth.uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.leaseExpiresAt > request.time
        && request.resource.data.leaseExpiresAt <= request.time + duration.value(5, "m")
        && exists(scheduleTaskPath(taskId))
        && get(scheduleTaskPath(taskId)).data.ownerUid == request.auth.uid;
      allow update: if activeSignedInUserHasFeature("schedule")
        && validGoogleCalendarTaskTombstone(resource.data, taskId, request.auth.uid)
        && validGoogleCalendarTaskTombstone(request.resource.data, taskId, request.auth.uid)
        && googleCalendarTaskTombstoneMatchesConnection(request.resource.data, request.auth.uid)
        && resource.data.leaseExpiresAt <= request.time
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.deletionAttemptId != resource.data.deletionAttemptId
        && request.resource.data.createdAt == request.time
        && request.resource.data.leaseExpiresAt > request.time
        && request.resource.data.leaseExpiresAt <= request.time + duration.value(5, "m")
        && exists(scheduleTaskPath(taskId))
        && get(scheduleTaskPath(taskId)).data.ownerUid == request.auth.uid;
      allow delete: if activeSignedInUserHasFeature("schedule")
        && validGoogleCalendarTaskTombstone(resource.data, taskId, request.auth.uid);
    }

    match /scheduleTasks/{taskId} {
      function validScheduleTime(value) {
        return value == null || (value is int && value >= 0 && value <= 1439);
      }

      function validScheduleColor(data) {
        return !data.keys().hasAny(["color"])
          || data.color == null
          || (
            data.color is string
            && data.color.matches("^#[0-9A-Fa-f]{6}$")
          );
      }

      function validScheduleSortOrder(data) {
        return !data.keys().hasAny(["sortOrder"])
          || data.sortOrder == null
          || (
            data.sortOrder is int
            && data.sortOrder >= 0
          );
      }

      function validScheduleProgress(data) {
        return !data.keys().hasAny(["progressPercent"])
          || data.progressPercent == null
          || (
            data.progressPercent is int
            && data.progressPercent >= 0
            && data.progressPercent <= 100
          );
      }

      function scheduleStartDate(data) {
        return data.keys().hasAny(["startDate"]) ? data.startDate : data.dueDate;
      }

      function scheduleEndDate(data) {
        return data.keys().hasAny(["endDate"]) ? data.endDate : scheduleStartDate(data);
      }

      function scheduleStartTime(data) {
        return data.keys().hasAny(["startTimeMinutes"]) ? data.startTimeMinutes : data.dueTimeMinutes;
      }

      function scheduleEndTime(data) {
        return data.keys().hasAny(["endTimeMinutes"]) ? data.endTimeMinutes : null;
      }

      function scheduleDateYear(value) {
        return value.split("-")[0];
      }

      function validScheduleRangeLength(data) {
        return scheduleStartDate(data) == null
          || scheduleEndDate(data) == null
          || scheduleDateYear(scheduleStartDate(data)) == scheduleDateYear(scheduleEndDate(data));
      }

      function validScheduleDateRange(data) {
        return validScheduleDate(data.dueDate)
          && validScheduleDate(scheduleStartDate(data))
          && validScheduleDate(scheduleEndDate(data))
          && validScheduleRangeLength(data)
          && (
            scheduleStartDate(data) == null
            || scheduleEndDate(data) == null
            || scheduleEndDate(data) >= scheduleStartDate(data)
          )
          && (
            scheduleStartDate(data) == data.dueDate
            || (scheduleStartDate(data) == null && data.dueDate == null)
          );
      }

      function validScheduleTimeRange(data) {
        return validScheduleTime(data.dueTimeMinutes)
          && validScheduleTime(scheduleStartTime(data))
          && validScheduleTime(scheduleEndTime(data))
          && (
            scheduleStartTime(data) == data.dueTimeMinutes
            || (scheduleStartTime(data) == null && data.dueTimeMinutes == null)
          )
          && (
            scheduleEndTime(data) == null
            || (
              scheduleStartTime(data) != null
              && scheduleEndTime(data) >= scheduleStartTime(data)
            )
          );
      }

      function validScheduleCompletion(data) {
        return (
          data.status == "active"
          && data.completedAt == null
        )
        || (
          data.status == "completed"
          && data.completedAt is timestamp
          && data.completedAt <= request.time
        );
      }

      function validScheduleTask(data, uid) {
        // Every required field below is read and type-checked. Keeping a second
        // hasAll list would duplicate those checks and can exhaust Firestore's
        // per-request expression budget on guarded updates.
        return data.keys().hasOnly([
          "ownerUid",
          "status",
          "dueDate",
          "dueTimeMinutes",
          "startDate",
          "endDate",
          "startTimeMinutes",
          "endTimeMinutes",
          "color",
          "sortOrder",
          "progressPercent",
          "isImportant",
          "isUrgent",
          "encryptedTitle",
          "encryptedCategory",
          "encryptedDetails",
          "wrappedKeys",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt",
          "calendarUpdatedAt",
          "completedAt"
        ])
        && data.ownerUid == uid
        && data.status in ["active", "completed"]
        && validScheduleDateRange(data)
        && validScheduleTimeRange(data)
        && validScheduleColor(data)
        && validScheduleSortOrder(data)
        && validScheduleProgress(data)
        && data.isImportant is bool
        && data.isUrgent is bool
        && encryptedSchedulePayload(data.encryptedTitle, 4096)
        && encryptedSchedulePayload(data.encryptedDetails, 50000)
        && validScheduleWrappedKeys(data, uid)
        && data.createdBy == uid
        && data.updatedBy == uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.get("calendarUpdatedAt", request.time) is timestamp
        && validScheduleCompletion(data);
      }

      function validScheduleUpdateFields() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let projectedFieldsChanged = affectedKeys.hasAny([
          "encryptedTitle",
          "dueDate",
          "dueTimeMinutes",
          "startDate",
          "endDate",
          "startTimeMinutes",
          "endTimeMinutes"
        ]);
        let calendarRevisionChanged = affectedKeys.hasAny(["calendarUpdatedAt"]);

        return affectedKeys.hasOnly([
            "status",
            "dueDate",
            "dueTimeMinutes",
            "startDate",
            "endDate",
            "startTimeMinutes",
            "endTimeMinutes",
            "color",
            "sortOrder",
            "progressPercent",
            "isImportant",
            "isUrgent",
            "encryptedTitle",
            "encryptedCategory",
            "encryptedDetails",
            "updatedBy",
            "updatedAt",
            "calendarUpdatedAt",
            "completedAt"
          ])
          && projectedFieldsChanged == calendarRevisionChanged
          && (
            !calendarRevisionChanged
            || request.resource.data.calendarUpdatedAt == request.time
          );
      }

      allow read: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid;
      allow create: if activeSignedInUserHasFeature("schedule")
        && validScheduleTask(request.resource.data, request.auth.uid)
        && request.resource.data.status == "active"
        && request.resource.data.completedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid
        && (
          !exists(googleCalendarTaskTombstonePath(taskId))
          || (
            validGoogleCalendarTaskTombstone(
              get(googleCalendarTaskTombstonePath(taskId)).data,
              taskId,
              request.auth.uid
            )
            && get(googleCalendarTaskTombstonePath(taskId)).data.leaseExpiresAt <= request.time
          )
        )
        && validScheduleTask(request.resource.data, request.auth.uid)
        && request.resource.data.updatedAt == request.time
        && validScheduleUpdateFields();
      allow delete: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid
        && exists(googleCalendarTaskTombstonePath(taskId))
        && validGoogleCalendarTaskTombstone(
          get(googleCalendarTaskTombstonePath(taskId)).data,
          taskId,
          request.auth.uid
        )
        && googleCalendarTaskTombstoneMatchesConnection(
          get(googleCalendarTaskTombstonePath(taskId)).data,
          request.auth.uid
        )
        && get(googleCalendarTaskTombstonePath(taskId)).data.leaseExpiresAt > request.time;
    }

    match /recurringHabits/{habitId} {
      function validRecurringHabitColor(value) {
        return value is string
          && value.matches("^#[0-9A-Fa-f]{6}$");
      }

      function validRecurringHabitSortOrder(data) {
        return !data.keys().hasAny(["sortOrder"])
          || data.sortOrder == null
          || (
            data.sortOrder is int
            && data.sortOrder >= 0
            && data.sortOrder <= 1000000
          );
      }

      function validRecurringHabit(data, uid) {
        return data.keys().hasAll([
          "ownerUid",
          "status",
          "slot",
          "icon",
          "color",
          "encryptedTitle",
          "encryptedDetails",
          "wrappedKeys",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "ownerUid",
          "status",
          "slot",
          "icon",
          "color",
          "sortOrder",
          "encryptedTitle",
          "encryptedDetails",
          "wrappedKeys",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.ownerUid == uid
        && data.status in ["active", "archived"]
        && data.slot in ["morning", "afternoon", "other"]
        && data.icon in ["work", "study", "reading", "exercise", "health", "cleanup", "review", "other"]
        && validRecurringHabitColor(data.color)
        && validRecurringHabitSortOrder(data)
        && encryptedSchedulePayload(data.encryptedTitle, 4096)
        && encryptedSchedulePayload(data.encryptedDetails, 12000)
        && validScheduleWrappedKeys(data, uid)
        && data.createdBy == uid
        && data.updatedBy == uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
      }

      allow read: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid;
      allow create: if activeSignedInUserHasFeature("schedule")
        && validRecurringHabit(request.resource.data, request.auth.uid)
        && request.resource.data.status == "active"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid
        && validRecurringHabit(request.resource.data, request.auth.uid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.wrappedKeys == resource.data.wrappedKeys
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && resource.data.status == "active"
        && request.resource.data.status in ["active", "archived"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "slot",
          "icon",
          "color",
          "sortOrder",
          "encryptedTitle",
          "encryptedDetails",
          "updatedBy",
          "updatedAt"
        ]);
      allow delete: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == "archived";
    }

    match /recurringHabitCheckIns/{checkInId} {
      function recurringHabitBelongsToOwner(habitId, uid) {
        return exists(/databases/$(database)/documents/recurringHabits/$(habitId))
          && get(/databases/$(database)/documents/recurringHabits/$(habitId)).data.ownerUid == uid
          && get(/databases/$(database)/documents/recurringHabits/$(habitId)).data.status == "active";
      }

      function recurringHabitCheckInTargetBelongsToOwner(checkInId, uid) {
        let separatorIndex = checkInId.size() - 11;
        return checkInId.size() > 11
          && checkInId[separatorIndex] == "_"
          && validScheduleDate(checkInId[separatorIndex + 1:checkInId.size()])
          && recurringHabitBelongsToOwner(checkInId[0:separatorIndex], uid);
      }

      function validRecurringHabitCheckInProgress(data) {
        return !data.keys().hasAny(["progressPercent"])
          || data.progressPercent == null
          || (
            data.progressPercent is int
            && data.progressPercent >= 0
            && data.progressPercent <= 100
          );
      }

      function validRecurringHabitCheckedItemIds(data) {
        return !data.keys().hasAny(["checkedItemIds"])
          || (
            data.checkedItemIds is list
            && data.checkedItemIds.size() <= 100
          );
      }

      function validRecurringHabitCheckIn(data, uid, checkInId) {
        return data.keys().hasAll([
          "ownerUid",
          "habitId",
          "date",
          "completed",
          "progressPercent",
          "checkedItemIds",
          "checkedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "ownerUid",
          "habitId",
          "date",
          "completed",
          "progressPercent",
          "checkedItemIds",
          "checkedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.ownerUid == uid
        && data.habitId is string
        && data.habitId.size() > 0
        && data.habitId.size() <= 128
        && validScheduleDate(data.date)
        && data.date != null
        && checkInId == data.habitId + "_" + data.date
        && data.completed is bool
        && data.progressPercent is int
        && validRecurringHabitCheckInProgress(data)
        && validRecurringHabitCheckedItemIds(data)
        && (
          (
            data.completed == false
            && data.progressPercent < 100
            && data.checkedAt == null
          )
          || (
            data.completed == true
            && data.progressPercent == 100
            && data.checkedAt is timestamp
            && data.checkedAt <= request.time
          )
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && recurringHabitBelongsToOwner(data.habitId, uid);
      }

      // Browser SDK folder writes exist only for pre-cutover TipTap accounts.
      // Encrypted Vault folders are mutated by the authenticated Vercel boundary
      // and never by client Rules, so this validator intentionally accepts only
      // the five-field legacy shape plus server timestamps.
      allow get: if activeSignedInUserHasFeature("schedule")
        && (
          (
            exists(/databases/$(database)/documents/recurringHabitCheckIns/$(checkInId))
            && resource.data.ownerUid == request.auth.uid
          )
          || (
            !exists(/databases/$(database)/documents/recurringHabitCheckIns/$(checkInId))
            && recurringHabitCheckInTargetBelongsToOwner(checkInId, request.auth.uid)
          )
        );
      allow list: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid;
      allow create: if activeSignedInUserHasFeature("schedule")
        && validRecurringHabitCheckIn(request.resource.data, request.auth.uid, checkInId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid
        && validRecurringHabitCheckIn(request.resource.data, request.auth.uid, checkInId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.habitId == resource.data.habitId
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "completed",
          "progressPercent",
          "checkedItemIds",
          "checkedAt",
          "updatedAt"
        ]);
      allow delete: if activeSignedInUserHasFeature("schedule")
        && resource.data.ownerUid == request.auth.uid;
    }

    match /noteFolders/{folderId} {
      function validLegacyNoteFolder(data, folderId) {
        return data.keys().hasOnly([
            "ownerUid",
            "name",
            "color",
            "createdAt",
            "updatedAt"
          ])
          && data.keys().hasAll([
            "ownerUid",
            "name",
            "color",
            "createdAt",
            "updatedAt"
          ])
          && folderId.matches("^[A-Za-z0-9_-]{1,120}$")
          && data.ownerUid == request.auth.uid
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 40
          && data.color is string
          && data.color.size() > 0
          && data.color.size() <= 24
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }


      allow read: if activeSignedInUserHasNotes()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if activeSignedInUserHasNotes()
        && !existsAfter(vaultIntegrityPath(request.auth.uid))
        && validLegacyNoteFolder(request.resource.data, folderId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if activeSignedInUserHasNotes()
        && resource.data.ownerUid == request.auth.uid
        && !existsAfter(vaultIntegrityPath(request.auth.uid))
        && validLegacyNoteFolder(resource.data, folderId)
        && validLegacyNoteFolder(request.resource.data, folderId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "name",
          "color",
          "updatedAt"
        ]);
      allow delete: if activeSignedInUserHasNotes()
        && resource.data.ownerUid == request.auth.uid
        && !existsAfter(vaultIntegrityPath(request.auth.uid))
        && !resource.data.keys().hasAny(["encryptedName", "wrappedKey", "parentId", "order", "revision"]);
    }

    match /quickLoginKeys/{quickKey} {
      function validQuickLoginKey(data, uid) {
        return data.keys().hasOnly(["uid", "quickKey", "createdAt", "updatedAt"])
        && data.uid == uid
        && data.quickKey is int
        && data.quickKey >= 1
        && data.quickKey <= 99;
      }

      allow read: if adminUser();
      allow create: if validQuickLoginKey(request.resource.data, request.resource.data.uid)
        && (firstAdminCreate(request.resource.data.uid) || adminCreatesUser(request.resource.data.uid));
      allow update: if adminUser()
        && validQuickLoginKey(request.resource.data, request.resource.data.uid)
        && resource.data.uid == request.resource.data.uid;
      allow delete: if adminUser();
    }

    match /system/bootstrap {
      allow read: if adminUser();
      allow create: if signedIn()
        && !exists(bootstrapPath())
        && request.resource.data.keys().hasOnly(["adminUid", "createdAt"])
        && request.resource.data.adminUid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.isAdmin == true
        && getAfter(userPath(request.auth.uid)).data.isActive == true;
    }

    match /system/bootstrapAttempts/attempts/{uid} {
      allow create: if validBootstrapAttempt(request.resource.data, uid)
        && firstAdminCreate(uid);
    }

    match /notes/{noteId} {
      function noteHistoryPath(noteId, historyId) {
        return /databases/$(database)/documents/notes/$(noteId)/history/$(historyId);
      }

      function notePurgeCleanupQueuePath(noteId) {
        return /databases/$(database)/documents/notePurgeCleanupQueue/$(noteId);
      }

      function noteFolderPath(folderId) {
        return /databases/$(database)/documents/noteFolders/$(folderId);
      }

      function vaultFolderTreePath(uid) {
        return /databases/$(database)/documents/vaultFolderTrees/$(uid);
      }

      function validNote(data) {
        return data.keys().hasOnly([
          "type",
          "ownerUid",
          "participantUids",
          "encryptedTitle",
          "encryptedBody",
          "contentFormat",
          "entryKind",
          "vaultNameClaimId",
          "vaultNameIndexVersion",
          "vaultImportJobId",
          "wrappedKeys",
          "folderId",
          "createdAt",
          "dueAt",
          "updatedAt",
          "updatedBy",
          "savedAt",
          "revision",
          "lastMutationId",
          "attachmentRevision",
          "secureShareCopyState",
          "secureShareCopyJobId",
          "secureShareCopyExpectedAttachmentCount",
          "secureShareCopyReservedAttachmentCount",
          "secureShareCopyReadyAttachmentCount",
          "secureShareCopyStartedAt",
          "secureShareCopyUpdatedAt",
          "secureShareCopyFinishedAt",
          "secureShareCopyCleanupClaimId",
          "secureShareCopyCleanupClaimedAt",
          "isDeleted",
          "deletedAt",
          "deletedBy",
          "isPurged",
          "purgedAt",
          "purgedBy"
        ])
        && validUpdatedNote(data);
      }

      // Update branches already constrain affected keys, so revalidate values
      // without re-counting the full create-only allowlist on every mutation.
      function validUpdatedNote(data) {
        return data.type in ["personal", "shared"]
        && data.ownerUid is string
        && data.participantUids is list
        && data.participantUids.size() > 0
        && ((data.type == "personal" && data.participantUids.size() == 1) || (data.type == "shared" && data.participantUids.size() > 1))
        && encryptedPayload(data.encryptedTitle)
        && encryptedPayload(data.encryptedBody)
        && data.wrappedKeys is map
        && validNoteFolderReference(data)
        && (!data.keys().hasAny(["createdAt"]) || data.createdAt is timestamp)
        && (!data.keys().hasAny(["dueAt"]) || data.dueAt == null || data.dueAt is timestamp)
        && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp)
        && (!data.keys().hasAny(["savedAt"]) || data.savedAt is timestamp)
        && data.updatedBy is string
        && validNoteRevision(data)
        && validNoteAttachmentRevision(data)
        && validDeleteMetadata(data)
        && validPurgeMetadata(data);
      }

      function validNoteAccessProjection(data) {
        return data.type in ["personal", "shared"]
          && data.participantUids is list
          && data.participantUids.size() > 0
          && (
            (data.type == "personal" && data.participantUids.size() == 1)
            || (data.type == "shared" && data.participantUids.size() > 1)
          )
          && data.wrappedKeys is map
          && validNoteFolderReference(data);
      }

      // Content mutations cannot alter ownership, participants, wrapped keys,
      // deletion/purge state, or attachment metadata. Revalidate the encrypted
      // payloads and optional folder reference that this branch can change.
      function validNoteContentProjection(data) {
        return encryptedPayload(data.encryptedTitle)
          && encryptedPayload(data.encryptedBody)
          && validNoteFolderReference(data);
      }

      function validVaultNameClaimId(value) {
        return value is string && value.matches("^[A-Za-z0-9_-]{43}$");
      }

      function validVaultNameReservationFields(data) {
        return data.keys().hasAll(["vaultNameClaimId", "vaultNameIndexVersion"])
          && validVaultNameClaimId(data.vaultNameClaimId)
          && data.vaultNameIndexVersion == 1;
      }

      function vaultCutoverCreateHasNameReservation(data) {
        // Marker activation is a separate transaction. Treat a marker created in
        // this same request as active so a client cannot smuggle unclaimed legacy
        // or versioned entries through the pre-cutover create branch.
        return existsAfter(vaultIntegrityPath(data.ownerUid))
          ? validVaultNameReservationFields(data)
          : true;
      }

      function vaultCutoverNoteNameMutationIsClaimAware(data) {
        return resource.data.keys().hasAny(["vaultNameClaimId"])
          ? (
            data.encryptedTitle == resource.data.encryptedTitle
            && noteFolderId(data) == noteFolderId(resource.data)
            && data.type == resource.data.type
            ? true
            : data.vaultNameClaimId != resource.data.vaultNameClaimId
          )
          : true;
      }

      // Historical TipTap notes share the same collection and already sit close
      // to the Firestore Rules expression budget. Apply the stricter create and
      // content-update byte budget only to explicitly versioned Vault entries;
      // the revisioned client service mirrors the same limit before each write.
      // Adding this expansion to all legacy mutation branches exceeds Rules'
      // 1000-expression ceiling, so legacy paths retain structural validation.
      function validVaultEntryPayloadSize(data) {
        return !data.keys().hasAny(["contentFormat", "entryKind"])
          || (
            data.encryptedTitle.cipherText.size() > 0
            && data.encryptedTitle.cipherText.size() <= 4096
            && data.encryptedTitle.iv.size() > 0
            && data.encryptedTitle.iv.size() <= 256
            && data.encryptedBody.cipherText.size() > 0
            && data.encryptedBody.cipherText.size() <= 700000
            && data.encryptedBody.iv.size() > 0
            && data.encryptedBody.iv.size() <= 256
          );
      }

      function secureShareCopyCreate(data) {
        return data.keys().hasAll([
            "secureShareCopyState",
            "secureShareCopyJobId",
            "secureShareCopyExpectedAttachmentCount",
            "secureShareCopyReservedAttachmentCount",
            "secureShareCopyReadyAttachmentCount",
            "secureShareCopyStartedAt",
            "secureShareCopyUpdatedAt"
          ])
          && !data.keys().hasAny([
            "secureShareCopyFinishedAt",
            "secureShareCopyCleanupClaimId",
            "secureShareCopyCleanupClaimedAt"
          ])
          && data.type == "personal"
          && data.participantUids == [data.ownerUid]
          && data.secureShareCopyState == "copying"
          && data.secureShareCopyJobId is string
          && data.secureShareCopyJobId.matches("^[A-Za-z0-9_-]{16,160}$")
          && data.secureShareCopyExpectedAttachmentCount is int
          && data.secureShareCopyExpectedAttachmentCount >= 0
          && data.secureShareCopyExpectedAttachmentCount <= 100
          && data.secureShareCopyReservedAttachmentCount == 0
          && data.secureShareCopyReadyAttachmentCount == 0
          && data.secureShareCopyStartedAt == request.time
          && data.secureShareCopyUpdatedAt == request.time;
      }

      function secureShareCopyStateChangeRequested() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "secureShareCopyState",
          "secureShareCopyFinishedAt"
        ]);
      }

      function validNoteAttachmentRevision(data) {
        return !data.keys().hasAny(["attachmentRevision"])
          || (
            data.attachmentRevision is int
            && data.attachmentRevision >= 0
            && data.attachmentRevision <= 999999999999
          );
      }

      function validNoteRevision(data) {
        return (
            !data.keys().hasAny(["revision", "lastMutationId"])
          )
          || (
            data.keys().hasAll(["revision", "lastMutationId"])
            && data.revision is int
            && data.revision >= 1
            && data.revision <= 999999999999
            && data.lastMutationId is string
            && data.lastMutationId.matches("^[A-Za-z0-9_-]{8,160}$")
          );
      }

      function noteRevisionIsPreserved(data) {
        return (
            !resource.data.keys().hasAny(["revision", "lastMutationId"])
            && !data.keys().hasAny(["revision", "lastMutationId"])
          )
          || (
            resource.data.keys().hasAll(["revision", "lastMutationId"])
            && data.revision == resource.data.revision
            && data.lastMutationId == resource.data.lastMutationId
          );
      }

      function noteRevisionAdvances(data) {
        return data.keys().hasAll(["revision", "lastMutationId"])
          && (
            (
              !resource.data.keys().hasAny(["revision", "lastMutationId"])
              && data.revision == 1
            )
            || (
              resource.data.keys().hasAll(["revision", "lastMutationId"])
              && data.revision == resource.data.revision + 1
              && data.lastMutationId != resource.data.lastMutationId
            )
          );
      }

      function validNoteFolderReference(data) {
        return !data.keys().hasAny(["folderId"])
          || data.folderId == null
          || (
            data.type == "personal"
            && data.folderId is string
            && data.folderId.size() > 0
            && data.folderId.size() <= 120
          );
      }

      function encryptedVaultFolder(data) {
        return data.keys().hasAll([
          "encryptedName",
          "wrappedKey",
          "parentId",
          "order",
          "revision"
        ]);
      }

      // The complete opaque tree is written only by the authenticated Vercel
      // mutation boundary. Rules use one document lookup regardless of nesting
      // depth and never accept client-supplied ancestorIds as authority.
      function authoritativeVaultFolderActive(uid, folderId) {
        let node = get(vaultFolderTreePath(uid)).data.nodes[folderId];
        // The central document is not readable or writable by any client, and
        // the API validates its complete schema before every server transaction.
        // Keep this hot-path projection minimal so large note batches remain
        // below Firestore's 1,000-expression ceiling.
        return node.active == true;
      }

      function validAssignedFolder(data) {
        return !data.keys().hasAny(["folderId"])
          || data.folderId == null
          || validAssignedFolderDocument(data, data.folderId);
      }

      function validAssignedFolderDocument(data, folderId) {
        let folder = get(noteFolderPath(folderId)).data;
        return exists(noteFolderPath(folderId))
          && folder.ownerUid == data.ownerUid
          && folderActive(folder)
          && (
            !encryptedVaultFolder(folder)
            || authoritativeVaultFolderActive(data.ownerUid, folderId)
          )
          && vaultImportFolderDocumentPlacementAllowed(data, folder);
      }

      function vaultImportFolderDocumentPlacementAllowed(data, folder) {
        return !folder.keys().hasAny(["vaultImportJobId"])
          || (
            data.keys().hasAny(["vaultImportJobId"])
            && data.vaultImportJobId == folder.vaultImportJobId
          )
          || !existsAfter(vaultImportJobPath(folder.ownerUid, folder.vaultImportJobId))
          || vaultImportExistingFolderPlacementAllowed(folder);
      }

      function vaultImportExistingFolderPlacementAllowed(folder) {
        let job = getAfter(vaultImportJobPath(folder.ownerUid, folder.vaultImportJobId)).data;
        return job.ownerUid == folder.ownerUid && job.status == "committed";
      }

      // Imported targets stay immutable until their durable job is committed.
      // During rollback, the normal note mutation validators still verify the
      // complete revision/history/name-claim tombstone transaction; this helper
      // only opens that exact mutation shape and keeps edits/moves locked.
      function vaultImportNoteUpdateAllowed(data) {
        return !resource.data.keys().hasAny(["vaultImportJobId"])
          || !existsAfter(vaultImportJobPath(resource.data.ownerUid, resource.data.vaultImportJobId))
          || vaultImportExistingJobNoteUpdateAllowed(data);
      }

      function vaultImportExistingJobNoteUpdateAllowed(data) {
        let job = getAfter(vaultImportJobPath(resource.data.ownerUid, resource.data.vaultImportJobId)).data;
        return job.ownerUid == resource.data.ownerUid
          && (
            job.status == "committed"
            || (
              job.status == "rolling-back"
              && data.keys().hasAny(["vaultImportJobId"])
              && data.vaultImportJobId == resource.data.vaultImportJobId
              && data.isDeleted == true
              && request.resource.data.diff(resource.data).affectedKeys().hasAny(["isDeleted"])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "isDeleted", "deletedAt", "deletedBy", "updatedAt", "updatedBy",
                "revision", "lastMutationId"
              ])
            )
          );
      }

      function validDeleteMetadata(data) {
        return legacyActiveDeleteMetadata(data)
          || (
            data.keys().hasAny(["isDeleted"])
            && data.isDeleted == false
            && !data.keys().hasAny(["deletedAt", "deletedBy"])
          )
          || (
            data.keys().hasAll(["isDeleted", "deletedAt", "deletedBy"])
            && data.isDeleted == true
            && data.deletedAt is timestamp
            && data.deletedBy is string
            && data.deletedBy.size() > 0
          )
          || (
            data.keys().hasAll(["isDeleted", "isPurged", "purgedAt", "purgedBy"])
            && data.isDeleted == true
            && data.isPurged == true
            && !data.keys().hasAny(["deletedAt", "deletedBy"])
          );
      }

      function noteFolderId(data) {
        return data.keys().hasAny(["folderId"]) ? data.folderId : null;
      }

      function validPurgeMetadata(data) {
        return !data.keys().hasAny(["isPurged", "purgedAt", "purgedBy"])
          || (
            data.keys().hasAll(["isPurged", "purgedAt", "purgedBy"])
            && data.keys().hasAny(["isDeleted"])
            && data.isDeleted == true
            && data.isPurged == true
            && data.purgedAt is timestamp
            && data.purgedBy is string
            && data.purgedBy.size() > 0
          );
      }

      function vaultEntryNameClaimMatchesTargetAfter(noteId, data) {
        let claimId = data.vaultNameClaimId;
        let claim = getAfter(vaultNameClaimPath(data.ownerUid, claimId)).data;
        return existsAfter(vaultNameClaimPath(data.ownerUid, claimId))
          ? (
            claim.ownerUid == data.ownerUid
            && claim.indexVersion == 1
            && claim.targetId == noteId
            && claim.targetType == "entry"
            && claim.parentId == noteFolderId(data)
          )
          : false;
      }

      function vaultEntryNameReservationStateMatchesAfter(noteId, data) {
        return existsAfter(vaultIntegrityPath(data.ownerUid))
          ? (
            validVaultNameReservationFields(data)
            && (
              noteDeleted(data)
              ? !existsAfter(vaultNameClaimPath(data.ownerUid, data.vaultNameClaimId))
              : vaultEntryNameClaimMatchesTargetAfter(noteId, data)
            )
          )
          : true;
      }




      function vaultEntryNameClaimReleasedAfterDelete(data) {
        return !data.keys().hasAny(["vaultNameClaimId"])
          || !existsAfter(vaultNameClaimPath(data.ownerUid, data.vaultNameClaimId));
      }

      function vaultEntryNameClaimPresentAfterRestore(data) {
        return !data.keys().hasAny(["vaultNameClaimId"])
          || existsAfter(vaultNameClaimPath(data.ownerUid, data.vaultNameClaimId));
      }

      function folderActive(data) {
        return !data.keys().hasAny(["isDeleted"]) || data.isDeleted == false;
      }

      function validNoteHistory(data, noteId) {
        return data.keys().hasAll(["noteId", "actorUid", "action", "changedFields", "readerUids", "revision", "createdAt"])
          && data.keys().hasOnly(["noteId", "actorUid", "action", "changedFields", "readerUids", "revision", "encryptedSummary", "encryptedSnapshot", "createdAt"])
          && data.noteId == noteId
          && data.actorUid == request.auth.uid
          && data.action in ["create", "content", "share", "delete", "restore"]
          && data.changedFields is list
          && data.changedFields.size() > 0
          && data.changedFields.size() <= 8
          && data.changedFields.hasOnly(["title", "body", "participants", "folder", "name-claim", "deleted", "restored"])
          && data.readerUids is list
          && data.readerUids.size() > 0
          && data.readerUids.size() <= 200
          && data.revision is int
          && data.revision >= 1
          && data.revision <= 999999999999
          && (!data.keys().hasAny(["encryptedSummary"]) || boundedEncryptedPayload(data.encryptedSummary, 8192))
          && (!data.keys().hasAny(["encryptedSnapshot"]) || boundedEncryptedPayload(data.encryptedSnapshot, 700000))
          && data.createdAt == request.time;
      }

      function canReadNoteHistory(data, noteData) {
        return canReadNoteDocument(noteData)
          && (
            request.auth.uid == noteData.ownerUid
            || request.auth.uid in data.readerUids
          );
      }

      function linkedNoteUpdate(noteId, historyId, data) {
        let nextNote = getAfter(notePath(noteId)).data;
        return exists(notePath(noteId))
          && existsAfter(notePath(noteId))
          && nextNote.updatedBy == request.auth.uid
          && nextNote.updatedAt == request.time
          && nextNote.revision == data.revision
          && nextNote.lastMutationId == historyId;
      }

      function createHistoryMatchesNote(data, noteId, historyId) {
        let nextNote = getAfter(notePath(noteId)).data;
        return data.action == "create"
          && !exists(notePath(noteId))
          && existsAfter(notePath(noteId))
          && nextNote.ownerUid == request.auth.uid
          && nextNote.updatedBy == request.auth.uid
          && nextNote.createdAt == request.time
          && nextNote.updatedAt == request.time
          && nextNote.savedAt == request.time
          && nextNote.revision == 1
          && nextNote.revision == data.revision
          && nextNote.lastMutationId == historyId
          && nextNote.isDeleted == false
          && data.changedFields.hasOnly(["title", "body"]);
      }

      function contentHistoryMatchesNote(data, noteId, historyId) {
        let previousNote = get(notePath(noteId)).data;
        let nextNote = getAfter(notePath(noteId)).data;
        return data.action == "content"
          && linkedNoteUpdate(noteId, historyId, data)
          && !noteDeleted(previousNote)
          && !noteDeleted(nextNote)
          && data.changedFields.hasOnly(["title", "body", "folder", "name-claim"])
          && nextNote.type == previousNote.type
          && nextNote.participantUids == previousNote.participantUids
          && nextNote.wrappedKeys == previousNote.wrappedKeys
          && (
            request.auth.uid == previousNote.ownerUid
            || (
              nextNote.encryptedTitle == previousNote.encryptedTitle
              && noteFolderId(nextNote) == noteFolderId(previousNote)
              && data.changedFields.hasOnly(["body"])
              && data.changedFields.hasAny(["body"])
            )
          )
          && (
            (
              noteFolderId(nextNote) == noteFolderId(previousNote)
              && data.changedFields.hasOnly(["title", "body", "name-claim"])
              && (
                nextNote.encryptedTitle != previousNote.encryptedTitle
                || nextNote.encryptedBody != previousNote.encryptedBody
                || data.changedFields.hasAny(["name-claim"])
              )
            )
            || (
              request.auth.uid == previousNote.ownerUid
              && previousNote.type == "personal"
              && data.changedFields.hasAny(["folder"])
              && noteFolderId(nextNote) != noteFolderId(previousNote)
              && (
                nextNote.encryptedTitle == previousNote.encryptedTitle
                || data.changedFields.hasAny(["title"])
              )
              && (
                nextNote.encryptedBody == previousNote.encryptedBody
                || data.changedFields.hasAny(["body"])
              )
            )
          );
      }

      function shareHistoryMatchesNote(data, noteId, historyId) {
        return data.action == "share"
          && linkedNoteUpdate(noteId, historyId, data)
          && request.auth.uid == get(notePath(noteId)).data.ownerUid
          && !noteDeleted(get(notePath(noteId)).data)
          && !noteDeleted(getAfter(notePath(noteId)).data)
          && data.changedFields.hasOnly(["participants", "folder", "name-claim"])
          && (
            data.changedFields.hasAny(["folder"])
            == (
              noteFolderId(getAfter(notePath(noteId)).data)
              != noteFolderId(get(notePath(noteId)).data)
            )
          )
          && (
            data.changedFields.hasAny(["participants"])
            == (
              getAfter(notePath(noteId)).data.type != get(notePath(noteId)).data.type
              || getAfter(notePath(noteId)).data.participantUids != get(notePath(noteId)).data.participantUids
              || getAfter(notePath(noteId)).data.wrappedKeys != get(notePath(noteId)).data.wrappedKeys
            )
          )
          && getAfter(notePath(noteId)).data.encryptedTitle == get(notePath(noteId)).data.encryptedTitle
          && getAfter(notePath(noteId)).data.encryptedBody == get(notePath(noteId)).data.encryptedBody;
      }

      function deleteHistoryMatchesNote(data, noteId, historyId) {
        return data.action == "delete"
          && linkedNoteUpdate(noteId, historyId, data)
          && !noteDeleted(get(notePath(noteId)).data)
          && noteDeleted(getAfter(notePath(noteId)).data)
          && getAfter(notePath(noteId)).data.deletedBy == request.auth.uid
          && data.changedFields.hasOnly(["deleted"]);
      }

      function restoreHistoryMatchesNote(data, noteId, historyId) {
        return data.action == "restore"
          && linkedNoteUpdate(noteId, historyId, data)
          && noteDeleted(get(notePath(noteId)).data)
          && !noteDeleted(getAfter(notePath(noteId)).data)
          && data.changedFields.hasOnly(["restored"]);
      }

      function historyMatchesNoteMutation(data, noteId, historyId) {
        let nextNote = getAfter(notePath(noteId)).data;
        return existsAfter(notePath(noteId))
          && data.readerUids == nextNote.participantUids
          && (
            createHistoryMatchesNote(data, noteId, historyId)
            || contentHistoryMatchesNote(data, noteId, historyId)
            || shareHistoryMatchesNote(data, noteId, historyId)
            || deleteHistoryMatchesNote(data, noteId, historyId)
            || restoreHistoryMatchesNote(data, noteId, historyId)
          );
      }

      // A cutover backfill changes only blinded reservation metadata and its
      // ordinary revision/history envelope. Keeping a narrow branch avoids
      // evaluating every historical mutation variant in the same three-write
      // atomic batch, which otherwise exceeds Firestore's 1000-expression cap.



      // A collision loser has no old reservation to release. It may recover in
      // one atomic transaction only by changing its encrypted title or parent,
      // acquiring the new claim, and writing matching revision history.


      function pairedNoteHistoryCreated(noteId, data) {
        let history = getAfter(noteHistoryPath(noteId, data.lastMutationId)).data;
        return data.keys().hasAll(["revision", "lastMutationId"])
          && !exists(noteHistoryPath(noteId, data.lastMutationId))
          && existsAfter(noteHistoryPath(noteId, data.lastMutationId))
          && history.revision == data.revision
          && history.actorUid == request.auth.uid;
      }



      // Deleted versioned entries that predate the blinded-name cutover have no
      // claim to reacquire. The owner may restore one only by creating the claim
      // in the same transaction; encrypted content, storage identity, folder and
      // sharing state stay byte-for-byte unchanged.


















      function legacyNoteCreate(noteId, data) {
        return validNote(data)
          && !data.keys().hasAny(["vaultImportJobId"])
          && vaultCutoverCreateHasNameReservation(data)
          && vaultEntryNameReservationStateMatchesAfter(noteId, data)
          && data.isDeleted == false
          && data.ownerUid == request.auth.uid
          && request.auth.uid in data.participantUids
          && data.updatedBy == request.auth.uid
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.savedAt == request.time
          && data.revision == 1
          && pairedNoteHistoryCreated(noteId, data)
          && (
            secureShareCopyMetadataAbsent(data)
            || secureShareCopyCreate(data)
          )
          && allowedShareTargets(data)
          && validAssignedFolder(data);
      }


      function baseNoteUpdate(noteId, data) {
        return (
            (notePurgeRequested() && notePurgeUpdate(noteId, data))
            || (
              !notePurgeRequested()
              && (
                (
                  secureShareCopyStateChangeRequested()
                  && (
                    secureShareCopyActivateUpdate(data)
                    || secureShareCopyAbortUpdate(noteId, data)
                  )
                )
                || (
                  !secureShareCopyStateChangeRequested()
                  && (
                    noteContentUpdate(noteId, data)
                    || noteFolderUpdate(data)
                    || (ownerAccessUpdate(noteId, data) && allowedShareTargets(data))
                    || (legacyActiveDeleteMetadataMigration(data) && validUpdatedNote(data))
                    || noteSoftDeleteUpdate(noteId, data)
                    || noteRestoreUpdate(noteId, data)
                  )
                )
              )
            )
          );
      }


      // The editor's most common save keeps the encrypted title, parent and
      // blinded name claim byte-for-byte stable and changes only the encrypted
      // body. Select that exact owner path before the broad mutation dispatcher
      // so a note inside an encrypted folder does not exceed Firestore's shared
      // 1000-expression budget when its history write and claim verify are in the
      // same transaction. The validator deliberately reuses the ordinary claim
      // and content validators, so this is only an evaluation shortcut.




      // Renaming an owned entry changes only its encrypted title and blinded
      // name reservation after the editor has durably flushed the body. Keep
      // this exact shape separate from the broad content/move dispatcher: a
      // nested-folder rename also creates one claim, deletes the old claim and
      // creates history in the same atomic request, and the broad validators
      // otherwise cross Firestore's hard 1,000-expression limit. The diff is the
      // security boundary here: body, folder, access, deletion, storage identity
      // and import provenance must remain byte-for-byte unchanged.




      function regularNoteHistoryCreate(data, noteId, historyId) {
        return validNoteHistory(data, noteId)
          && data.revision == getAfter(notePath(noteId)).data.revision
          && historyId == getAfter(notePath(noteId)).data.lastMutationId
          && historyMatchesNoteMutation(data, noteId, historyId);
      }

      // Existing TipTap clients remain usable until their owner activates the
      // Vault integrity marker. Once the marker exists (including in the same
      // atomic request), immutable history is written only by /api/vault-notes.
      function legacyPreCutoverHistoryCreate(data, noteId, historyId) {
        let nextNote = getAfter(notePath(noteId)).data;
        return existsAfter(notePath(noteId))
          ? (
            nextNote.keys().hasAny([
              "contentFormat",
              "entryKind",
              "vaultNameClaimId",
              "vaultNameIndexVersion",
              "vaultImportJobId"
            ])
            ? false
            : (
              existsAfter(vaultIntegrityPath(nextNote.ownerUid))
              ? false
              : regularNoteHistoryCreate(data, noteId, historyId)
            )
          )
          : false;
      }

      function legacyActiveDeleteMetadataAdded(data) {
        return !resource.data.keys().hasAny(["isDeleted"])
          && data.keys().hasAny(["isDeleted"])
          && data.isDeleted == false
          && !data.keys().hasAny(["deletedAt", "deletedBy"]);
      }

      function activeNoteUpdateAffectedKeys(keys, keysWithLegacyDeleteMetadata) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys)
          || (
            legacyActiveDeleteMetadataAdded(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(keysWithLegacyDeleteMetadata)
          );
      }

      function legacyActiveDeleteMetadataMigration(data) {
        return (
            get(userPath(request.auth.uid)).data.isAdmin == true
            || (
              request.auth.uid in resource.data.participantUids
              && ownerAllowsParticipant(resource.data, request.auth.uid)
            )
          )
          && legacyActiveDeleteMetadataAdded(data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isDeleted"]);
      }

      function noteContentUpdate(noteId, data) {
        return activeNoteUpdateAffectedKeys([
            "encryptedTitle",
            "encryptedBody",
            "folderId",
            "vaultNameClaimId",
            "vaultNameIndexVersion",
            "updatedAt",
            "updatedBy",
            "revision",
            "lastMutationId"
          ], [
            "encryptedTitle",
            "encryptedBody",
            "folderId",
            "vaultNameClaimId",
            "vaultNameIndexVersion",
            "updatedAt",
            "updatedBy",
            "revision",
            "lastMutationId",
            "isDeleted"
          ])
          && request.auth.uid in data.participantUids
          && secureShareCopyUsable(resource.data)
          && !noteDeleted(resource.data)
          && !noteDeleted(data)
          && data.type == resource.data.type
          && data.participantUids == resource.data.participantUids
          && data.wrappedKeys == resource.data.wrappedKeys
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time
          && noteRevisionAdvances(data)
          && pairedNoteHistoryCreated(noteId, data)
          && (
            !exists(vaultIntegrityPath(resource.data.ownerUid))
            || request.auth.uid == resource.data.ownerUid
            || (
              data.encryptedTitle == resource.data.encryptedTitle
              && noteFolderId(data) == noteFolderId(resource.data)
              && data.vaultNameClaimId == resource.data.vaultNameClaimId
              && data.vaultNameIndexVersion == resource.data.vaultNameIndexVersion
            )
          )
          && allowedShareTargets(data)
          && validAssignedFolder(data)
          && vaultCutoverNoteNameMutationIsClaimAware(data)
          && validVaultEntryPayloadSize(data)
          && validNoteContentProjection(data);
      }

      function noteFolderUpdate(data) {
        return activeNoteUpdateAffectedKeys([
            "folderId",
            "updatedAt",
            "updatedBy"
          ], [
            "folderId",
            "updatedAt",
            "updatedBy",
            "isDeleted"
          ])
          && request.auth.uid == resource.data.ownerUid
          // Revisioned Vault entries must use the audited mutation path below.
          // This compatibility branch is only for historical HTML documents.
          && !resource.data.keys().hasAny(["contentFormat", "entryKind"])
          && !data.keys().hasAny(["contentFormat", "entryKind"])
          && !exists(vaultIntegrityPath(resource.data.ownerUid))
          && secureShareCopyUsable(resource.data)
          && resource.data.type == "personal"
          && data.type == "personal"
          && !noteDeleted(resource.data)
          && !noteDeleted(data)
          && data.participantUids == resource.data.participantUids
          && data.wrappedKeys == resource.data.wrappedKeys
          && data.encryptedTitle == resource.data.encryptedTitle
          && data.encryptedBody == resource.data.encryptedBody
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time
          && noteRevisionIsPreserved(data)
          && validAssignedFolder(data)
          && validUpdatedNote(data);
      }

      function ownerAccessUpdate(noteId, data) {
        return activeNoteUpdateAffectedKeys([
            "type",
            "participantUids",
            "wrappedKeys",
            "folderId",
            "vaultNameClaimId",
            "vaultNameIndexVersion",
            "updatedAt",
            "updatedBy",
            "revision",
            "lastMutationId"
          ], [
            "type",
            "participantUids",
            "wrappedKeys",
            "folderId",
            "vaultNameClaimId",
            "vaultNameIndexVersion",
            "updatedAt",
            "updatedBy",
            "revision",
            "lastMutationId",
            "isDeleted"
          ])
          && request.auth.uid == resource.data.ownerUid
          && secureShareCopyUsable(resource.data)
          && !noteDeleted(resource.data)
          && request.auth.uid in data.participantUids
          && data.encryptedTitle == resource.data.encryptedTitle
          && data.encryptedBody == resource.data.encryptedBody
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time
          && noteRevisionAdvances(data)
          && pairedNoteHistoryCreated(noteId, data)
          && vaultCutoverNoteNameMutationIsClaimAware(data)
          && validAssignedFolder(data)
          && validNoteAccessProjection(data);
      }

      function noteSoftDeleteUpdate(noteId, data) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "isDeleted",
            "deletedAt",
            "deletedBy",
            "updatedAt",
            "updatedBy",
            "revision",
            "lastMutationId"
          ])
          && !noteDeleted(resource.data)
          && secureShareCopyUsable(resource.data)
          && canManageNoteAfterFeatureGate(resource.data)
          && data.isDeleted == true
          && data.deletedAt == request.time
          && data.deletedBy == request.auth.uid
          && noteRevisionAdvances(data)
          // The mandatory paired delete history re-checks the after-image's
          // updatedBy/updatedAt through linkedNoteUpdate. Avoid evaluating those
          // facts twice so import rollback remains below the expression ceiling.
          && pairedNoteHistoryCreated(noteId, data)
          && vaultEntryNameClaimReleasedAfterDelete(resource.data);
      }

      function noteRestoreUpdate(noteId, data) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "isDeleted",
            "deletedAt",
            "deletedBy",
            "updatedAt",
            "updatedBy",
            "revision",
            "lastMutationId"
          ])
          && noteDeleted(resource.data)
          && secureShareCopyUsable(resource.data)
          && canManageNoteAfterFeatureGate(resource.data)
          && !notePurged(resource.data)
          && data.isDeleted == false
          && !data.keys().hasAny(["deletedAt", "deletedBy"])
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time
          && noteRevisionAdvances(data)
          && pairedNoteHistoryCreated(noteId, data)
          && validAssignedFolder(data)
          && vaultEntryNameClaimPresentAfterRestore(data);
      }

      function secureShareCopyActivateUpdate(data) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "secureShareCopyState",
            "secureShareCopyUpdatedAt",
            "secureShareCopyFinishedAt",
            "updatedAt",
            "updatedBy",
            "savedAt"
          ])
          && activeSignedInUserHasNotes()
          && request.auth.uid == resource.data.ownerUid
          && !resource.data.keys().hasAny([
            "secureShareCopyCleanupClaimId",
            "secureShareCopyCleanupClaimedAt"
          ])
          && resource.data.secureShareCopyState == "copying"
          && data.secureShareCopyState == "active"
          && data.secureShareCopyJobId == resource.data.secureShareCopyJobId
          && data.secureShareCopyExpectedAttachmentCount == resource.data.secureShareCopyExpectedAttachmentCount
          && data.secureShareCopyReservedAttachmentCount == resource.data.secureShareCopyReservedAttachmentCount
          && data.secureShareCopyReadyAttachmentCount == resource.data.secureShareCopyReadyAttachmentCount
          && data.secureShareCopyStartedAt == resource.data.secureShareCopyStartedAt
          && data.secureShareCopyReservedAttachmentCount == data.secureShareCopyExpectedAttachmentCount
          && data.secureShareCopyReadyAttachmentCount == data.secureShareCopyExpectedAttachmentCount
          && data.secureShareCopyUpdatedAt == request.time
          && data.secureShareCopyFinishedAt == request.time
          && data.updatedAt == request.time
          && data.savedAt == request.time
          && data.updatedBy == request.auth.uid
          && noteRevisionIsPreserved(data)
          && validAssignedFolder(data)
          && validUpdatedNote(data);
      }

      function secureShareCopyAbortUpdate(noteId, data) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "isDeleted",
            "deletedAt",
            "deletedBy",
            "secureShareCopyState",
            "secureShareCopyUpdatedAt",
            "secureShareCopyFinishedAt",
            "updatedAt",
            "updatedBy",
            "revision",
            "lastMutationId"
          ])
          && activeSignedInUserHasNotes()
          && request.auth.uid == resource.data.ownerUid
          && !resource.data.keys().hasAny([
            "secureShareCopyCleanupClaimId",
            "secureShareCopyCleanupClaimedAt"
          ])
          && resource.data.secureShareCopyState == "copying"
          && data.secureShareCopyState == "aborted"
          && data.secureShareCopyJobId == resource.data.secureShareCopyJobId
          && data.secureShareCopyExpectedAttachmentCount == resource.data.secureShareCopyExpectedAttachmentCount
          && data.secureShareCopyReservedAttachmentCount == 0
          && data.secureShareCopyReadyAttachmentCount == 0
          && data.secureShareCopyStartedAt == resource.data.secureShareCopyStartedAt
          && data.isDeleted == true
          && data.deletedAt == request.time
          && data.deletedBy == request.auth.uid
          && data.secureShareCopyUpdatedAt == request.time
          && data.secureShareCopyFinishedAt == request.time
          && data.updatedAt == request.time
          && data.updatedBy == request.auth.uid
          && noteRevisionAdvances(data)
          && pairedNoteHistoryCreated(noteId, data)
          && validUpdatedNote(data);
      }

      function notePurgeUpdate(noteId, data) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "type",
            "participantUids",
            "wrappedKeys",
            "encryptedTitle",
            "encryptedBody",
            "folderId",
            "dueAt",
            "deletedAt",
            "deletedBy",
            "isPurged",
            "purgedAt",
            "purgedBy",
            "updatedAt",
            "savedAt",
            "updatedBy"
          ])
          && noteDeleted(resource.data)
          && canManageNoteAfterFeatureGate(resource.data)
          && data.isDeleted == true
          && data.isPurged == true
          && !data.keys().hasAny(["folderId", "dueAt", "deletedAt", "deletedBy"])
          && data.purgedAt == request.time
          && data.purgedBy == request.auth.uid
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time
          && data.savedAt == request.time
          && noteRevisionIsPreserved(data)
          && data.type == "personal"
          && data.participantUids == [request.auth.uid]
          && data.wrappedKeys.keys().hasOnly([request.auth.uid])
          && notePurgeCleanupQueueCreated(noteId, data)
          && validUpdatedNote(data);
      }

      function notePurgeRequested() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(["isPurged", "purgedAt", "purgedBy"]);
      }

      function notePurgeCleanupQueueCreated(noteId, data) {
        return existsAfter(notePurgeCleanupQueuePath(noteId))
          && validNotePurgeCleanupQueue(getAfter(notePurgeCleanupQueuePath(noteId)).data, noteId)
          && getAfter(notePurgeCleanupQueuePath(noteId)).data.ownerUid == data.ownerUid;
      }

      function allowedShareTargets(data) {
        return data.participantUids.hasOnly([data.ownerUid])
          || (
            userHasNotes(data.ownerUid)
            && (
              get(userPath(data.ownerUid)).data.isAdmin == true
              || (
                get(userPath(data.ownerUid)).data.keys().hasAny(["allowedShareTargetUids"])
                && data.participantUids.hasOnly(get(userPath(data.ownerUid)).data.allowedShareTargetUids)
              )
            )
          );
      }

      function canListNoteDocument(data) {
        return (
            canReadNote(data)
            && (
              !legacyActiveDeleteMetadata(data)
              || adminUser()
              || data.ownerUid == request.auth.uid
            )
          )
          || canReadDeletedNote(data)
          || canReadSecureShareCopyNote(data);
      }

      function canManageNoteAfterFeatureGate(data) {
        return get(userPath(request.auth.uid)).data.isAdmin == true
          || data.ownerUid == request.auth.uid;
      }

      allow get: if canReadNoteDocument(resource.data);
      allow list: if canListNoteDocument(resource.data);
      // Versioned Vault writes are routed through /api/vault-notes. A strictly
      // pre-cutover TipTap document may still use the historical transaction
      // while its owner has no integrity marker; existsAfter closes the
      // same-batch marker-activation gap.
      allow create: if activeSignedInUserHasNotes()
        && (
          request.resource.data.keys().hasAny([
            "contentFormat",
            "entryKind",
            "vaultNameClaimId",
            "vaultNameIndexVersion",
            "vaultImportJobId"
          ])
          ? false
          : (
            existsAfter(vaultIntegrityPath(request.resource.data.ownerUid))
            ? false
            : legacyNoteCreate(noteId, request.resource.data)
          )
        );
      allow update: if activeSignedInUserHasNotes()
        && (
          resource.data.keys().hasAny([
            "contentFormat",
            "entryKind",
            "vaultNameClaimId",
            "vaultNameIndexVersion",
            "vaultImportJobId"
          ])
          || request.resource.data.keys().hasAny([
            "contentFormat",
            "entryKind",
            "vaultNameClaimId",
            "vaultNameIndexVersion",
            "vaultImportJobId"
          ])
          ? false
          : (
            existsAfter(vaultIntegrityPath(resource.data.ownerUid))
            ? false
            : (
              vaultImportNoteUpdateAllowed(request.resource.data)
              && baseNoteUpdate(noteId, request.resource.data)
            )
          )
        );
      match /history/{historyId} {
        allow read: if exists(notePath(noteId))
          && canReadNoteHistory(resource.data, get(notePath(noteId)).data);
        allow create: if legacyPreCutoverHistoryCreate(
          request.resource.data,
          noteId,
          historyId
        );
        allow delete: if exists(notePath(noteId))
          && !get(notePath(noteId)).data.keys().hasAny([
            "contentFormat",
            "entryKind",
            "vaultNameClaimId",
            "vaultNameIndexVersion",
            "vaultImportJobId"
          ])
          && !existsAfter(vaultIntegrityPath(get(notePath(noteId)).data.ownerUid))
          && noteDeleted(get(notePath(noteId)).data)
          && notePurged(get(notePath(noteId)).data)
          && canDeleteNote(get(notePath(noteId)).data);
      }

      match /attachments/{attachmentId} {
        allow read: if exists(notePath(noteId))
          && (
            canReadNote(get(notePath(noteId)).data)
            || canReadSecureShareCopyNote(get(notePath(noteId)).data)
            || canReadDeletedNote(get(notePath(noteId)).data)
          );
      }
    }

    match /notePurgeCleanupQueue/{noteId} {
      allow create: if activeSignedInUser()
        && validNotePurgeCleanupQueue(request.resource.data, noteId)
        && exists(notePath(noteId))
        && !get(notePath(noteId)).data.keys().hasAny([
          "contentFormat",
          "entryKind",
          "vaultNameClaimId",
          "vaultNameIndexVersion",
          "vaultImportJobId"
        ])
        && !existsAfter(vaultIntegrityPath(get(notePath(noteId)).data.ownerUid))
        && !notePurged(get(notePath(noteId)).data)
        && canDeleteNote(get(notePath(noteId)).data)
        && existsAfter(notePath(noteId))
        && notePurged(getAfter(notePath(noteId)).data)
        && get(notePath(noteId)).data.ownerUid == request.resource.data.ownerUid
        && getAfter(notePath(noteId)).data.ownerUid == request.resource.data.ownerUid
        && getAfter(notePath(noteId)).data.purgedBy == request.auth.uid
        && getAfter(notePath(noteId)).data.purgedAt == request.time;
    }

    match /publicNoteShares/{shareId} {
      function publicShareCleanupQueuePath(shareId) {
        return /databases/$(database)/documents/publicShareCleanupQueue/$(shareId);
      }

      function validPublicShare(data) {
        return data.keys().hasOnly([
          "sourceNoteId",
          "sourceRevision",
          "sourceAttachmentRevision",
          "ownerUid",
          "version",
          "encryptedTitle",
          "encryptedBody",
          "ownerWrappedShareKey",
          "currentGeneration",
          "attachmentCount",
          "passwordHash",
          "ready",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "revokedAt",
          "revokedBy"
        ])
        && data.sourceNoteId is string
        && data.sourceNoteId.size() > 0
        && data.sourceNoteId.size() <= 160
        && validOptionalPublicShareSourceRevision(data)
        && validOptionalPublicShareSourceAttachmentRevision(data)
        && data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.version == 1
        && encryptedPayload(data.encryptedTitle)
        && encryptedPayload(data.encryptedBody)
        && validPublicShareOwnerWrappedKey(data)
        && validOptionalPublicShareGeneration(data)
        && data.attachmentCount is int
        && data.attachmentCount >= 0
        && data.attachmentCount <= 100
        && validPublicSharePassword(data)
        && data.ready is bool
        && (!data.keys().hasAny(["createdAt"]) || data.createdAt is timestamp)
        && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp)
        && data.expiresAt is timestamp
        && (
          !data.keys().hasAny(["revokedAt", "revokedBy"])
          || (
            data.keys().hasAll(["revokedAt", "revokedBy"])
            && data.revokedAt is timestamp
            && data.revokedBy is string
            && data.revokedBy.size() > 0
          )
        );
      }

      function validPublicShareGeneration(generation) {
        return generation is string
          && generation.matches("^[A-Za-z0-9_-]{1,160}$");
      }

      function validOptionalPublicShareSourceRevision(data) {
        return !data.keys().hasAny(["sourceRevision"])
          || (
            data.sourceRevision is int
            && data.sourceRevision >= 0
            && data.sourceRevision <= 999999999999
          );
      }

      function validOptionalPublicShareSourceAttachmentRevision(data) {
        return !data.keys().hasAny(["sourceAttachmentRevision"])
          || (
            data.sourceAttachmentRevision is int
            && data.sourceAttachmentRevision >= 0
            && data.sourceAttachmentRevision <= 999999999999
          );
      }

      function publicShareSourceRevisionMatches(shareData, sourceNote) {
        return (
            (
              !shareData.keys().hasAny(["sourceRevision"])
              && !sourceNote.keys().hasAny(["revision"])
            )
            || (
              shareData.keys().hasAny(["sourceRevision"])
              && shareData.sourceRevision == (
                sourceNote.keys().hasAny(["revision"])
                  ? sourceNote.revision
                  : 0
              )
            )
          )
          && (
            (
              !shareData.keys().hasAny(["sourceAttachmentRevision"])
              && !sourceNote.keys().hasAny(["attachmentRevision"])
            )
            || (
              shareData.keys().hasAny(["sourceAttachmentRevision"])
              && shareData.sourceAttachmentRevision == (
                sourceNote.keys().hasAny(["attachmentRevision"])
                  ? sourceNote.attachmentRevision
                  : 0
              )
            )
          );
      }

      function validOptionalPublicShareGeneration(data) {
        return !data.keys().hasAny(["currentGeneration"])
          || validPublicShareGeneration(data.currentGeneration);
      }

      function publicShareAttachmentIsCurrent(shareData, attachmentData) {
        return (
            !shareData.keys().hasAny(["currentGeneration"])
            && !attachmentData.keys().hasAny(["generation"])
          )
          || (
            shareData.keys().hasAny(["currentGeneration"])
            && attachmentData.keys().hasAny(["generation"])
            && attachmentData.generation == shareData.currentGeneration
          );
      }

      function publicShareGenerationPreserved(data) {
        return (
            !resource.data.keys().hasAny(["currentGeneration"])
            && !data.keys().hasAny(["currentGeneration"])
          )
          || (
            resource.data.keys().hasAny(["currentGeneration"])
            && data.keys().hasAny(["currentGeneration"])
            && data.currentGeneration == resource.data.currentGeneration
          );
      }

      function publicShareGenerationAdvances(data) {
        return data.keys().hasAny(["currentGeneration"])
          && (
            !resource.data.keys().hasAny(["currentGeneration"])
            || data.currentGeneration != resource.data.currentGeneration
          );
      }

      function publicShareSourceAttachmentRevisionPreserved(data) {
        return (
            !resource.data.keys().hasAny(["sourceAttachmentRevision"])
            && !data.keys().hasAny(["sourceAttachmentRevision"])
          )
          || (
            resource.data.keys().hasAny(["sourceAttachmentRevision"])
            && data.keys().hasAny(["sourceAttachmentRevision"])
            && data.sourceAttachmentRevision == resource.data.sourceAttachmentRevision
          );
      }

      function publicShareAttachmentRevisionFlipValid(data) {
        return publicShareSourceAttachmentRevisionPreserved(data)
          || publicShareGenerationAdvances(data);
      }

      function publicShareContentGenerationValid(data) {
        return publicShareGenerationAdvances(data)
          || (
            data.attachmentCount == resource.data.attachmentCount
            && publicShareGenerationPreserved(data)
          );
      }

      function validPublicShareOwnerWrappedKey(data) {
        return !data.keys().hasAny(["ownerWrappedShareKey"])
          || wrappedAesKeyPayload(data.ownerWrappedShareKey);
      }

      function validPublicSharePassword(data) {
        return !data.keys().hasAny(["passwordHash"])
          || validPublicSharePasswordHash(data.passwordHash);
      }

      function validPublicSharePasswordHash(passwordHash) {
        return passwordHash is map
          && passwordHash.keys().hasOnly(["version", "algorithm", "salt", "iterations", "hash"])
          && passwordHash.version == 2
          && passwordHash.algorithm == "PBKDF2-SHA-256"
          && passwordHash.salt is string
          && passwordHash.salt.size() >= 8
          && passwordHash.salt.size() <= 256
          && passwordHash.iterations is int
          && passwordHash.iterations >= 100000
          && passwordHash.iterations <= 1000000
          && passwordHash.hash is string
          && passwordHash.hash.size() >= 8
          && passwordHash.hash.size() <= 256;
      }

      function validOptionalPublicAttachmentEncryptedFileName(data) {
        return (
            !data.keys().hasAny(["encryptedFileName"])
            && !data.keys().hasAny(["privacyVersion"])
          )
          || (
            data.keys().hasAll(["encryptedFileName", "privacyVersion"])
            && data.privacyVersion == 1
            && encryptedPayload(data.encryptedFileName)
            && data.encryptedFileName.cipherText.size() >= 24
            && data.encryptedFileName.cipherText.size() <= 1024
            && data.encryptedFileName.iv.size() == 16
            && data.fileName == "shared-" + data.extension + "-attachment"
          );
      }

      function publicShareAttachmentPrivacyProtected(data) {
        return data.keys().hasAll(["encryptedFileName", "privacyVersion"])
          && validOptionalPublicAttachmentEncryptedFileName(data);
      }

      function publicShareNotRevoked(data) {
        return !data.keys().hasAny(["revokedAt", "revokedBy"]);
      }

      function securePublicShareV2(data) {
        return data.keys().hasAny(["schemaVersion"])
          && data.schemaVersion == 2;
      }

      function publicShareSourceAvailable(data) {
        let sourcePath = notePath(data.sourceNoteId);
        let sourceNote = get(sourcePath).data;
        return exists(sourcePath)
          && exists(userPath(data.ownerUid))
          && userHasNotes(data.ownerUid)
          && sourceNote.ownerUid == data.ownerUid
          && noteActive(sourceNote)
          && !notePurged(sourceNote);
      }

      function publicShareSourceActive(data) {
        return publicShareSourceAvailable(data)
          && publicShareSourceRevisionMatches(data, get(notePath(data.sourceNoteId)).data);
      }

      function publicShareSourceActiveAfterFeatureGate(data) {
        let sourcePath = notePath(data.sourceNoteId);
        let sourceNote = get(sourcePath).data;
        return exists(sourcePath)
          && sourceNote.ownerUid == data.ownerUid
          && noteActive(sourceNote)
          && !notePurged(sourceNote)
          && publicShareSourceRevisionMatches(data, sourceNote);
      }

      function publicShareActive(data) {
        return !securePublicShareV2(data)
          && data.ready == true
          && publicShareNotRevoked(data)
          && data.expiresAt > request.time
          && validPublicSharePassword(data)
          && publicShareSourceAvailable(data);
      }

      function publicShareCleanupQueueCreated(shareId, shareData) {
        return existsAfter(publicShareCleanupQueuePath(shareId))
          && validPublicShareCleanupQueue(getAfter(publicShareCleanupQueuePath(shareId)).data, shareId)
          && getAfter(publicShareCleanupQueuePath(shareId)).data.expiresAt == shareData.expiresAt;
      }

      function publicShareCreate(shareId, data) {
        return activeSignedInUser()
          && validPublicShare(data)
          && data.ownerUid == request.auth.uid
          && data.ready == false
          && data.attachmentCount == 0
          && data.keys().hasAny(["ownerWrappedShareKey"])
          && data.keys().hasAny(["currentGeneration"])
          && data.keys().hasAny(["sourceRevision"])
          && data.keys().hasAny(["sourceAttachmentRevision"])
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.expiresAt > request.time
          && data.expiresAt <= request.time + duration.value(7, "d")
          && publicShareNotRevoked(data)
          && publicShareSourceActive(data)
          && publicShareCleanupQueueCreated(shareId, data);
      }

      function publicShareActivateUpdate(data) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ready", "attachmentCount", "updatedAt"])
          && resource.data.ownerUid == request.auth.uid
          && publicShareNotRevoked(resource.data)
          && publicShareNotRevoked(data)
          && publicShareSourceActiveAfterFeatureGate(data)
          && resource.data.ready == false
          && data.ready == true
          && data.updatedAt == request.time;
      }

      function publicShareRevokeUpdate(data) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["revokedAt", "revokedBy", "updatedAt"])
          && resource.data.ownerUid == request.auth.uid
          && publicShareNotRevoked(resource.data)
          && data.revokedAt == request.time
          && data.revokedBy == request.auth.uid
          && data.updatedAt == request.time;
      }

      function publicSharePasswordUpdate(data) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["passwordHash", "updatedAt"])
          && resource.data.ownerUid == request.auth.uid
          && publicShareNotRevoked(resource.data)
          && publicShareNotRevoked(data)
          && publicShareSourceActiveAfterFeatureGate(data)
          && data.updatedAt == request.time;
      }

      function publicShareContentUpdate(data) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "encryptedTitle",
            "encryptedBody",
            "sourceRevision",
            "sourceAttachmentRevision",
            "currentGeneration",
            "attachmentCount",
            "passwordHash",
            "updatedAt"
          ])
          && resource.data.ownerUid == request.auth.uid
          && publicShareNotRevoked(resource.data)
          && publicShareNotRevoked(data)
          && data.keys().hasAll(["sourceRevision", "sourceAttachmentRevision"])
          && publicShareSourceActiveAfterFeatureGate(data)
          && publicShareAttachmentRevisionFlipValid(data)
          && data.updatedAt == request.time
          && publicShareContentGenerationValid(data);
      }

      allow get: if publicShareActive(resource.data) || publicShareOwner(resource.data);
      allow list: if publicShareOwner(resource.data);
      allow create: if publicShareCreate(shareId, request.resource.data);
      allow update: if activeSignedInUserHasNotes()
        && (
          (publicShareActivateUpdate(request.resource.data) && validPublicShare(request.resource.data))
          || (publicShareRevokeUpdate(request.resource.data) && validPublicShare(request.resource.data))
          || (publicSharePasswordUpdate(request.resource.data) && validPublicShare(request.resource.data))
          || (publicShareContentUpdate(request.resource.data) && validPublicShare(request.resource.data))
        );
      allow delete: if !securePublicShareV2(resource.data)
        && publicShareOwner(resource.data);

      match /attachments/{attachmentId} {
        allow read: if exists(publicSharePath(shareId))
          && publicShareOwner(get(publicSharePath(shareId)).data);
        allow get: if exists(publicSharePath(shareId))
          && publicShareActive(get(publicSharePath(shareId)).data)
          && publicShareAttachmentIsCurrent(get(publicSharePath(shareId)).data, resource.data)
          && publicShareAttachmentPrivacyProtected(resource.data);
        allow list: if exists(publicSharePath(shareId))
          && publicShareActive(get(publicSharePath(shareId)).data)
          && publicShareAttachmentIsCurrent(get(publicSharePath(shareId)).data, resource.data)
          && resource.data.privacyVersion == 1;
      }
    }

    match /publicShareCleanupQueue/{shareId} {
      function publicShareCleanupQueueOwner(shareId) {
        return exists(publicSharePath(shareId))
          && publicShareOwner(get(publicSharePath(shareId)).data);
      }

      allow get, list: if publicShareCleanupQueueOwner(shareId);
      allow create: if validPublicShareCleanupQueue(request.resource.data, shareId)
        && existsAfter(publicSharePath(shareId))
        && publicShareOwner(getAfter(publicSharePath(shareId)).data)
        && request.resource.data.expiresAt == getAfter(publicSharePath(shareId)).data.expiresAt;
      match /publicShareAttachmentCleanupQueue/{attachmentId} {
        allow get, list: if exists(publicSharePath(shareId))
          && publicShareOwner(get(publicSharePath(shareId)).data);
      }
    }

    match /noteUserStates/{noteId}/users/{uid} {
      function validNoteUserState(data, noteId, uid) {
        return data.keys().hasAll(["uid", "noteId"])
          && data.keys().hasOnly([
            "uid",
            "noteId",
            "isPinned",
            "readAt",
            "confirmedAt",
            "cursorOffset",
            "cursorVisible",
            "cursorClientId",
            "cursorUpdatedAt",
            "updatedAt"
          ])
          && data.uid == uid
          && data.noteId == noteId
          && (!data.keys().hasAny(["isPinned"]) || data.isPinned is bool)
          && (!data.keys().hasAny(["readAt"]) || data.readAt is timestamp)
          && (!data.keys().hasAny(["confirmedAt"]) || data.confirmedAt is timestamp)
          && (
            !data.keys().hasAny(["cursorOffset"])
            || data.cursorOffset == null
            || (data.cursorOffset is int && data.cursorOffset >= 0 && data.cursorOffset <= 500000)
          )
          && (!data.keys().hasAny(["cursorVisible"]) || data.cursorVisible is bool)
          && (
            !data.keys().hasAny(["cursorClientId"])
            || (data.cursorClientId is string && data.cursorClientId.size() > 0 && data.cursorClientId.size() <= 80)
          )
          && (
            !data.keys().hasAny(["cursorUpdatedAt"])
            || (data.cursorUpdatedAt is timestamp && data.cursorUpdatedAt <= request.time)
          )
          && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp);
      }

      allow read: if exists(notePath(noteId))
        && canReadNoteDocument(get(notePath(noteId)).data);
      allow create, update: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && exists(notePath(noteId))
        && !noteDeleted(get(notePath(noteId)).data)
        && request.auth.uid in get(notePath(noteId)).data.participantUids
        && ownerAllowsParticipant(get(notePath(noteId)).data, request.auth.uid)
        && validNoteUserState(request.resource.data, noteId, uid);
    }

    match /activeNotes/{uid} {
      function validActiveNote(data, uid) {
        return data.keys().hasAll(["uid", "noteId", "updatedByClientId"])
          && data.keys().hasOnly(["uid", "noteId", "updatedAt", "updatedByClientId"])
          && data.uid == uid
          && (data.noteId == null || data.noteId is string)
          && data.updatedByClientId is string
          && data.updatedByClientId.size() > 0
          && data.updatedByClientId.size() <= 80;
      }

      allow read: if activeSignedInUserHasNotes()
        && request.auth.uid == uid;
      allow create, update: if activeSignedInUserHasNotes()
        && request.auth.uid == uid
        && validActiveNote(request.resource.data, uid)
        && (
          request.resource.data.noteId == null
          || (
            exists(notePath(request.resource.data.noteId))
            && request.auth.uid in get(notePath(request.resource.data.noteId)).data.participantUids
            && ownerAllowsParticipant(
              get(notePath(request.resource.data.noteId)).data,
              request.auth.uid
            )
            && noteActive(get(notePath(request.resource.data.noteId)).data)
            && !notePurged(get(notePath(request.resource.data.noteId)).data)
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
