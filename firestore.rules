rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bootstrapPath() {
      return /databases/$(database)/documents/system/bootstrap;
    }

    function bootstrapGatePath() {
      return /databases/$(database)/documents/system/bootstrapGate;
    }

    function bootstrapAttemptPath(uid) {
      return /databases/$(database)/documents/system/bootstrapAttempts/attempts/$(uid);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function rosterPath(uid) {
      return /databases/$(database)/documents/publicLoginRoster/$(uid);
    }

    function userKeyPath(uid) {
      return /databases/$(database)/documents/userKeys/$(uid);
    }

    function quickLoginKeyPath(quickKey) {
      return /databases/$(database)/documents/quickLoginKeys/$(quickKey);
    }

    function notePath(noteId) {
      return /databases/$(database)/documents/notes/$(noteId);
    }

    function noteAttachmentPath(noteId, attachmentId) {
      return /databases/$(database)/documents/notes/$(noteId)/attachments/$(attachmentId);
    }

    function scheduleTaskPath(taskId) {
      return /databases/$(database)/documents/scheduleTasks/$(taskId);
    }

    function googleCalendarTaskTombstonePath(taskId) {
      return /databases/$(database)/documents/googleCalendarTaskTombstones/$(taskId);
    }

    function googleCalendarTaskSyncReceiptPath(taskId) {
      return /databases/$(database)/documents/googleCalendarTaskSyncReceipts/$(taskId);
    }

    function googleCalendarConnectionPath(uid) {
      return /databases/$(database)/documents/googleCalendarConnections/$(uid);
    }

    function libraryVaultPath(uid) {
      return /databases/$(database)/documents/libraryVaults/$(uid);
    }

    function noteHistoryPath(noteId, historyId) {
      return /databases/$(database)/documents/notes/$(noteId)/history/$(historyId);
    }

    function notePurgeCleanupQueuePath(noteId) {
      return /databases/$(database)/documents/notePurgeCleanupQueue/$(noteId);
    }

    function noteFolderPath(folderId) {
      return /databases/$(database)/documents/noteFolders/$(folderId);
    }

    function vaultIntegrityPath(uid) {
      return /databases/$(database)/documents/vaultIntegrity/$(uid);
    }

    function vaultFolderTreePath(uid) {
      return /databases/$(database)/documents/vaultFolderTrees/$(uid);
    }

    function vaultNameClaimPath(uid, claimId) {
      return /databases/$(database)/documents/vaultIntegrity/$(uid)/nameClaims/$(claimId);
    }

    function vaultPathRewriteJobPath(uid, jobId) {
      return /databases/$(database)/documents/vaultMaintenanceJobs/$(uid)/pathRewrites/$(jobId);
    }

    function vaultImportJobPath(uid, jobId) {
      return /databases/$(database)/documents/vaultMaintenanceJobs/$(uid)/imports/$(jobId);
    }

    function publicSharePath(shareId) {
      return /databases/$(database)/documents/publicNoteShares/$(shareId);
    }

    function publicShareAttachmentPath(shareId, attachmentId) {
      return /databases/$(database)/documents/publicNoteShares/$(shareId)/attachments/$(attachmentId);
    }

    function publicShareCleanupQueuePath(shareId) {
      return /databases/$(database)/documents/publicShareCleanupQueue/$(shareId);
    }

    function publicShareAttachmentCleanupQueuePath(shareId, attachmentId) {
      return /databases/$(database)/documents/publicShareCleanupQueue/$(shareId)/publicShareAttachmentCleanupQueue/$(attachmentId);
    }

    function activeSignedInUser() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.isActive == true;
    }

    function validFeatureAccess(data) {
      return data.keys().hasOnly(["notes", "library", "schedule"])
        && data.notes is bool
        && data.library is bool
        && data.schedule is bool;
    }

    function userHasFeature(uid, feature) {
      let profile = get(userPath(uid)).data;
      return exists(userPath(uid))
        && profile.isActive == true
        && (
          profile.isAdmin == true
          || !profile.keys().hasAny(["featureAccess"])
          || (
            validFeatureAccess(profile.featureAccess)
            && profile.featureAccess.get(feature, false) == true
          )
        );
    }

    function activeSignedInUserHasFeature(feature) {
      return signedIn() && userHasFeature(request.auth.uid, feature);
    }

    function userHasNotes(uid) {
      let profile = get(userPath(uid)).data;
      // Reading a missing profile yields no usable profile data, so the
      // isActive comparison below already fails closed. Avoid evaluating the
      // same user document twice on every note/history/name-claim write.
      return profile.isActive == true
        && (
          profile.isAdmin == true
          || !profile.keys().hasAny(["featureAccess"])
          || (
            validFeatureAccess(profile.featureAccess)
            && profile.featureAccess.notes == true
          )
        );
    }

    function activeSignedInUserHasNotes() {
      return signedIn() && userHasNotes(request.auth.uid);
    }

    function adminUser() {
      return activeSignedInUser()
        && get(userPath(request.auth.uid)).data.isAdmin == true;
    }

    function noteParticipant(data) {
      return activeSignedInUserHasNotes()
        && request.auth.uid in data.participantUids;
    }

    function encryptedPayload(payload) {
      return payload is map
        && payload.keys().hasOnly(["version", "algorithm", "cipherText", "iv"])
        && payload.version == 1
        && payload.algorithm == "AES-GCM"
        && payload.cipherText is string
        && payload.iv is string;
    }

    function boundedEncryptedPayload(payload, maximumCipherTextSize) {
      return encryptedPayload(payload)
        && payload.cipherText.size() > 0
        && payload.cipherText.size() <= maximumCipherTextSize
        && payload.iv.size() > 0
        && payload.iv.size() <= 256;
    }

    function wrappedAesKeyPayload(payload) {
      return payload is map
        && payload.keys().hasOnly(["version", "algorithm", "wrappedKey"])
        && payload.version == 1
        && payload.algorithm == "RSA-OAEP"
        && payload.wrappedKey is string
        && payload.wrappedKey.size() >= 8
        && payload.wrappedKey.size() <= 4096;
    }

    function validNote(data) {
      return data.keys().hasOnly([
        "type",
        "ownerUid",
        "participantUids",
        "encryptedTitle",
        "encryptedBody",
        "contentFormat",
        "entryKind",
        "vaultNameClaimId",
        "vaultNameIndexVersion",
        "vaultImportJobId",
        "wrappedKeys",
        "folderId",
        "createdAt",
        "dueAt",
        "updatedAt",
        "updatedBy",
        "savedAt",
        "revision",
        "lastMutationId",
        "attachmentRevision",
        "secureShareCopyState",
        "secureShareCopyJobId",
        "secureShareCopyExpectedAttachmentCount",
        "secureShareCopyReservedAttachmentCount",
        "secureShareCopyReadyAttachmentCount",
        "secureShareCopyStartedAt",
        "secureShareCopyUpdatedAt",
        "secureShareCopyFinishedAt",
        "secureShareCopyCleanupClaimId",
        "secureShareCopyCleanupClaimedAt",
        "isDeleted",
        "deletedAt",
        "deletedBy",
        "isPurged",
        "purgedAt",
        "purgedBy"
      ])
      && validUpdatedNote(data);
    }

    // Update branches already constrain affected keys, so revalidate values
    // without re-counting the full create-only allowlist on every mutation.
    function validUpdatedNote(data) {
      return data.type in ["personal", "shared"]
      && data.ownerUid is string
      && data.participantUids is list
      && data.participantUids.size() > 0
      && ((data.type == "personal" && data.participantUids.size() == 1) || (data.type == "shared" && data.participantUids.size() > 1))
      && encryptedPayload(data.encryptedTitle)
      && encryptedPayload(data.encryptedBody)
      && data.wrappedKeys is map
      && validNoteFolderReference(data)
      && (!data.keys().hasAny(["createdAt"]) || data.createdAt is timestamp)
      && (!data.keys().hasAny(["dueAt"]) || data.dueAt == null || data.dueAt is timestamp)
      && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp)
      && (!data.keys().hasAny(["savedAt"]) || data.savedAt is timestamp)
      && data.updatedBy is string
      && validNoteRevision(data)
      && validNoteAttachmentRevision(data)
      && validDeleteMetadata(data)
      && validPurgeMetadata(data);
    }

    function validVaultImportJobId(jobId) {
      return jobId is string && jobId.matches("^vi1_[A-Za-z0-9_-]{43}$");
    }

    // Access mutations cannot change encrypted content, ownership, deletion,
    // purge, attachment, or timestamp identity fields. Validate only the
    // mutable access projection here to stay below Firestore's 1000-expression
    // budget while preserving the same constraints for every changed value.
    function validNoteAccessProjection(data) {
      return data.type in ["personal", "shared"]
        && data.participantUids is list
        && data.participantUids.size() > 0
        && (
          (data.type == "personal" && data.participantUids.size() == 1)
          || (data.type == "shared" && data.participantUids.size() > 1)
        )
        && data.wrappedKeys is map
        && validNoteFolderReference(data);
    }

    // Content mutations cannot alter ownership, participants, wrapped keys,
    // deletion/purge state, or attachment metadata. Revalidate the encrypted
    // payloads and optional folder reference that this branch can change.
    function validNoteContentProjection(data) {
      return encryptedPayload(data.encryptedTitle)
        && encryptedPayload(data.encryptedBody)
        && validNoteFolderReference(data);
    }

    function validVaultStorageIdentity(data) {
      return data.keys().hasAll(["contentFormat", "entryKind"])
        && (
          (data.contentFormat == "legacy-html-v1" && data.entryKind == "legacy-html")
          || (data.contentFormat == "markdown-v1" && data.entryKind == "markdown")
          || (data.contentFormat == "json-canvas-v1" && data.entryKind == "canvas")
          || (data.contentFormat == "base-v1" && data.entryKind == "base")
          || (data.contentFormat == "asset-v1" && data.entryKind == "asset")
        );
    }

    function validVaultEntryFormat(data, noteId) {
      return !data.keys().hasAny(["contentFormat", "entryKind"])
        || (
          validVaultStorageIdentity(data)
          && validVaultEntryPayloadSize(data)
          && validVaultNameReservationFields(data)
        );
    }

    function validVaultNameClaimId(value) {
      return value is string && value.matches("^[A-Za-z0-9_-]{43}$");
    }

    function validVaultNameReservationFields(data) {
      return data.keys().hasAll(["vaultNameClaimId", "vaultNameIndexVersion"])
        && validVaultNameClaimId(data.vaultNameClaimId)
        && data.vaultNameIndexVersion == 1;
    }

    function vaultCutoverCreateHasNameReservation(data) {
      // Marker activation is a separate transaction. Treat a marker created in
      // this same request as active so a client cannot smuggle unclaimed legacy
      // or versioned entries through the pre-cutover create branch.
      return existsAfter(vaultIntegrityPath(data.ownerUid))
        ? validVaultNameReservationFields(data)
        : true;
    }

    function vaultCutoverNoteNameMutationIsClaimAware(data) {
      return resource.data.keys().hasAny(["vaultNameClaimId"])
        ? (
          data.encryptedTitle == resource.data.encryptedTitle
          && noteFolderId(data) == noteFolderId(resource.data)
          && data.type == resource.data.type
          ? true
          : data.vaultNameClaimId != resource.data.vaultNameClaimId
        )
        : true;
    }

    function vaultCutoverFolderMutationIsClaimAware(data) {
      return resource.data.keys().hasAny(["vaultNameClaimId"])
        ? (
          data.encryptedName == resource.data.encryptedName
          && data.parentId == resource.data.parentId
          ? true
          : data.vaultNameClaimId != resource.data.vaultNameClaimId
        )
        : true;
    }

    // Once the Vault integrity marker exists (including a marker created in
    // the same atomic write), folder names must never be persisted in clear
    // text. Historical accounts without a marker retain their legacy folder
    // shape so the unlocked client can dual-read and migrate it explicitly.
    function vaultFolderStorageMatchesCutover(data) {
      return existsAfter(vaultIntegrityPath(data.ownerUid))
        ? data.name == "암호화 폴더"
        : true;
    }

    // Historical TipTap notes share the same collection and already sit close
    // to the Firestore Rules expression budget. Apply the stricter create and
    // content-update byte budget only to explicitly versioned Vault entries;
    // the revisioned client service mirrors the same limit before each write.
    // Adding this expansion to all legacy mutation branches exceeds Rules'
    // 1000-expression ceiling, so legacy paths retain structural validation.
    function validVaultEntryPayloadSize(data) {
      return !data.keys().hasAny(["contentFormat", "entryKind"])
        || (
          data.encryptedTitle.cipherText.size() > 0
          && data.encryptedTitle.cipherText.size() <= 4096
          && data.encryptedTitle.iv.size() > 0
          && data.encryptedTitle.iv.size() <= 256
          && data.encryptedBody.cipherText.size() > 0
          && data.encryptedBody.cipherText.size() <= 700000
          && data.encryptedBody.iv.size() > 0
          && data.encryptedBody.iv.size() <= 256
        );
    }

    function secureShareCopyMetadataAbsent(data) {
      return !data.keys().hasAny([
        "secureShareCopyState",
        "secureShareCopyJobId",
        "secureShareCopyExpectedAttachmentCount",
        "secureShareCopyReservedAttachmentCount",
        "secureShareCopyReadyAttachmentCount",
        "secureShareCopyStartedAt",
        "secureShareCopyUpdatedAt",
        "secureShareCopyFinishedAt",
        "secureShareCopyCleanupClaimId",
        "secureShareCopyCleanupClaimedAt"
      ]);
    }

    function secureShareCopyCreate(data) {
      return data.keys().hasAll([
          "secureShareCopyState",
          "secureShareCopyJobId",
          "secureShareCopyExpectedAttachmentCount",
          "secureShareCopyReservedAttachmentCount",
          "secureShareCopyReadyAttachmentCount",
          "secureShareCopyStartedAt",
          "secureShareCopyUpdatedAt"
        ])
        && !data.keys().hasAny([
          "secureShareCopyFinishedAt",
          "secureShareCopyCleanupClaimId",
          "secureShareCopyCleanupClaimedAt"
        ])
        && data.type == "personal"
        && data.participantUids == [data.ownerUid]
        && data.secureShareCopyState == "copying"
        && data.secureShareCopyJobId is string
        && data.secureShareCopyJobId.matches("^[A-Za-z0-9_-]{16,160}$")
        && data.secureShareCopyExpectedAttachmentCount is int
        && data.secureShareCopyExpectedAttachmentCount >= 0
        && data.secureShareCopyExpectedAttachmentCount <= 100
        && data.secureShareCopyReservedAttachmentCount == 0
        && data.secureShareCopyReadyAttachmentCount == 0
        && data.secureShareCopyStartedAt == request.time
        && data.secureShareCopyUpdatedAt == request.time;
    }

    function secureShareCopyUsable(data) {
      return secureShareCopyMetadataAbsent(data)
        || data.secureShareCopyState == "active";
    }

    function secureShareCopyStateChangeRequested() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "secureShareCopyState",
        "secureShareCopyFinishedAt"
      ]);
    }

    function validNoteAttachmentRevision(data) {
      return !data.keys().hasAny(["attachmentRevision"])
        || (
          data.attachmentRevision is int
          && data.attachmentRevision >= 0
          && data.attachmentRevision <= 999999999999
        );
    }

    function validNoteRevision(data) {
      return (
          !data.keys().hasAny(["revision", "lastMutationId"])
        )
        || (
          data.keys().hasAll(["revision", "lastMutationId"])
          && data.revision is int
          && data.revision >= 1
          && data.revision <= 999999999999
          && data.lastMutationId is string
          && data.lastMutationId.matches("^[A-Za-z0-9_-]{8,160}$")
        );
    }

    function noteRevisionIsPreserved(data) {
      return (
          !resource.data.keys().hasAny(["revision", "lastMutationId"])
          && !data.keys().hasAny(["revision", "lastMutationId"])
        )
        || (
          resource.data.keys().hasAll(["revision", "lastMutationId"])
          && data.revision == resource.data.revision
          && data.lastMutationId == resource.data.lastMutationId
        );
    }

    function noteRevisionAdvances(data) {
      return data.keys().hasAll(["revision", "lastMutationId"])
        && (
          (
            !resource.data.keys().hasAny(["revision", "lastMutationId"])
            && data.revision == 1
          )
          || (
            resource.data.keys().hasAll(["revision", "lastMutationId"])
            && data.revision == resource.data.revision + 1
            && data.lastMutationId != resource.data.lastMutationId
          )
        );
    }

    function validNoteFolderReference(data) {
      return !data.keys().hasAny(["folderId"])
        || data.folderId == null
        || (
          data.type == "personal"
          && data.folderId is string
          && data.folderId.size() > 0
          && data.folderId.size() <= 120
        );
    }

    function encryptedVaultFolder(data) {
      return data.keys().hasAll([
        "encryptedName",
        "wrappedKey",
        "parentId",
        "order",
        "revision"
      ]);
    }

    // The complete opaque tree is written only by the authenticated Vercel
    // mutation boundary. Rules use one document lookup regardless of nesting
    // depth and never accept client-supplied ancestorIds as authority.
    function authoritativeVaultFolderActive(uid, folderId, folder) {
      let node = get(vaultFolderTreePath(uid)).data.nodes[folderId];
      // The central document is not readable or writable by any client, and
      // the API validates its complete schema before every server transaction.
      // Keep this hot-path projection minimal so large note batches remain
      // below Firestore's 1,000-expression ceiling.
      return node.active == true;
    }

    function validVaultFolderLineage(data, folderId) {
      return data.keys().hasAll([
          "vaultAncestorIds",
          "vaultLineagePath",
          "vaultLineageDepth",
          "vaultLineageGeneration",
          "vaultLineageVersion"
        ])
        && data.vaultAncestorIds is list
        && data.vaultLineagePath is string
        && data.vaultLineagePath.size() > 0
        && data.vaultLineagePath.size() <= 4096
        && data.vaultLineageDepth is int
        && data.vaultLineageDepth == data.vaultAncestorIds.size()
        && data.vaultLineageDepth >= 0
        && data.vaultLineageDepth <= 32
        && data.vaultLineageGeneration is int
        && data.vaultLineageGeneration >= 1
        && data.vaultLineageGeneration <= 999999999999
        && data.vaultLineageVersion == 3
        && !data.vaultAncestorIds.hasAny([folderId])
        && authoritativeVaultFolderActive(data.ownerUid, folderId, data);
    }

    function validAssignedFolder(data) {
      return !data.keys().hasAny(["folderId"])
        || data.folderId == null
        || validAssignedFolderDocument(data, data.folderId);
    }

    function validAssignedFolderDocument(data, folderId) {
      let folder = get(noteFolderPath(folderId)).data;
      return exists(noteFolderPath(folderId))
        && folder.ownerUid == data.ownerUid
        && folderActive(folder)
        && (
          !encryptedVaultFolder(folder)
          || authoritativeVaultFolderActive(data.ownerUid, folderId, folder)
        )
        && vaultImportFolderDocumentPlacementAllowed(data, folder);
    }

    function vaultImportFolderPlacementAllowed(data, folderId) {
      let folder = get(noteFolderPath(folderId)).data;
      return vaultImportFolderDocumentPlacementAllowed(data, folder);
    }

    function vaultImportFolderDocumentPlacementAllowed(data, folder) {
      return !folder.keys().hasAny(["vaultImportJobId"])
        || (
          data.keys().hasAny(["vaultImportJobId"])
          && data.vaultImportJobId == folder.vaultImportJobId
        )
        || !existsAfter(vaultImportJobPath(folder.ownerUid, folder.vaultImportJobId))
        || vaultImportExistingFolderPlacementAllowed(folder);
    }

    function vaultImportExistingFolderPlacementAllowed(folder) {
      let job = getAfter(vaultImportJobPath(folder.ownerUid, folder.vaultImportJobId)).data;
      return job.ownerUid == folder.ownerUid && job.status == "committed";
    }

    // Imported targets stay immutable until their durable job is committed.
    // During rollback, the normal note mutation validators still verify the
    // complete revision/history/name-claim tombstone transaction; this helper
    // only opens that exact mutation shape and keeps edits/moves locked.
    function vaultImportNoteUpdateAllowed(data) {
      return !resource.data.keys().hasAny(["vaultImportJobId"])
        || !existsAfter(vaultImportJobPath(resource.data.ownerUid, resource.data.vaultImportJobId))
        || vaultImportExistingJobNoteUpdateAllowed(data);
    }

    function vaultImportExistingJobNoteUpdateAllowed(data) {
      let job = getAfter(vaultImportJobPath(resource.data.ownerUid, resource.data.vaultImportJobId)).data;
      return job.ownerUid == resource.data.ownerUid
        && (
          job.status == "committed"
          || (
            job.status == "rolling-back"
            && data.keys().hasAny(["vaultImportJobId"])
            && data.vaultImportJobId == resource.data.vaultImportJobId
            && data.isDeleted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasAny(["isDeleted"])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "isDeleted", "deletedAt", "deletedBy", "updatedAt", "updatedBy",
              "revision", "lastMutationId"
            ])
          )
        );
    }

    function vaultImportFolderUpdateAllowed(data) {
      return !resource.data.keys().hasAny(["vaultImportJobId"])
        || !existsAfter(vaultImportJobPath(resource.data.ownerUid, resource.data.vaultImportJobId))
        || vaultImportExistingJobFolderUpdateAllowed(data);
    }

    function vaultImportExistingJobFolderUpdateAllowed(data) {
      let job = getAfter(vaultImportJobPath(resource.data.ownerUid, resource.data.vaultImportJobId)).data;
      return job.ownerUid == resource.data.ownerUid
        && (
          job.status == "committed"
          || (
            job.status == "rolling-back"
            && data.keys().hasAny(["vaultImportJobId"])
            && data.vaultImportJobId == resource.data.vaultImportJobId
            && data.isDeleted == true
            && vaultFolderLifecycleRequested(data)
          )
        );
    }

    function validDeleteMetadata(data) {
      return legacyActiveDeleteMetadata(data)
        || (
          data.keys().hasAny(["isDeleted"])
          && data.isDeleted == false
          && !data.keys().hasAny(["deletedAt", "deletedBy"])
        )
        || (
          data.keys().hasAll(["isDeleted", "deletedAt", "deletedBy"])
          && data.isDeleted == true
          && data.deletedAt is timestamp
          && data.deletedBy is string
          && data.deletedBy.size() > 0
        )
        || (
          data.keys().hasAll(["isDeleted", "isPurged", "purgedAt", "purgedBy"])
          && data.isDeleted == true
          && data.isPurged == true
          && !data.keys().hasAny(["deletedAt", "deletedBy"])
        );
    }

    function legacyActiveDeleteMetadata(data) {
      return !data.keys().hasAny(["isDeleted", "deletedAt", "deletedBy"]);
    }

    function noteDeleted(data) {
      return data.keys().hasAny(["isDeleted"]) && data.isDeleted == true;
    }

    function noteActive(data) {
      return legacyActiveDeleteMetadata(data)
        || (data.keys().hasAny(["isDeleted"]) && data.isDeleted == false);
    }

    function notePurged(data) {
      return data.keys().hasAny(["isPurged"]) && data.isPurged == true;
    }

    function noteFolderId(data) {
      return data.keys().hasAny(["folderId"]) ? data.folderId : null;
    }

    function validPurgeMetadata(data) {
      return !data.keys().hasAny(["isPurged", "purgedAt", "purgedBy"])
        || (
          data.keys().hasAll(["isPurged", "purgedAt", "purgedBy"])
          && data.keys().hasAny(["isDeleted"])
          && data.isDeleted == true
          && data.isPurged == true
          && data.purgedAt is timestamp
          && data.purgedBy is string
          && data.purgedBy.size() > 0
        );
    }

    function validRoster(data, uid) {
      return data.keys().hasOnly([
        "uid",
        "displayName",
        "avatarText",
        "color",
        "order",
        "quickKey",
        "loginEmail",
        "isActive",
        "isAdmin"
      ])
      && data.uid == uid
      && data.displayName is string
      && data.displayName.size() > 0
      && data.displayName.size() <= 40
      && data.avatarText is string
      && data.avatarText.size() > 0
      && data.avatarText.size() <= 4
      && data.color is string
      && data.order is int
      && data.order >= 1
      && data.quickKey is int
      && data.quickKey >= 1
      && data.quickKey <= 99
      && data.loginEmail is string
      && data.isActive is bool
      && data.isAdmin is bool;
    }

    function validUserProfile(data, uid) {
      return data.keys().hasOnly([
        "uid",
        "displayName",
        "avatarText",
        "color",
        "order",
        "quickKey",
        "loginEmail",
        "isActive",
        "isAdmin",
        "role",
        "publicKeyJwk",
        "allowedShareTargetUids",
        "featureAccess",
        "createdAt",
        "updatedAt",
        "needsKeyRecovery"
      ])
      && data.uid == uid
      && data.displayName is string
      && data.displayName.size() > 0
      && data.displayName.size() <= 40
      && data.avatarText is string
      && data.avatarText.size() > 0
      && data.avatarText.size() <= 4
      && data.color is string
      && data.order is int
      && data.order >= 1
      && data.quickKey is int
      && data.quickKey >= 1
      && data.quickKey <= 99
      && data.loginEmail is string
      && data.isActive is bool
      && data.isAdmin is bool
      && data.role in ["admin", "user"]
      && ((data.isAdmin == true && data.role == "admin") || (data.isAdmin == false && data.role == "user"))
      && data.publicKeyJwk is map
      && (
        !data.keys().hasAny(["featureAccess"])
        || validFeatureAccess(data.featureAccess)
      )
      && (
        !data.keys().hasAny(["allowedShareTargetUids"])
        || (
          data.allowedShareTargetUids is list
          && data.allowedShareTargetUids.size() <= 200
          && uid in data.allowedShareTargetUids
        )
      )
      && data.needsKeyRecovery is bool;
    }

    function validUserKey(data, uid) {
      return data.keys().hasOnly([
        "uid",
        "publicKeyJwk",
        "encryptedPrivateKeyJwk",
        "kdfSalt",
        "kdfIterations",
        "pendingEncryptedPrivateKeyJwk",
        "pendingKdfSalt",
        "pendingKdfIterations",
        "pendingCreatedAt",
        "updatedAt"
      ])
      && data.uid == uid
      && data.publicKeyJwk is map
      && encryptedPayload(data.encryptedPrivateKeyJwk)
      && data.kdfSalt is string
      && data.kdfIterations is int
      && data.kdfIterations >= 100000
      && (
        !data.keys().hasAny(["pendingEncryptedPrivateKeyJwk", "pendingKdfSalt", "pendingKdfIterations", "pendingCreatedAt"])
        || (
          data.keys().hasAll(["pendingEncryptedPrivateKeyJwk", "pendingKdfSalt", "pendingKdfIterations", "pendingCreatedAt"])
          && encryptedPayload(data.pendingEncryptedPrivateKeyJwk)
          && data.pendingKdfSalt is string
          && data.pendingKdfIterations is int
          && data.pendingKdfIterations >= 100000
          && data.pendingCreatedAt is timestamp
        )
      )
      && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp);
    }

    function validUserPreferences(data, uid) {
      return data.keys().hasOnly([
          "uid",
          "defaultHome",
          "encryptedMatrixLabels",
          "matrixLabelsFormat",
          "matrixLabelsWrappedKey",
          "scheduleDefaultView",
          "scheduleDefaultCategory",
          "theme",
          "createdAt",
          "updatedAt"
        ])
        && data.uid == uid
        && data.defaultHome in ["notes", "library", "schedule"]
        && validEncryptedMatrixLabels(data)
        && data.scheduleDefaultView in ["todo", "calendar", "matrix", "recurring", "completed"]
        && (!data.keys().hasAny(["scheduleDefaultCategory"]) || data.scheduleDefaultCategory in ["all", "work", "personal"])
        && (!data.keys().hasAny(["theme"]) || data.theme in ["light", "dark", "system"])
        && (!data.keys().hasAny(["createdAt"]) || data.createdAt is timestamp)
        && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp);
    }

    function validEncryptedMatrixLabels(data) {
      return !data.keys().hasAny([
          "encryptedMatrixLabels",
          "matrixLabelsFormat",
          "matrixLabelsWrappedKey"
        ])
        || (
          data.keys().hasAll([
            "encryptedMatrixLabels",
            "matrixLabelsFormat",
            "matrixLabelsWrappedKey"
          ])
          && data.matrixLabelsFormat == "matrix-labels-v1"
          && encryptedPayload(data.encryptedMatrixLabels)
          && data.encryptedMatrixLabels.cipherText.size() >= 24
          && data.encryptedMatrixLabels.cipherText.size() <= 4096
          && data.encryptedMatrixLabels.iv.size() == 16
          && wrappedAesKeyPayload(data.matrixLabelsWrappedKey)
          && (
            data.matrixLabelsWrappedKey.wrappedKey.size() == 344
            || data.matrixLabelsWrappedKey.wrappedKey.size() == 512
          )
        );
    }

    function validScheduleDate(value) {
      return value == null
        || (
          value is string
          && value.size() == 10
          && value.matches("^(((19|20|21)[0-9]{2}-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8])))|(((19|21)(0[48]|[2468][048]|[13579][26])|20(0[048]|[2468][048]|[13579][26]))-02-29))$")
        );
    }

    function validScheduleTime(value) {
      return value == null || (value is int && value >= 0 && value <= 1439);
    }

    function validScheduleColor(data) {
      return !data.keys().hasAny(["color"])
        || data.color == null
        || (
          data.color is string
          && data.color.matches("^#[0-9A-Fa-f]{6}$")
        );
    }

    function validScheduleSortOrder(data) {
      return !data.keys().hasAny(["sortOrder"])
        || data.sortOrder == null
        || (
          data.sortOrder is int
          && data.sortOrder >= 0
        );
    }

    function validScheduleProgress(data) {
      return !data.keys().hasAny(["progressPercent"])
        || data.progressPercent == null
        || (
          data.progressPercent is int
          && data.progressPercent >= 0
          && data.progressPercent <= 100
        );
    }

    function scheduleStartDate(data) {
      return data.keys().hasAny(["startDate"]) ? data.startDate : data.dueDate;
    }

    function scheduleEndDate(data) {
      return data.keys().hasAny(["endDate"]) ? data.endDate : scheduleStartDate(data);
    }

    function scheduleStartTime(data) {
      return data.keys().hasAny(["startTimeMinutes"]) ? data.startTimeMinutes : data.dueTimeMinutes;
    }

    function scheduleEndTime(data) {
      return data.keys().hasAny(["endTimeMinutes"]) ? data.endTimeMinutes : null;
    }

    function scheduleDateYear(value) {
      return value.split("-")[0];
    }

    function validScheduleRangeLength(data) {
      return scheduleStartDate(data) == null
        || scheduleEndDate(data) == null
        || scheduleDateYear(scheduleStartDate(data)) == scheduleDateYear(scheduleEndDate(data));
    }

    function validScheduleDateRange(data) {
      return validScheduleDate(data.dueDate)
        && validScheduleDate(scheduleStartDate(data))
        && validScheduleDate(scheduleEndDate(data))
        && validScheduleRangeLength(data)
        && (
          scheduleStartDate(data) == null
          || scheduleEndDate(data) == null
          || scheduleEndDate(data) >= scheduleStartDate(data)
        )
        && (
          scheduleStartDate(data) == data.dueDate
          || (scheduleStartDate(data) == null && data.dueDate == null)
        );
    }

    function validScheduleTimeRange(data) {
      return validScheduleTime(data.dueTimeMinutes)
        && validScheduleTime(scheduleStartTime(data))
        && validScheduleTime(scheduleEndTime(data))
        && (
          scheduleStartTime(data) == data.dueTimeMinutes
          || (scheduleStartTime(data) == null && data.dueTimeMinutes == null)
        )
        && (
          scheduleEndTime(data) == null
          || (
            scheduleStartTime(data) != null
            && scheduleEndTime(data) >= scheduleStartTime(data)
          )
        );
    }

    function encryptedSchedulePayload(payload, maxCipherTextSize) {
      return encryptedPayload(payload)
        && payload.cipherText.size() > 0
        && payload.cipherText.size() <= maxCipherTextSize
        && payload.iv.size() > 0
        && payload.iv.size() <= 256;
    }

    function encryptedLibraryPayload(payload) {
      return encryptedPayload(payload)
        && payload.cipherText.size() >= 24
        && payload.cipherText.size() <= 700000
        && payload.iv.size() == 16;
    }

    function validLibraryOptionalId(value) {
      return value == null
        || (
          value is string
          && value.matches("^[A-Za-z0-9_-]{1,180}$")
        );
    }

    function validLibraryUrlFingerprint(value) {
      return value == null
        || (
          value is string
          && value.matches("^[A-Za-z0-9_-]{43}$")
        );
    }

    function validLibraryWrappedKey(payload) {
      return wrappedAesKeyPayload(payload)
        && (
          payload.wrappedKey.size() == 344
          || payload.wrappedKey.size() == 512
        );
    }

    function validLibraryWrappedKeys(data) {
      return data.wrappedKeys is map
        && data.wrappedKeys.keys().hasAll([data.ownerUid])
        && data.wrappedKeys.keys().hasOnly([data.ownerUid])
        && validLibraryWrappedKey(data.wrappedKeys[data.ownerUid]);
    }

    function validLibrarySourceBinding(data) {
      return (
          data.kind == "link"
          && data.urlFingerprint != null
          && data.sourceNoteId == null
          && data.sourceAttachmentId == null
          && data.captureSource != "attachment-ocr"
        )
        || (
          data.kind == "clip"
          && data.sourceNoteId == null
          && data.sourceAttachmentId == null
          && data.captureSource != "attachment-ocr"
        )
        || (
          data.kind == "attachment"
          && data.sourceNoteId != null
          && data.sourceAttachmentId != null
          && data.captureSource == "attachment-ocr"
        );
    }

    function validLibraryAttachmentSource(data) {
      return data.kind != "attachment"
        || (
          activeSignedInUserHasNotes()
          && exists(notePath(data.sourceNoteId))
          && exists(noteAttachmentPath(data.sourceNoteId, data.sourceAttachmentId))
          && get(notePath(data.sourceNoteId)).data.ownerUid == request.auth.uid
          && noteActive(get(notePath(data.sourceNoteId)).data)
          && !notePurged(get(notePath(data.sourceNoteId)).data)
          && get(noteAttachmentPath(data.sourceNoteId, data.sourceAttachmentId)).data.noteId == data.sourceNoteId
          && (
            !get(noteAttachmentPath(data.sourceNoteId, data.sourceAttachmentId)).data.keys().hasAny(["isReady"])
            || get(noteAttachmentPath(data.sourceNoteId, data.sourceAttachmentId)).data.isReady == true
          )
        );
    }

    function validLibraryItem(data) {
      return data.keys().hasAll([
          "ownerUid",
          "generationId",
          "kind",
          "status",
          "captureSource",
          "isFavorite",
          "encryptedContent",
          "urlFingerprint",
          "sourceNoteId",
          "sourceAttachmentId",
          "wrappedKeys",
          "revision",
          "lastMutationId",
          "reviewCount",
          "createdAt",
          "updatedAt",
          "lastOpenedAt",
          "lastReviewedAt"
        ])
        && data.keys().hasOnly([
          "ownerUid",
          "generationId",
          "kind",
          "status",
          "captureSource",
          "isFavorite",
          "encryptedContent",
          "urlFingerprint",
          "sourceNoteId",
          "sourceAttachmentId",
          "wrappedKeys",
          "revision",
          "lastMutationId",
          "reviewCount",
          "createdAt",
          "updatedAt",
          "lastOpenedAt",
          "lastReviewedAt"
        ])
        && data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.ownerUid.size() <= 160
        && data.generationId is string
        && data.generationId.matches("^[A-Za-z0-9_-]{8,160}$")
        && data.kind in ["link", "clip", "attachment"]
        && data.status in ["inbox", "reading", "archived"]
        && data.captureSource in ["manual", "browser-extension", "bookmarklet", "attachment-ocr"]
        && data.isFavorite is bool
        && encryptedLibraryPayload(data.encryptedContent)
        && validLibraryUrlFingerprint(data.urlFingerprint)
        && validLibraryOptionalId(data.sourceNoteId)
        && validLibraryOptionalId(data.sourceAttachmentId)
        && validLibrarySourceBinding(data)
        && validLibraryWrappedKeys(data)
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 999999999999
        && data.lastMutationId is string
        && data.lastMutationId.matches("^[A-Za-z0-9_-]{8,160}$")
        && data.reviewCount is int
        && data.reviewCount >= 0
        && data.reviewCount <= 999999999999
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.lastOpenedAt == null || data.lastOpenedAt is timestamp)
        && (data.lastReviewedAt == null || data.lastReviewedAt is timestamp);
    }

    function validLibraryLastOpenedAtUpdate(data) {
      let affectedKeys = data.diff(resource.data).affectedKeys();
      return data.lastOpenedAt == request.time
        && affectedKeys.hasAll(["lastOpenedAt"])
        && affectedKeys.hasOnly(["lastOpenedAt"]);
    }

    function validLibraryRevisionUpdate(data) {
      return data.ownerUid == resource.data.ownerUid
        && data.generationId == resource.data.generationId
        && data.kind == resource.data.kind
        && data.captureSource == resource.data.captureSource
        && data.createdAt == resource.data.createdAt
        && data.wrappedKeys == resource.data.wrappedKeys
        && data.urlFingerprint == resource.data.urlFingerprint
        && data.sourceNoteId == resource.data.sourceNoteId
        && data.sourceAttachmentId == resource.data.sourceAttachmentId
        && data.revision == resource.data.revision + 1
        && data.lastMutationId != resource.data.lastMutationId
        && data.reviewCount >= resource.data.reviewCount
        && data.reviewCount <= resource.data.reviewCount + 1
        && (
          (
            data.reviewCount == resource.data.reviewCount
            && data.lastReviewedAt == resource.data.lastReviewedAt
          )
          || (
            data.reviewCount == resource.data.reviewCount + 1
            && data.lastReviewedAt == request.time
          )
        )
        && data.lastOpenedAt == resource.data.lastOpenedAt
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "isFavorite",
          "encryptedContent",
          "revision",
          "lastMutationId",
          "reviewCount",
          "updatedAt",
          "lastReviewedAt"
        ]);
    }

    function validLibraryVault(data, uid) {
      return data.keys().hasAll(["ownerUid", "wrappedKey", "createdAt", "updatedAt"])
        && data.keys().hasOnly(["ownerUid", "wrappedKey", "createdAt", "updatedAt"])
        && data.ownerUid == uid
        && validLibraryWrappedKey(data.wrappedKey)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validVaultIntegrity(data, uid) {
      return data.keys().hasAll(["ownerUid", "indexVersion", "wrappedKey", "createdAt", "updatedAt"])
        && data.keys().hasOnly(["ownerUid", "indexVersion", "wrappedKey", "createdAt", "updatedAt"])
        && data.ownerUid == uid
        && data.indexVersion == 1
        && wrappedAesKeyPayload(data.wrappedKey)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validVaultNameClaim(data, uid, claimId) {
      return data.keys().hasAll([
          "ownerUid",
          "indexVersion",
          "parentId",
          "targetId",
          "targetType",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "ownerUid",
          "indexVersion",
          "parentId",
          "targetId",
          "targetType",
          "createdAt",
          "updatedAt"
        ])
        && validVaultNameClaimId(claimId)
        && data.ownerUid == uid
        && data.indexVersion == 1
        && (data.parentId == null || (data.parentId is string && data.parentId.size() > 0 && data.parentId.size() <= 120))
        && data.targetId is string
        && data.targetId.size() > 0
        && data.targetId.size() <= 120
        && data.targetType in ["entry", "folder"]
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function vaultEntryNameClaimTargetMatchesAfter(data, uid, claimId) {
      let target = getAfter(notePath(data.targetId)).data;
      return target.ownerUid == uid
        && noteActive(target)
        && target.vaultNameClaimId == claimId
        && target.vaultNameIndexVersion == 1
        && noteFolderId(target) == data.parentId
        && vaultImportEntryClaimTargetBound(target, data.targetId);
    }

    function vaultFolderNameClaimTargetMatchesAfter(data, uid, claimId) {
      let target = getAfter(noteFolderPath(data.targetId)).data;
      return target.ownerUid == uid
        && folderActive(target)
        && target.vaultNameClaimId == claimId
        && target.vaultNameIndexVersion == 1
        && target.parentId == data.parentId
        && vaultImportFolderClaimTargetBound(target, data.targetId);
    }

    // Import provenance is enforced on the paired name-claim write rather
    // than the already expression-heavy target create rule. The target and
    // claim are required in one atomic write, so this remains fail closed while
    // keeping the exact Vault create transaction below Firestore's 1000 limit.
    function vaultImportStagingClaimTargetBound(target) {
      return existsAfter(vaultImportJobPath(target.ownerUid, target.vaultImportJobId))
        && getAfter(vaultImportJobPath(target.ownerUid, target.vaultImportJobId)).data.ownerUid
          == target.ownerUid
        && getAfter(vaultImportJobPath(target.ownerUid, target.vaultImportJobId)).data.status
          == "staging";
    }

    // A new imported target must still be attached to its owned staging job.
    // Existing targets retain immutable provenance after terminal cleanup, so
    // later name-claim replacement may reuse that exact before-image binding;
    // the enclosing note/folder mutation rule remains responsible for locking
    // staging, blocked and rollback states.
    function vaultImportEntryClaimTargetBound(target, noteId) {
      return !target.keys().hasAny(["vaultImportJobId"])
        || (
          validVaultImportJobId(target.vaultImportJobId)
          && (
            exists(notePath(noteId))
            ? (
              get(notePath(noteId)).data.ownerUid == target.ownerUid
              && get(notePath(noteId)).data.vaultImportJobId == target.vaultImportJobId
            )
            : vaultImportStagingClaimTargetBound(target)
          )
        );
    }

    function vaultImportFolderClaimTargetBound(target, folderId) {
      return !target.keys().hasAny(["vaultImportJobId"])
        || (
          validVaultImportJobId(target.vaultImportJobId)
          && (
            exists(noteFolderPath(folderId))
            ? (
              get(noteFolderPath(folderId)).data.ownerUid == target.ownerUid
              && get(noteFolderPath(folderId)).data.vaultImportJobId == target.vaultImportJobId
            )
            : vaultImportStagingClaimTargetBound(target)
          )
        );
    }

    // Claims and targets validate each other in the same atomic write. The
    // claim-create rule below prevents two targets from acquiring one blinded
    // name, while these target-side checks prevent a buggy/direct client from
    // attaching a syntactically valid but missing or unrelated claim id.
    function vaultEntryNameClaimMatchesTargetAfter(noteId, data) {
      let claimId = data.vaultNameClaimId;
      let claim = getAfter(vaultNameClaimPath(data.ownerUid, claimId)).data;
      return existsAfter(vaultNameClaimPath(data.ownerUid, claimId))
        ? (
          claim.ownerUid == data.ownerUid
          && claim.indexVersion == 1
          && claim.targetId == noteId
          && claim.targetType == "entry"
          && claim.parentId == noteFolderId(data)
        )
        : false;
    }

    function vaultFolderNameClaimMatchesTargetAfter(folderId, data) {
      let claimId = data.vaultNameClaimId;
      let claim = getAfter(vaultNameClaimPath(data.ownerUid, claimId)).data;
      return existsAfter(vaultNameClaimPath(data.ownerUid, claimId))
        ? (
          claim.ownerUid == data.ownerUid
          && claim.indexVersion == 1
          && claim.targetId == folderId
          && claim.targetType == "folder"
          && claim.parentId == data.parentId
        )
        : false;
    }

    function vaultEntryNameClaimStateMatchesAfter(noteId, data) {
      return existsAfter(vaultIntegrityPath(data.ownerUid))
        ? (
          noteDeleted(data)
          ? !existsAfter(vaultNameClaimPath(data.ownerUid, data.vaultNameClaimId))
          : vaultEntryNameClaimMatchesTargetAfter(noteId, data)
        )
        : true;
    }

    function vaultEntryNameReservationStateMatchesAfter(noteId, data) {
      return existsAfter(vaultIntegrityPath(data.ownerUid))
        ? (
          validVaultNameReservationFields(data)
          && (
            noteDeleted(data)
            ? !existsAfter(vaultNameClaimPath(data.ownerUid, data.vaultNameClaimId))
            : vaultEntryNameClaimMatchesTargetAfter(noteId, data)
          )
        )
        : true;
    }

    function vaultFolderNameReservationStateMatchesAfter(folderId, data) {
      // existsAfter closes the marker + folder same-batch gap. Marker
      // activation is intentionally a separate preflighted transaction; once
      // it exists in the resulting state, every folder must have a matching
      // claim document as well as the encrypted storage shape.
      return existsAfter(vaultIntegrityPath(data.ownerUid))
        ? (
          validVaultNameReservationFields(data)
          && (
            folderDeleted(data)
            ? !existsAfter(vaultNameClaimPath(data.ownerUid, data.vaultNameClaimId))
            : vaultFolderNameClaimMatchesTargetAfter(folderId, data)
          )
        )
        : true;
    }

    function vaultEntryPreviousNameClaimReleasedAfter(data) {
      return resource.data.keys().hasAny(["vaultNameClaimId"])
        ? (
          data.vaultNameClaimId == resource.data.vaultNameClaimId
          ? true
          : !existsAfter(vaultNameClaimPath(resource.data.ownerUid, resource.data.vaultNameClaimId))
        )
        : true;
    }

    function vaultFolderPreviousNameClaimReleasedAfter(data) {
      return resource.data.keys().hasAny(["vaultNameClaimId"])
        ? (
          data.vaultNameClaimId == resource.data.vaultNameClaimId
          ? true
          : !existsAfter(vaultNameClaimPath(resource.data.ownerUid, resource.data.vaultNameClaimId))
        )
        : true;
    }

    function vaultNameClaimTargetMatchesAfter(data, uid, claimId) {
      return data.targetType == "entry"
        ? (
          existsAfter(notePath(data.targetId))
          && vaultEntryNameClaimTargetMatchesAfter(data, uid, claimId)
        )
        : (
          data.targetType == "folder"
          && existsAfter(noteFolderPath(data.targetId))
          && vaultFolderNameClaimTargetMatchesAfter(data, uid, claimId)
        );
    }

    function vaultNameClaimTargetReleasedAfter(data, uid, claimId) {
      let entryTarget = getAfter(notePath(data.targetId)).data;
      let folderTarget = getAfter(noteFolderPath(data.targetId)).data;
      return data.targetType == "entry"
        ? (
          !existsAfter(notePath(data.targetId))
          || noteDeleted(entryTarget)
          || entryTarget.ownerUid != uid
          || entryTarget.vaultNameClaimId != claimId
        )
        : (
          data.targetType == "folder"
          && (
            !existsAfter(noteFolderPath(data.targetId))
            || folderDeleted(folderTarget)
            || folderTarget.ownerUid != uid
            || folderTarget.vaultNameClaimId != claimId
          )
        );
    }

    function vaultEntryNameClaimReleasedAfterDelete(data) {
      return !data.keys().hasAny(["vaultNameClaimId"])
        || !existsAfter(vaultNameClaimPath(data.ownerUid, data.vaultNameClaimId));
    }

    function vaultEntryNameClaimPresentAfterRestore(data) {
      return !data.keys().hasAny(["vaultNameClaimId"])
        || existsAfter(vaultNameClaimPath(data.ownerUid, data.vaultNameClaimId));
    }

    function validVaultWorkspace(data, uid) {
      return data.keys().hasAll([
          "ownerUid",
          "encryptedState",
          "wrappedKey",
          "revision",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "ownerUid",
          "encryptedState",
          "wrappedKey",
          "revision",
          "createdAt",
          "updatedAt"
        ])
        && data.ownerUid == uid
        && encryptedPayload(data.encryptedState)
        && data.encryptedState.cipherText.size() > 0
        && data.encryptedState.cipherText.size() <= 800000
        && data.encryptedState.iv.size() > 0
        && data.encryptedState.iv.size() <= 128
        && wrappedAesKeyPayload(data.wrappedKey)
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 999999999999
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validVaultWorkspaceUpdate(data) {
      return data.ownerUid == resource.data.ownerUid
        && data.wrappedKey == resource.data.wrappedKey
        && data.createdAt == resource.data.createdAt
        && data.revision == resource.data.revision + 1
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "encryptedState",
          "revision",
          "updatedAt"
        ]);
    }

    function validVaultPathRewriteJobId(jobId) {
      return jobId is string && jobId.matches("^pr1_[A-Za-z0-9_-]{43}$");
    }

    function validVaultPathRewriteError(value) {
      return value == null || value in [
        "content-conflict",
        "job-corrupt",
        "missing-source",
        "path-state-conflict",
        "revision-conflict",
        "write-failed"
      ];
    }

    function validVaultPathRewriteOptionalTimestamps(data) {
      return (!data.keys().hasAny(["activatedAt"]) || data.activatedAt is timestamp)
        && (!data.keys().hasAny(["completedAt"]) || data.completedAt is timestamp)
        && (!data.keys().hasAny(["recoveredAt"]) || data.recoveredAt is timestamp)
        && (!data.keys().hasAny(["lastAttemptAt"]) || data.lastAttemptAt is timestamp)
        && (!data.keys().hasAny(["recoveredAt"]) || data.keys().hasAny(["activatedAt"]));
    }

    function validVaultPathRewriteJob(data, uid, jobId) {
      return data.keys().hasAll([
          "ownerUid",
          "kind",
          "version",
          "planFingerprint",
          "status",
          "stepCount",
          "cursor",
          "confirmedCount",
          "attemptCount",
          "retryCount",
          "lastErrorCode",
          "revision",
          "encryptedManifest",
          "wrappedKey",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "ownerUid",
          "kind",
          "version",
          "planFingerprint",
          "status",
          "stepCount",
          "cursor",
          "confirmedCount",
          "attemptCount",
          "retryCount",
          "lastErrorCode",
          "revision",
          "encryptedManifest",
          "wrappedKey",
          "createdAt",
          "updatedAt",
          "activatedAt",
          "completedAt",
          "recoveredAt",
          "lastAttemptAt"
        ])
        && validVaultPathRewriteJobId(jobId)
        && data.ownerUid == uid
        && data.kind == "path-rewrite-v1"
        && data.version == 1
        && data.planFingerprint == jobId
        && data.status in ["preparing", "prepared", "ready", "running", "blocked", "completed"]
        && data.stepCount is int
        && data.stepCount >= 0
        && data.stepCount <= 5000
        && data.cursor is int
        && data.cursor >= 0
        && data.cursor <= data.stepCount
        && data.confirmedCount == data.cursor
        && data.attemptCount is int
        && data.attemptCount >= 0
        && data.attemptCount <= 999999
        && data.retryCount is int
        && data.retryCount >= 0
        && data.retryCount <= data.attemptCount
        && validVaultPathRewriteError(data.lastErrorCode)
        && ((data.status == "blocked") == (data.lastErrorCode != null))
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 999999999999
        && boundedEncryptedPayload(data.encryptedManifest, 900000)
        && wrappedAesKeyPayload(data.wrappedKey)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validVaultPathRewriteOptionalTimestamps(data)
        && (
          data.status == "completed"
          ? (
            data.cursor == data.stepCount
            && data.keys().hasAll(["activatedAt", "completedAt"])
          )
          : (
            !data.keys().hasAny(["completedAt"])
            && (data.stepCount == 0 || data.cursor < data.stepCount)
          )
        );
    }

    function vaultPathRewritePreparingToPrepared(data) {
      return resource.data.status == "preparing"
        && data.status == "prepared"
        && data.cursor == resource.data.cursor
        && data.confirmedCount == resource.data.confirmedCount
        && data.attemptCount == resource.data.attemptCount
        && data.retryCount == resource.data.retryCount
        && data.lastErrorCode == null
        && data.diff(resource.data).affectedKeys().hasOnly(["status", "revision", "updatedAt"]);
    }

    function vaultPathRewritePreparedActivation(data) {
      return resource.data.status == "prepared"
        && data.cursor == resource.data.cursor
        && data.confirmedCount == resource.data.confirmedCount
        && data.attemptCount == resource.data.attemptCount
        && data.retryCount == resource.data.retryCount
        && data.lastErrorCode == null
        && data.activatedAt == request.time
        && (
          (data.stepCount == 0 && data.status == "completed" && data.completedAt == request.time)
          || (data.stepCount > 0 && data.status == "ready" && !data.keys().hasAny(["completedAt"]))
        )
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status", "revision", "activatedAt", "completedAt", "updatedAt"
        ]);
    }

    function vaultPathRewritePathConflict(data) {
      return (
          resource.data.status == "prepared"
          || (resource.data.status == "blocked" && resource.data.lastErrorCode == "path-state-conflict")
        )
        && data.status == "blocked"
        && data.cursor == resource.data.cursor
        && data.confirmedCount == resource.data.confirmedCount
        && data.attemptCount == resource.data.attemptCount + 1
        && data.retryCount == resource.data.retryCount + 1
        && data.lastErrorCode == "path-state-conflict"
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status", "attemptCount", "retryCount", "lastErrorCode", "revision", "updatedAt"
        ]);
    }

    function vaultPathRewritePathRecovery(data) {
      return resource.data.status == "blocked"
        && resource.data.lastErrorCode == "path-state-conflict"
        && data.cursor == resource.data.cursor
        && data.confirmedCount == resource.data.confirmedCount
        && data.attemptCount == resource.data.attemptCount
        && data.retryCount == resource.data.retryCount
        && data.lastErrorCode == null
        && (
          (
            data.status == "prepared"
            && data.diff(resource.data).affectedKeys().hasOnly([
              "status", "lastErrorCode", "revision", "updatedAt"
            ])
          )
          || (
            data.activatedAt == request.time
            && data.recoveredAt == request.time
            && (
              (data.stepCount == 0 && data.status == "completed" && data.completedAt == request.time)
              || (data.stepCount > 0 && data.status == "ready" && !data.keys().hasAny(["completedAt"]))
            )
            && data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "lastErrorCode",
              "revision",
              "activatedAt",
              "recoveredAt",
              "completedAt",
              "updatedAt"
            ])
          )
        );
    }

    function vaultPathRewriteAttemptStart(data) {
      return (
          resource.data.status == "ready"
          || resource.data.status == "running"
          || (resource.data.status == "blocked" && resource.data.lastErrorCode != "path-state-conflict")
        )
        && data.status == "running"
        && data.cursor == resource.data.cursor
        && data.confirmedCount == resource.data.confirmedCount
        && data.attemptCount == resource.data.attemptCount + 1
        && data.retryCount == resource.data.retryCount
        && data.lastErrorCode == null
        && data.lastAttemptAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status", "attemptCount", "lastErrorCode", "revision", "lastAttemptAt", "updatedAt"
        ]);
    }

    function vaultPathRewriteBlocked(data) {
      return resource.data.status in ["ready", "running", "blocked"]
        && data.status == "blocked"
        && data.cursor == resource.data.cursor
        && data.confirmedCount == resource.data.confirmedCount
        && data.attemptCount == resource.data.attemptCount
        && data.retryCount == resource.data.retryCount + 1
        && data.lastErrorCode != null
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status", "retryCount", "lastErrorCode", "revision", "updatedAt"
        ]);
    }

    function vaultPathRewriteStepConfirmed(data) {
      return resource.data.status == "running"
        && data.cursor == resource.data.cursor + 1
        && data.confirmedCount == data.cursor
        && data.attemptCount == resource.data.attemptCount
        && data.retryCount == resource.data.retryCount
        && data.lastErrorCode == null
        && (
          (data.cursor == data.stepCount && data.status == "completed" && data.completedAt == request.time)
          || (data.cursor < data.stepCount && data.status == "running" && !data.keys().hasAny(["completedAt"]))
        )
        && data.diff(resource.data).affectedKeys().hasOnly([
          "cursor", "confirmedCount", "status", "lastErrorCode", "revision", "completedAt", "updatedAt"
        ]);
    }

    function validVaultPathRewriteJobCreate(data, uid, jobId) {
      return validVaultPathRewriteJob(data, uid, jobId)
        && data.status == "preparing"
        && data.cursor == 0
        && data.confirmedCount == 0
        && data.attemptCount == 0
        && data.retryCount == 0
        && data.lastErrorCode == null
        && data.revision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && !data.keys().hasAny(["activatedAt", "completedAt", "recoveredAt", "lastAttemptAt"]);
    }

    function validVaultPathRewriteJobUpdate(data, uid, jobId) {
      return validVaultPathRewriteJob(data, uid, jobId)
        && resource.data.ownerUid == uid
        && resource.data.kind == data.kind
        && resource.data.version == data.version
        && resource.data.planFingerprint == data.planFingerprint
        && resource.data.stepCount == data.stepCount
        && resource.data.encryptedManifest == data.encryptedManifest
        && resource.data.wrappedKey == data.wrappedKey
        && resource.data.createdAt == data.createdAt
        && resource.data.status != "completed"
        && data.revision == resource.data.revision + 1
        && data.updatedAt == request.time
        && (
          vaultPathRewritePreparingToPrepared(data)
          || vaultPathRewritePreparedActivation(data)
          || vaultPathRewritePathConflict(data)
          || vaultPathRewritePathRecovery(data)
          || vaultPathRewriteAttemptStart(data)
          || vaultPathRewriteBlocked(data)
          || vaultPathRewriteStepConfirmed(data)
        );
    }

    function validVaultPathRewriteStep(data, uid, jobId, stepId) {
      let parent = get(vaultPathRewriteJobPath(uid, jobId)).data;
      return data.keys().hasAll(["ownerUid", "jobId", "stepId", "ordinal", "encryptedStep", "createdAt"])
        && data.keys().hasOnly(["ownerUid", "jobId", "stepId", "ordinal", "encryptedStep", "createdAt"])
        && validVaultPathRewriteJobId(jobId)
        && stepId.matches("^step-[0-9]{6}$")
        && data.ownerUid == uid
        && data.jobId == jobId
        && data.stepId == stepId
        && exists(vaultPathRewriteJobPath(uid, jobId))
        && parent.ownerUid == uid
        && parent.status == "preparing"
        && data.ordinal is int
        && data.ordinal >= 0
        && data.ordinal < parent.stepCount
        && boundedEncryptedPayload(data.encryptedStep, 900000)
        && data.createdAt == request.time;
    }

    function validVaultImportError(value) {
      return value == null || value in [
        "job-corrupt",
        "rollback-conflict",
        "snapshot-incomplete",
        "write-failed"
      ];
    }

    function validVaultImportJob(data, uid, jobId) {
      return data.keys().hasAll([
          "ownerUid", "kind", "version", "status", "itemCount", "entryCount",
          "folderCount", "rootFolderCount", "chunkCount", "revision",
          "remainingChunkCount", "lastErrorCode", "wrappedKey", "createdAt", "updatedAt"
        ])
        && data.keys().hasOnly([
          "ownerUid", "kind", "version", "status", "itemCount", "entryCount",
          "folderCount", "rootFolderCount", "chunkCount", "revision",
          "remainingChunkCount", "lastErrorCode", "wrappedKey", "createdAt", "updatedAt", "preparedAt",
          "committedAt", "rollbackStartedAt", "rolledBackAt"
        ])
        && validVaultImportJobId(jobId)
        && data.ownerUid == uid
        && data.kind == "vault-import-v1"
        && data.version == 1
        && data.status in ["preparing", "staging", "committed", "rolling-back", "rolled-back", "blocked"]
        && data.itemCount is int
        && data.itemCount >= 1
        && data.itemCount <= 10000
        && data.entryCount is int
        && data.entryCount >= 1
        && data.folderCount is int
        && data.folderCount >= 0
        && data.folderCount <= 5000
        && data.entryCount + data.folderCount == data.itemCount
        && data.rootFolderCount is int
        && data.rootFolderCount >= 0
        && data.rootFolderCount <= data.folderCount
        && data.chunkCount is int
        && data.chunkCount >= 1
        && data.chunkCount <= 100
        && data.remainingChunkCount is int
        && data.remainingChunkCount >= 0
        && data.remainingChunkCount <= data.chunkCount
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 999999999999
        && validVaultImportError(data.lastErrorCode)
        && ((data.status == "blocked") == (data.lastErrorCode != null))
        && wrappedAesKeyPayload(data.wrappedKey)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(["preparedAt"]) || data.preparedAt is timestamp)
        && (!data.keys().hasAny(["committedAt"]) || data.committedAt is timestamp)
        && (!data.keys().hasAny(["rollbackStartedAt"]) || data.rollbackStartedAt is timestamp)
        && (!data.keys().hasAny(["rolledBackAt"]) || data.rolledBackAt is timestamp);
    }

    function validVaultImportJobCreate(data, uid, jobId) {
      return validVaultImportJob(data, uid, jobId)
        && data.status == "preparing"
        && data.remainingChunkCount == data.chunkCount
        && data.lastErrorCode == null
        && data.revision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && !data.keys().hasAny(["preparedAt", "committedAt", "rollbackStartedAt", "rolledBackAt"]);
    }

    function vaultImportPreparingToStaging(data) {
      return resource.data.status == "preparing"
        && data.status == "staging"
        && data.lastErrorCode == null
        && data.preparedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(["status", "revision", "preparedAt", "updatedAt"]);
    }

    function vaultImportStagingToCommitted(data) {
      return resource.data.status == "staging"
        && data.status == "committed"
        && data.lastErrorCode == null
        && data.committedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(["status", "revision", "committedAt", "updatedAt"]);
    }

    function vaultImportRollbackStart(data) {
      return resource.data.status in ["staging", "blocked"]
        && data.status == "rolling-back"
        && data.lastErrorCode == null
        && data.rollbackStartedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status", "lastErrorCode", "revision", "rollbackStartedAt", "updatedAt"
        ]);
    }

    function vaultImportRollbackBlocked(data) {
      return resource.data.status in ["staging", "rolling-back", "blocked"]
        && data.status == "blocked"
        && data.lastErrorCode != null
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status", "lastErrorCode", "revision", "updatedAt"
        ]);
    }

    function vaultImportRolledBack(data) {
      return resource.data.status in ["preparing", "rolling-back"]
        && data.status == "rolled-back"
        && data.lastErrorCode == null
        && data.rolledBackAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status", "lastErrorCode", "revision", "rolledBackAt", "updatedAt"
        ]);
    }

    function vaultImportTerminalChunkCleanup(data) {
      return resource.data.status in ["committed", "rolled-back"]
        && data.status == resource.data.status
        && data.lastErrorCode == resource.data.lastErrorCode
        && resource.data.remainingChunkCount > 0
        && data.remainingChunkCount == resource.data.remainingChunkCount - 1
        && data.diff(resource.data).affectedKeys().hasOnly([
          "remainingChunkCount", "revision", "updatedAt"
        ]);
    }

    function validVaultImportJobUpdate(data, uid, jobId) {
      return validVaultImportJob(data, uid, jobId)
        && resource.data.ownerUid == uid
        && data.ownerUid == resource.data.ownerUid
        && data.kind == resource.data.kind
        && data.version == resource.data.version
        && data.itemCount == resource.data.itemCount
        && data.entryCount == resource.data.entryCount
        && data.folderCount == resource.data.folderCount
        && data.rootFolderCount == resource.data.rootFolderCount
        && data.chunkCount == resource.data.chunkCount
        && data.wrappedKey == resource.data.wrappedKey
        && data.createdAt == resource.data.createdAt
        && data.revision == resource.data.revision + 1
        && data.updatedAt == request.time
        && (
          (
            resource.data.status != "committed"
            && resource.data.status != "rolled-back"
            && data.remainingChunkCount == resource.data.remainingChunkCount
            && (
