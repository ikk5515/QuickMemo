    function validVaultImportChunk(data, uid, jobId, chunkId) {
      let parent = get(vaultImportJobPath(uid, jobId)).data;
      return data.keys().hasAll([
          "ownerUid", "jobId", "ordinal", "itemCount", "encryptedManifest", "createdAt"
        ])
        && data.keys().hasOnly([
          "ownerUid", "jobId", "ordinal", "itemCount", "encryptedManifest", "createdAt"
        ])
        && validVaultImportJobId(jobId)
        && chunkId.matches("^chunk-[0-9]{3}$")
        && data.ownerUid == uid
        && data.jobId == jobId
        && exists(vaultImportJobPath(uid, jobId))
        && parent.ownerUid == uid
        && parent.status == "preparing"
        && data.ordinal is int
        && data.ordinal >= 0
        && data.ordinal < parent.chunkCount
        && data.itemCount is int
        && data.itemCount >= 1
        && data.itemCount <= 100
        && boundedEncryptedPayload(data.encryptedManifest, 200000)
        && data.createdAt == request.time;
    }

    function validScheduleWrappedKeys(data, uid) {
      return data.wrappedKeys is map
        && data.wrappedKeys.keys().hasOnly([uid])
        && wrappedAesKeyPayload(data.wrappedKeys[uid]);
    }

    function validScheduleCompletion(data) {
      return (
        data.status == "active"
        && data.completedAt == null
      )
      || (
        data.status == "completed"
        && data.completedAt is timestamp
        && data.completedAt <= request.time
      );
    }

    function currentGoogleCalendarConnectionGeneration(uid, generation) {
      return exists(googleCalendarConnectionPath(uid))
        && get(googleCalendarConnectionPath(uid)).data.connectionStatus == "connected"
        && get(googleCalendarConnectionPath(uid)).data.connectionGeneration == generation;
    }

    function validScheduleTask(data, uid) {
      // Every required field below is read and type-checked. Keeping a second
      // hasAll list would duplicate those checks and can exhaust Firestore's
      // per-request expression budget on guarded updates.
      return data.keys().hasOnly([
        "ownerUid",
        "status",
        "dueDate",
        "dueTimeMinutes",
        "startDate",
        "endDate",
        "startTimeMinutes",
        "endTimeMinutes",
        "color",
        "sortOrder",
        "progressPercent",
        "isImportant",
        "isUrgent",
        "encryptedTitle",
        "encryptedCategory",
        "encryptedDetails",
        "wrappedKeys",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt",
        "calendarUpdatedAt",
        "completedAt"
      ])
      && data.ownerUid == uid
      && data.status in ["active", "completed"]
      && validScheduleDateRange(data)
      && validScheduleTimeRange(data)
      && validScheduleColor(data)
      && validScheduleSortOrder(data)
      && validScheduleProgress(data)
      && data.isImportant is bool
      && data.isUrgent is bool
      && encryptedSchedulePayload(data.encryptedTitle, 4096)
      && encryptedSchedulePayload(data.encryptedDetails, 50000)
      && validScheduleWrappedKeys(data, uid)
      && data.createdBy == uid
      && data.updatedBy == uid
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && data.get("calendarUpdatedAt", request.time) is timestamp
      && validScheduleCompletion(data);
    }

    function validScheduleUpdateFields() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let projectedFieldsChanged = affectedKeys.hasAny([
        "encryptedTitle",
        "dueDate",
        "dueTimeMinutes",
        "startDate",
        "endDate",
        "startTimeMinutes",
        "endTimeMinutes"
      ]);
      let calendarRevisionChanged = affectedKeys.hasAny(["calendarUpdatedAt"]);

      return affectedKeys.hasOnly([
          "status",
          "dueDate",
          "dueTimeMinutes",
          "startDate",
          "endDate",
          "startTimeMinutes",
          "endTimeMinutes",
          "color",
          "sortOrder",
          "progressPercent",
          "isImportant",
          "isUrgent",
          "encryptedTitle",
          "encryptedCategory",
          "encryptedDetails",
          "updatedBy",
          "updatedAt",
          "calendarUpdatedAt",
          "completedAt"
        ])
        && projectedFieldsChanged == calendarRevisionChanged
        && (
          !calendarRevisionChanged
          || request.resource.data.calendarUpdatedAt == request.time
        );
    }

    function validGoogleCalendarTaskTombstone(data, taskId, uid) {
      return data.keys().hasOnly([
          "ownerUid",
          "taskId",
          "deletionAttemptId",
          "connectionGeneration",
          "createdAt",
          "leaseExpiresAt"
        ])
        && data.keys().hasAll(["ownerUid", "taskId", "deletionAttemptId", "createdAt", "leaseExpiresAt"])
        && data.ownerUid == uid
        && data.taskId is string
        && data.taskId == taskId
        && data.taskId.matches("^[A-Za-z0-9_-]{1,128}$")
        && data.deletionAttemptId is string
        && data.deletionAttemptId.matches("^[0-9a-f]{32}$")
        && (
          !data.keys().hasAny(["connectionGeneration"])
          || data.connectionGeneration == null
          || (
            data.connectionGeneration is string
            && data.connectionGeneration.matches("^[A-Za-z0-9_-]{43}$")
          )
        )
        && data.createdAt is timestamp
        && data.leaseExpiresAt is timestamp;
    }

    function googleCalendarTaskTombstoneMatchesConnection(data, uid) {
      return (
          (
            !data.keys().hasAny(["connectionGeneration"])
            || data.connectionGeneration == null
          )
          && !exists(googleCalendarConnectionPath(uid))
        )
        || (
          data.keys().hasAny(["connectionGeneration"])
          && data.connectionGeneration is string
          && currentGoogleCalendarConnectionGeneration(uid, data.connectionGeneration)
        );
    }

    function validGoogleCalendarTaskSyncReceipt(data, taskId, uid) {
      return data.keys().hasOnly([
          "ownerUid",
          "taskId",
          "connectionGeneration",
          "taskUpdatedAt",
          "syncedAt"
        ])
        && data.keys().hasAll([
          "ownerUid",
          "taskId",
          "connectionGeneration",
          "taskUpdatedAt",
          "syncedAt"
        ])
        && data.ownerUid == uid
        && data.taskId == taskId
        && data.taskId is string
        && data.taskId.matches("^[A-Za-z0-9_-]{1,128}$")
        && data.connectionGeneration is string
        && data.connectionGeneration.matches("^[A-Za-z0-9_-]{43}$")
        && data.taskUpdatedAt is timestamp
        && data.syncedAt is timestamp;
    }

    function googleCalendarTaskSyncReceiptMatchesRevision(taskData, taskUpdatedAt) {
      return (
          taskData.keys().hasAny(["calendarUpdatedAt"])
          && taskData.calendarUpdatedAt is timestamp
          && taskUpdatedAt == taskData.calendarUpdatedAt
        )
        || (
          !taskData.keys().hasAny(["calendarUpdatedAt"])
          && taskData.keys().hasAny(["createdAt"])
          && taskData.createdAt is timestamp
          && taskUpdatedAt == taskData.createdAt
        )
        || (
          !taskData.keys().hasAny(["calendarUpdatedAt"])
          && (
            !taskData.keys().hasAny(["createdAt"])
            || !(taskData.createdAt is timestamp)
          )
          && taskData.keys().hasAny(["updatedAt"])
          && taskData.updatedAt is timestamp
          && taskUpdatedAt == taskData.updatedAt
        );
    }

    function validRecurringHabitColor(value) {
      return value is string
        && value.matches("^#[0-9A-Fa-f]{6}$");
    }

    function validRecurringHabitSortOrder(data) {
      return !data.keys().hasAny(["sortOrder"])
        || data.sortOrder == null
        || (
          data.sortOrder is int
          && data.sortOrder >= 0
          && data.sortOrder <= 1000000
        );
    }

    function validRecurringHabit(data, uid) {
      return data.keys().hasAll([
        "ownerUid",
        "status",
        "slot",
        "icon",
        "color",
        "encryptedTitle",
        "encryptedDetails",
        "wrappedKeys",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ])
      && data.keys().hasOnly([
        "ownerUid",
        "status",
        "slot",
        "icon",
        "color",
        "sortOrder",
        "encryptedTitle",
        "encryptedDetails",
        "wrappedKeys",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ])
      && data.ownerUid == uid
      && data.status in ["active", "archived"]
      && data.slot in ["morning", "afternoon", "other"]
      && data.icon in ["work", "study", "reading", "exercise", "health", "cleanup", "review", "other"]
      && validRecurringHabitColor(data.color)
      && validRecurringHabitSortOrder(data)
      && encryptedSchedulePayload(data.encryptedTitle, 4096)
      && encryptedSchedulePayload(data.encryptedDetails, 12000)
      && validScheduleWrappedKeys(data, uid)
      && data.createdBy == uid
      && data.updatedBy == uid
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function recurringHabitBelongsToOwner(habitId, uid) {
      return exists(/databases/$(database)/documents/recurringHabits/$(habitId))
        && get(/databases/$(database)/documents/recurringHabits/$(habitId)).data.ownerUid == uid
        && get(/databases/$(database)/documents/recurringHabits/$(habitId)).data.status == "active";
    }

    function recurringHabitCheckInTargetBelongsToOwner(checkInId, uid) {
      let separatorIndex = checkInId.size() - 11;
      return checkInId.size() > 11
        && checkInId[separatorIndex] == "_"
        && validScheduleDate(checkInId[separatorIndex + 1:checkInId.size()])
        && recurringHabitBelongsToOwner(checkInId[0:separatorIndex], uid);
    }

    function validRecurringHabitCheckInProgress(data) {
      return !data.keys().hasAny(["progressPercent"])
        || data.progressPercent == null
        || (
          data.progressPercent is int
          && data.progressPercent >= 0
          && data.progressPercent <= 100
        );
    }

    function validRecurringHabitCheckedItemIds(data) {
      return !data.keys().hasAny(["checkedItemIds"])
        || (
          data.checkedItemIds is list
          && data.checkedItemIds.size() <= 100
        );
    }

    function validRecurringHabitCheckIn(data, uid, checkInId) {
      return data.keys().hasAll([
        "ownerUid",
        "habitId",
        "date",
        "completed",
        "progressPercent",
        "checkedItemIds",
        "checkedAt",
        "createdAt",
        "updatedAt"
      ])
      && data.keys().hasOnly([
        "ownerUid",
        "habitId",
        "date",
        "completed",
        "progressPercent",
        "checkedItemIds",
        "checkedAt",
        "createdAt",
        "updatedAt"
      ])
      && data.ownerUid == uid
      && data.habitId is string
      && data.habitId.size() > 0
      && data.habitId.size() <= 128
      && validScheduleDate(data.date)
      && data.date != null
      && checkInId == data.habitId + "_" + data.date
      && data.completed is bool
      && data.progressPercent is int
      && validRecurringHabitCheckInProgress(data)
      && validRecurringHabitCheckedItemIds(data)
      && (
        (
          data.completed == false
          && data.progressPercent < 100
          && data.checkedAt == null
        )
        || (
          data.completed == true
          && data.progressPercent == 100
          && data.checkedAt is timestamp
          && data.checkedAt <= request.time
        )
      )
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && recurringHabitBelongsToOwner(data.habitId, uid);
    }

    function validNoteFolder(data, folderId) {
      return data.keys().hasOnly([
          "ownerUid",
          "name",
          "color",
          "encryptedName",
          "wrappedKey",
          "parentId",
          "order",
          "revision",
          "vaultNameClaimId",
          "vaultNameIndexVersion",
          "vaultImportJobId",
          "vaultAncestorIds",
          "vaultLineagePath",
          "vaultLineageDepth",
          "vaultLineageGeneration",
          "vaultLineageVersion",
          "isDeleted",
          "deletedAt",
          "deletedBy",
          "createdAt",
          "updatedAt"
        ])
        && validNoteFolderShape(data, folderId);
    }

    // Update branches independently constrain every affected key. Reusing the
    // value-level shape without recounting the create-only key allowlist keeps
    // the import lock below Firestore's 1000-expression ceiling.
    function validNoteFolderShape(data, folderId) {
      return folderId.matches("^[A-Za-z0-9_-]{1,120}$")
        && data.ownerUid == request.auth.uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.color is string
        && data.color.size() > 0
        && data.color.size() <= 24
        && (
          !data.keys().hasAny(["encryptedName", "wrappedKey", "parentId", "order", "revision"])
          || (
            data.keys().hasAll([
              "encryptedName",
              "wrappedKey",
              "parentId",
              "order",
              "revision",
              "vaultAncestorIds",
              "vaultLineagePath",
              "vaultLineageDepth",
              "vaultLineageGeneration",
              "vaultLineageVersion"
            ])
            && encryptedPayload(data.encryptedName)
            && data.encryptedName.cipherText.size() > 0
            && data.encryptedName.cipherText.size() <= 2048
            && data.encryptedName.iv.size() > 0
            && data.encryptedName.iv.size() <= 256
            && wrappedAesKeyPayload(data.wrappedKey)
            && (
              data.parentId == null
              || (
                data.parentId is string
                && data.parentId.size() > 0
                && data.parentId.size() <= 120
                && data.parentId != folderId
              )
            )
            && data.order is int
            && data.order >= 0
            && data.order <= 999999999
            && data.revision is int
            && data.revision >= 1
            && data.revision <= 999999999999
            && validVaultFolderLineage(data, folderId)
            && validVaultNameReservationFields(data)
          )
        )
        && validFolderDeletionMetadata(data)
        && (!data.keys().hasAny(["createdAt"]) || data.createdAt is timestamp)
        && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp);
    }

    // Update match rules already freeze owner/name/color/createdAt and reject
    // lifecycle fields on this branch. Revalidate only values an encrypted
    // rename, move, ordering change or legacy cutover can actually introduce.
    function validEncryptedFolderMutationProjection(data, folderId) {
      return encryptedPayload(data.encryptedName)
        && data.encryptedName.cipherText.size() > 0
        && data.encryptedName.cipherText.size() <= 2048
        && data.encryptedName.iv.size() > 0
        && data.encryptedName.iv.size() <= 256
        && wrappedAesKeyPayload(data.wrappedKey)
        && (
          data.parentId == null
          || (
            data.parentId is string
            && data.parentId.size() > 0
            && data.parentId.size() <= 120
            && data.parentId != folderId
          )
        )
        && data.order is int
        && data.order >= 0
        && data.order <= 999999999
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 999999999999
        && validVaultFolderLineage(data, folderId)
        && validVaultNameReservationFields(data);
    }

    function vaultImportFolderParentPlacementAllowed(data) {
      return !data.keys().hasAny(["parentId"])
        || data.parentId == null
        || vaultImportFolderPlacementAllowed(data, data.parentId);
    }

    function validEncryptedNoteFolderUpdate(data) {
      return (
          (
            !resource.data.keys().hasAny(["encryptedName", "wrappedKey", "parentId", "order", "revision"])
            && (
              !data.keys().hasAny(["encryptedName", "wrappedKey", "parentId", "order", "revision"])
              || (
                data.revision == 1
                && data.color == resource.data.color
              )
            )
          )
          || (
            data.wrappedKey == resource.data.wrappedKey
            && data.name == resource.data.name
            && data.color == resource.data.color
            && data.revision == resource.data.revision + 1
            && data.vaultLineageGeneration >= resource.data.vaultLineageGeneration
          )
        );
    }

    function validVaultFolderLifecycleGeneration(data) {
      return data.vaultLineageVersion == 3
        && data.vaultLineageGeneration == resource.data.vaultLineageGeneration + 1;
    }

    function folderDeleted(data) {
      return data.keys().hasAny(["isDeleted"]) && data.isDeleted == true;
    }

    function folderActive(data) {
      return !data.keys().hasAny(["isDeleted"]) || data.isDeleted == false;
    }

    function validFolderDeletionMetadata(data) {
      return folderDeleted(data)
        ? (
          data.keys().hasAll(["deletedAt", "deletedBy"])
          && data.deletedAt is timestamp
          && data.deletedBy is string
          && data.deletedBy.size() > 0
          && data.deletedBy.size() <= 160
        )
        : !data.keys().hasAny(["deletedAt", "deletedBy"]);
    }

    function vaultFolderLifecycleRequested(data) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "isDeleted",
        "deletedAt",
        "deletedBy"
      ]);
    }

    // One root tombstone hides a complete subtree without rewriting every
    // descendant. All later folder and entry writes validate the authoritative
    // root-to-parent chain (at most one ancestor), so a deleted ancestor or
    // a forged/cyclic lineage fails closed even through a direct SDK write.
    function vaultFolderLifecycleUpdate(data) {
      return encryptedVaultFolder(resource.data)
        && data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isDeleted",
          "deletedAt",
          "deletedBy",
          "revision",
          "vaultLineageGeneration",
          "updatedAt"
        ])
        && (
          (
            folderActive(resource.data)
            && folderDeleted(data)
            && data.deletedAt == request.time
            && data.deletedBy == request.auth.uid
          )
          || (
            folderDeleted(resource.data)
            && folderActive(data)
            && !data.keys().hasAny(["deletedAt", "deletedBy"])
          )
        );
    }

    function validQuickLoginKey(data, uid) {
      return data.keys().hasOnly(["uid", "quickKey", "createdAt", "updatedAt"])
      && data.uid == uid
      && data.quickKey is int
      && data.quickKey >= 1
      && data.quickKey <= 99;
    }

    function validActiveNote(data, uid) {
      return data.keys().hasAll(["uid", "noteId", "updatedByClientId"])
        && data.keys().hasOnly(["uid", "noteId", "updatedAt", "updatedByClientId"])
        && data.uid == uid
        && (data.noteId == null || data.noteId is string)
        && data.updatedByClientId is string
        && data.updatedByClientId.size() > 0
        && data.updatedByClientId.size() <= 80;
    }

    function validNoteUserState(data, noteId, uid) {
      return data.keys().hasAll(["uid", "noteId"])
        && data.keys().hasOnly([
          "uid",
          "noteId",
          "isPinned",
          "readAt",
          "confirmedAt",
          "cursorOffset",
          "cursorVisible",
          "cursorClientId",
          "cursorUpdatedAt",
          "updatedAt"
        ])
        && data.uid == uid
        && data.noteId == noteId
        && (!data.keys().hasAny(["isPinned"]) || data.isPinned is bool)
        && (!data.keys().hasAny(["readAt"]) || data.readAt is timestamp)
        && (!data.keys().hasAny(["confirmedAt"]) || data.confirmedAt is timestamp)
        && (
          !data.keys().hasAny(["cursorOffset"])
          || data.cursorOffset == null
          || (data.cursorOffset is int && data.cursorOffset >= 0 && data.cursorOffset <= 500000)
        )
        && (!data.keys().hasAny(["cursorVisible"]) || data.cursorVisible is bool)
        && (
          !data.keys().hasAny(["cursorClientId"])
          || (data.cursorClientId is string && data.cursorClientId.size() > 0 && data.cursorClientId.size() <= 80)
        )
        && (
          !data.keys().hasAny(["cursorUpdatedAt"])
          || (data.cursorUpdatedAt is timestamp && data.cursorUpdatedAt <= request.time)
        )
        && (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is timestamp);
    }

    function validNoteHistory(data, noteId) {
      return data.keys().hasAll(["noteId", "actorUid", "action", "changedFields", "readerUids", "revision", "createdAt"])
        && data.keys().hasOnly(["noteId", "actorUid", "action", "changedFields", "readerUids", "revision", "encryptedSummary", "encryptedSnapshot", "createdAt"])
        && data.noteId == noteId
        && data.actorUid == request.auth.uid
        && data.action in ["create", "content", "share", "delete", "restore"]
        && data.changedFields is list
        && data.changedFields.size() > 0
        && data.changedFields.size() <= 8
        && data.changedFields.hasOnly(["title", "body", "participants", "folder", "name-claim", "deleted", "restored"])
        && data.readerUids is list
        && data.readerUids.size() > 0
        && data.readerUids.size() <= 200
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 999999999999
        && (!data.keys().hasAny(["encryptedSummary"]) || boundedEncryptedPayload(data.encryptedSummary, 8192))
        && (!data.keys().hasAny(["encryptedSnapshot"]) || boundedEncryptedPayload(data.encryptedSnapshot, 700000))
        && data.createdAt == request.time;
    }

    function canReadNoteHistory(data, noteData) {
      return canReadNoteDocument(noteData)
        && (
          request.auth.uid == noteData.ownerUid
          || request.auth.uid in data.readerUids
        );
    }

    function linkedNoteUpdate(noteId, historyId, data) {
      let nextNote = getAfter(notePath(noteId)).data;
      return exists(notePath(noteId))
        && existsAfter(notePath(noteId))
        && nextNote.updatedBy == request.auth.uid
        && nextNote.updatedAt == request.time
        && nextNote.revision == data.revision
        && nextNote.lastMutationId == historyId;
    }

    function createHistoryMatchesNote(data, noteId, historyId) {
      let nextNote = getAfter(notePath(noteId)).data;
      return data.action == "create"
        && !exists(notePath(noteId))
        && existsAfter(notePath(noteId))
        && nextNote.ownerUid == request.auth.uid
        && nextNote.updatedBy == request.auth.uid
        && nextNote.createdAt == request.time
        && nextNote.updatedAt == request.time
        && nextNote.savedAt == request.time
        && nextNote.revision == 1
        && nextNote.revision == data.revision
        && nextNote.lastMutationId == historyId
        && nextNote.isDeleted == false
        && data.changedFields.hasOnly(["title", "body"]);
    }

    function contentHistoryMatchesNote(data, noteId, historyId) {
      let previousNote = get(notePath(noteId)).data;
      let nextNote = getAfter(notePath(noteId)).data;
      return data.action == "content"
        && linkedNoteUpdate(noteId, historyId, data)
        && !noteDeleted(previousNote)
        && !noteDeleted(nextNote)
        && data.changedFields.hasOnly(["title", "body", "folder", "name-claim"])
        && nextNote.type == previousNote.type
        && nextNote.participantUids == previousNote.participantUids
        && nextNote.wrappedKeys == previousNote.wrappedKeys
        && (
          request.auth.uid == previousNote.ownerUid
          || (
            nextNote.encryptedTitle == previousNote.encryptedTitle
            && noteFolderId(nextNote) == noteFolderId(previousNote)
            && data.changedFields.hasOnly(["body"])
            && data.changedFields.hasAny(["body"])
          )
        )
        && (
          (
            noteFolderId(nextNote) == noteFolderId(previousNote)
            && data.changedFields.hasOnly(["title", "body", "name-claim"])
            && (
              nextNote.encryptedTitle != previousNote.encryptedTitle
              || nextNote.encryptedBody != previousNote.encryptedBody
              || data.changedFields.hasAny(["name-claim"])
            )
          )
          || (
            request.auth.uid == previousNote.ownerUid
            && previousNote.type == "personal"
            && data.changedFields.hasAny(["folder"])
            && noteFolderId(nextNote) != noteFolderId(previousNote)
            && (
              nextNote.encryptedTitle == previousNote.encryptedTitle
              || data.changedFields.hasAny(["title"])
            )
            && (
              nextNote.encryptedBody == previousNote.encryptedBody
              || data.changedFields.hasAny(["body"])
            )
          )
        );
    }

    function shareHistoryMatchesNote(data, noteId, historyId) {
      return data.action == "share"
        && linkedNoteUpdate(noteId, historyId, data)
        && request.auth.uid == get(notePath(noteId)).data.ownerUid
        && !noteDeleted(get(notePath(noteId)).data)
        && !noteDeleted(getAfter(notePath(noteId)).data)
        && data.changedFields.hasOnly(["participants", "folder", "name-claim"])
        && (
          data.changedFields.hasAny(["folder"])
          == (
            noteFolderId(getAfter(notePath(noteId)).data)
            != noteFolderId(get(notePath(noteId)).data)
          )
        )
        && (
          data.changedFields.hasAny(["participants"])
          == (
            getAfter(notePath(noteId)).data.type != get(notePath(noteId)).data.type
            || getAfter(notePath(noteId)).data.participantUids != get(notePath(noteId)).data.participantUids
            || getAfter(notePath(noteId)).data.wrappedKeys != get(notePath(noteId)).data.wrappedKeys
          )
        )
        && getAfter(notePath(noteId)).data.encryptedTitle == get(notePath(noteId)).data.encryptedTitle
        && getAfter(notePath(noteId)).data.encryptedBody == get(notePath(noteId)).data.encryptedBody;
    }

    function deleteHistoryMatchesNote(data, noteId, historyId) {
      return data.action == "delete"
        && linkedNoteUpdate(noteId, historyId, data)
        && !noteDeleted(get(notePath(noteId)).data)
        && noteDeleted(getAfter(notePath(noteId)).data)
        && getAfter(notePath(noteId)).data.deletedBy == request.auth.uid
        && data.changedFields.hasOnly(["deleted"]);
    }

    function restoreHistoryMatchesNote(data, noteId, historyId) {
      return data.action == "restore"
        && linkedNoteUpdate(noteId, historyId, data)
        && noteDeleted(get(notePath(noteId)).data)
        && !noteDeleted(getAfter(notePath(noteId)).data)
        && data.changedFields.hasOnly(["restored"]);
    }

    function historyMatchesNoteMutation(data, noteId, historyId) {
      let nextNote = getAfter(notePath(noteId)).data;
      return existsAfter(notePath(noteId))
        && data.readerUids == nextNote.participantUids
        && (
          createHistoryMatchesNote(data, noteId, historyId)
          || contentHistoryMatchesNote(data, noteId, historyId)
          || shareHistoryMatchesNote(data, noteId, historyId)
          || deleteHistoryMatchesNote(data, noteId, historyId)
          || restoreHistoryMatchesNote(data, noteId, historyId)
        );
    }

    // A cutover backfill changes only blinded reservation metadata and its
    // ordinary revision/history envelope. Keeping a narrow branch avoids
    // evaluating every historical mutation variant in the same three-write
    // atomic batch, which otherwise exceeds Firestore's 1000-expression cap.
    function vaultNameBackfillHistoryMatches(data, noteId, historyId) {
      let previousNote = get(notePath(noteId)).data;
      let nextNote = getAfter(notePath(noteId)).data;
      return validNoteHistory(data, noteId)
        && exists(notePath(noteId))
        && existsAfter(notePath(noteId))
        && !previousNote.keys().hasAny(["vaultNameClaimId", "vaultNameIndexVersion"])
        && validVaultNameReservationFields(nextNote)
        && nextNote.diff(previousNote).affectedKeys().hasOnly([
          "vaultNameClaimId",
          "vaultNameIndexVersion",
          "updatedAt",
          "updatedBy",
          "revision",
          "lastMutationId"
        ])
        && nextNote.ownerUid == request.auth.uid
        && !noteDeleted(previousNote)
        && !noteDeleted(nextNote)
        && nextNote.updatedBy == request.auth.uid
        && nextNote.updatedAt == request.time
        && nextNote.revision == previousNote.revision + 1
        && nextNote.lastMutationId == historyId
        && data.action == "content"
        && data.changedFields == ["name-claim"]
        && data.readerUids == nextNote.participantUids
        && data.revision == nextNote.revision;
    }

    function vaultNameBackfillHistoryRequested(noteId) {
      let previousNote = get(notePath(noteId)).data;
      let nextNote = getAfter(notePath(noteId)).data;
      return exists(notePath(noteId))
        && existsAfter(notePath(noteId))
        && exists(vaultIntegrityPath(nextNote.ownerUid))
        && !previousNote.keys().hasAny(["vaultNameClaimId", "vaultNameIndexVersion"])
        && validVaultNameReservationFields(nextNote);
    }

    function vaultUnclaimedRestoreHistoryRequested(noteId) {
      let previousNote = get(notePath(noteId)).data;
      let nextNote = getAfter(notePath(noteId)).data;
      return exists(notePath(noteId))
        && existsAfter(notePath(noteId))
        && exists(vaultIntegrityPath(previousNote.ownerUid))
        && !previousNote.keys().hasAny(["vaultNameClaimId", "vaultNameIndexVersion"])
        && noteDeleted(previousNote)
        && !noteDeleted(nextNote)
        && validVaultNameReservationFields(nextNote);
    }

    function vaultUnclaimedRestoreHistoryMatches(data, noteId, historyId) {
      let previousNote = get(notePath(noteId)).data;
      let nextNote = getAfter(notePath(noteId)).data;
      return validNoteHistory(data, noteId)
        && vaultUnclaimedRestoreHistoryRequested(noteId)
        && previousNote.ownerUid == request.auth.uid
        && nextNote.ownerUid == previousNote.ownerUid
        && linkedNoteUpdate(noteId, historyId, data)
        && data.action == "restore"
        && data.changedFields == ["restored", "name-claim"]
        && data.readerUids == nextNote.participantUids
        && data.revision == nextNote.revision;
    }

    // A collision loser has no old reservation to release. It may recover in
    // one atomic transaction only by changing its encrypted title or parent,
    // acquiring the new claim, and writing matching revision history.
    function vaultNameCollisionRecoveryHistoryRequested(noteId) {
      let previousNote = get(notePath(noteId)).data;
      let nextNote = getAfter(notePath(noteId)).data;
      return exists(notePath(noteId)) && existsAfter(notePath(noteId))
        ? (
          exists(vaultIntegrityPath(previousNote.ownerUid))
          && !previousNote.keys().hasAny(["vaultNameClaimId", "vaultNameIndexVersion"])
          && validVaultNameReservationFields(nextNote)
          && (
            nextNote.encryptedTitle != previousNote.encryptedTitle
            || noteFolderId(nextNote) != noteFolderId(previousNote)
          )
        )
        : false;
    }

    function vaultNameCollisionRecoveryHistoryMatches(data, noteId, historyId) {
      let previousNote = get(notePath(noteId)).data;
      let nextNote = getAfter(notePath(noteId)).data;
      return validNoteHistory(data, noteId)
        && exists(notePath(noteId))
        && existsAfter(notePath(noteId))
        && previousNote.ownerUid == request.auth.uid
        && !previousNote.keys().hasAny(["vaultNameClaimId", "vaultNameIndexVersion"])
        && validVaultNameReservationFields(nextNote)
        && data.action == "content"
        && data.changedFields.hasAny(["name-claim"])
        && (
          data.changedFields.hasAny(["title"])
          == (nextNote.encryptedTitle != previousNote.encryptedTitle)
        )
        && (
          data.changedFields.hasAny(["body"])
          == (nextNote.encryptedBody != previousNote.encryptedBody)
        )
        && (
          data.changedFields.hasAny(["folder"])
          == (noteFolderId(nextNote) != noteFolderId(previousNote))
        )
        && (
          data.changedFields.hasAny(["title"])
          || data.changedFields.hasAny(["folder"])
        )
        && !data.changedFields.hasAny(["body"])
        && data.readerUids == nextNote.participantUids
        && data.revision == nextNote.revision
        && historyId == nextNote.lastMutationId
        && (
          (
            previousNote.type == "shared"
            && nextNote.type == "shared"
            && noteFolderId(previousNote) != null
            && noteFolderId(nextNote) == null
            && nextNote.encryptedTitle == previousNote.encryptedTitle
            && nextNote.encryptedBody == previousNote.encryptedBody
            && data.changedFields == ["folder", "name-claim"]
            && linkedNoteUpdate(noteId, historyId, data)
          )
          || contentHistoryMatchesNote(data, noteId, historyId)
        );
    }

    function pairedNoteHistoryCreated(noteId, data) {
      let history = getAfter(noteHistoryPath(noteId, data.lastMutationId)).data;
      return data.keys().hasAll(["revision", "lastMutationId"])
        && !exists(noteHistoryPath(noteId, data.lastMutationId))
        && existsAfter(noteHistoryPath(noteId, data.lastMutationId))
        && history.revision == data.revision
        && history.actorUid == request.auth.uid;
    }

    function vaultNameBackfillUpdate(noteId, data) {
      return exists(vaultIntegrityPath(resource.data.ownerUid))
        && request.auth.uid == resource.data.ownerUid
        && !resource.data.keys().hasAny(["vaultNameClaimId", "vaultNameIndexVersion"])
        && validVaultNameReservationFields(data)
        && data.diff(resource.data).affectedKeys().hasOnly([
          "vaultNameClaimId",
          "vaultNameIndexVersion",
          "updatedAt",
          "updatedBy",
          "revision",
          "lastMutationId"
        ])
        && !noteDeleted(resource.data)
        && !noteDeleted(data)
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && noteRevisionAdvances(data)
        && pairedNoteHistoryCreated(noteId, data)
        && validAssignedFolder(data)
        && vaultEntryNameClaimMatchesTargetAfter(noteId, data);
    }

    function vaultNameCollisionRecoveryUpdate(noteId, data) {
      return exists(vaultIntegrityPath(resource.data.ownerUid))
        && request.auth.uid == resource.data.ownerUid
        && !resource.data.keys().hasAny(["vaultNameClaimId", "vaultNameIndexVersion"])
        && validVaultNameReservationFields(data)
        && activeNoteUpdateAffectedKeys([
          "encryptedTitle",
          "folderId",
          "vaultNameClaimId",
          "vaultNameIndexVersion",
          "updatedAt",
          "updatedBy",
          "revision",
          "lastMutationId"
        ], [
          "encryptedTitle",
          "folderId",
          "vaultNameClaimId",
          "vaultNameIndexVersion",
          "updatedAt",
          "updatedBy",
          "revision",
          "lastMutationId",
          "isDeleted"
        ])
        && (
          data.encryptedTitle != resource.data.encryptedTitle
          || noteFolderId(data) != noteFolderId(resource.data)
        )
        && !noteDeleted(resource.data)
        && !noteDeleted(data)
        && data.type == resource.data.type
        && data.participantUids == resource.data.participantUids
        && data.wrappedKeys == resource.data.wrappedKeys
        && data.encryptedBody == resource.data.encryptedBody
        && data.encryptedTitle.cipherText.size() > 0
        && data.encryptedTitle.cipherText.size() <= 4096
        && data.encryptedTitle.iv.size() > 0
        && data.encryptedTitle.iv.size() <= 256
        && data.updatedBy == request.auth.uid
