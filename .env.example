# Local/CI compatibility only. In Production, enter a trusted SMTP profile,
# account, password/app password, and optional Reply-To in Admin > 이메일 설정.
# The server encrypts that managed credential in Firestore; keep raw values empty.
# Allowed profiles: smtp.gmail.com:465 or :587, smtp-mail.outlook.com:587,
# and smtp.office365.com:587. Port 465 uses implicit TLS; 587 requires STARTTLS.
SHARE_EMAIL_PROVIDER=gmail_smtp
SHARE_SMTP_HOST=smtp.gmail.com
SHARE_SMTP_PORT=465
SHARE_SMTP_SECURE=true
SHARE_SMTP_REQUIRE_TLS=false
SHARE_SMTP_USERNAME=
SHARE_SMTP_APP_PASSWORD=
SHARE_EMAIL_FROM=
SHARE_EMAIL_FROM_NAME=QuickMemo
SHARE_EMAIL_REPLY_TO=
# Optional automated mailbox smoke inputs. The in-app six-digit confirmation
# flow is the normal Production activation proof and does not require IMAP.
SHARE_SMOKE_TEST_EMAIL=
SHARE_EMAIL_FREE_TIER_MODE=true
SHARE_EMAIL_ROLLING_24H_SOFT_LIMIT=20
SHARE_EMAIL_ROLLING_24H_HARD_LIMIT=30
SHARE_EMAIL_MONTHLY_SOFT_LIMIT=500
SHARE_EMAIL_MONTHLY_HARD_LIMIT=700
SHARE_EMAIL_GLOBAL_MINUTE_LIMIT=3
SHARE_EMAIL_GLOBAL_HOURLY_LIMIT=20
SHARE_EMAIL_CONNECTION_TIMEOUT_MS=10000
SHARE_EMAIL_GREETING_TIMEOUT_MS=10000
SHARE_EMAIL_SOCKET_TIMEOUT_MS=15000
SHARE_EMAIL_PROVIDER_HEALTH_CACHE_SECONDS=600
SHARE_SMOKE_MAILBOX_PROVIDER=
