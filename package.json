{
  "name": "quickmemo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && npm run build:artifacts",
    "build:artifacts": "vite build && node scripts/verify-build-chunks.mjs && node scripts/copy-library-ocr-assets.mjs && npm run build:library-extension",
    "build:library-extension": "node scripts/build-library-extension.mjs --origin https://quickmemo-tan.vercel.app",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "security:functions-guard": "node scripts/security-functions-guard.mjs",
    "security:gitignore-guard": "node scripts/security-gitignore-guard.mjs",
    "security:billing-guard": "node --test scripts/security-no-billing-guard.selftest.mjs && node scripts/security-no-billing-guard.mjs",
    "release:firestore-contract-sha256": "node scripts/verify-production-release-contract.mjs --print-firestore-sha256",
    "test:security": "npm run security:functions-guard && npm run security:gitignore-guard && npm run security:billing-guard && vitest run tests/backendBoundarySecurity.test.js src/lib/adminUserDeleteBackend.test.ts src/lib/blobAttachmentBackend.test.ts src/lib/ciSecurity.test.ts src/lib/googleCalendarBackend.test.ts src/lib/hostingHeaders.test.ts src/lib/passwordPolicy.test.ts src/lib/publicShareCleanupBackend.test.ts src/lib/secureShareBackend.test.ts src/pages/NotesPage.security.test.ts src/pages/PublicSharePage.security.test.ts",
    "test:performance": "npm run benchmark:vault-cutover && npm run benchmark:secure-share && npm run benchmark:graph-browser",
    "test": "vitest run --maxWorkers=50%",
    "test:rules": "npx --yes firebase-tools@15.24.0 emulators:exec --project quickmemo-rules-test --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:api-emulator": "npx --yes firebase-tools@15.24.0 emulators:exec --project quickmemo-share-api-test --only auth,firestore \"vitest run --config vitest.integration.config.ts\"",
    "test:cleanup-handler": "vitest run src/lib/publicShareCleanupHandler.integration.test.ts src/lib/publicShareCleanupBackend.test.ts",
    "test:integration": "npm run test:api-emulator && npm run test:cleanup-handler",
    "benchmark:secure-share": "npx --yes firebase-tools@15.24.0 emulators:exec --project quickmemo-share-api-test --only auth,firestore \"vitest run --config vitest.performance.config.ts --disableConsoleIntercept\"",
    "benchmark:vault-cutover": "vitest run src/features/vault/vaultCutoverPerformance.test.ts --disableConsoleIntercept",
    "benchmark:graph-browser": "playwright test --config=playwright.graph-performance.config.mjs",
    "test:e2e": "playwright test",
    "test:e2e:vault": "playwright test --config=playwright.vault.config.mjs",
    "test:e2e:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile-390 --project=chromium-mobile-320 --project=chromium-tablet-768 --project=chromium-tablet-1024-landscape",
    "test:e2e:webkit": "playwright test --project=webkit-desktop --project=webkit-mobile-390 --project=webkit-mobile-320 --project=webkit-tablet-768 --project=webkit-tablet-1024-landscape",
    "verify:gmail-smtp-production": "node scripts/verify-gmail-smtp-production.mjs",
    "emulators": "npx --yes firebase-tools@15.24.0 emulators:start --only auth,firestore,storage,hosting"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "brace-expansion": "^5.0.9",
    "tmp": "^0.2.6",
    "gaxios@6.7.1": {
      "uuid": "^11.1.1"
    },
    "morgan": "^1.11.0",
    "nanoid": "3.3.18",
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.8.0"
    },
    "esbuild": "^0.28.1",
    "undici": "^6.28.0",
    "universal-analytics": {
      "uuid": "14.0.0"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-table-cell": "^3.23.4",
    "@tiptap/extension-table-header": "^3.23.4",
    "@tiptap/extension-table-row": "^3.23.4",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@types/katex": "^0.16.8",
    "@vercel/blob": "^2.4.0",
    "@xyflow/react": "^12.11.3",
    "cfb": "^1.2.2",
    "d3-force": "^3.0.0",
    "docx-preview": "^0.3.7",
    "fflate": "^0.8.3",
    "firebase": "^12.6.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.555.0",
    "mermaid": "^11.17.0",
    "nodemailer": "9.0.3",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-router-dom": "npm:react-router@8.3.0",
    "tesseract.js": "7.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.7"
  }
}
